[Unit]
Description=jolly-wa — WhatsApp messages to Jivo AI, answered by the Jolly agent
Documentation=https://github.com/daman8271/jivo-cli/tree/main/whatsapp-cli
After=jwa.service network-online.target
Wants=jwa.service

[Service]
Type=simple
# the venv holds claude-agent-sdk (pip install claude-agent-sdk into __HOME__/jolly-venv)
ExecStart=__HOME__/jolly-venv/bin/python __HOME__/bin/jolly_wa.py
WorkingDirectory=__HOME__/jivo-cli/jolly
Environment=HOME=__HOME__
# Answer everyone, not only named people, through this IST date (blank = named only):
Environment=JOLLY_OPEN_UNTIL=
Restart=always
RestartSec=5

StandardOutput=append:__HOME__/.jwa/agent.log
StandardError=append:__HOME__/.jwa/agent.log

[Install]
WantedBy=default.target
