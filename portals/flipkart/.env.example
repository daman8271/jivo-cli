# Flipkart portal study — READ-ONLY. Copy to .env (gitignored) and fill.
# NEVER commit real values. This study never mints a session (GUARDRAILS G9):
# it consumes a cookie jar that ~/ecomcliauto's login scripts already produced.

# --- Seller Hub (3P marketplace) — seller.flipkart.com, login ecom8@jivo.in ---
# Full cookie jar string: T=…; connect.sid=…; sellerId=…; is_login=true; DID=…; nonce=…
FLIPKART_SELLER_COOKIE=
FLIPKART_SELLER_ID=
FLIPKART_SELLER_EMAIL=

# --- Vendor Hub (1P / Flipkart Grocery) — vendorhub.flipkart.com ---
# Cookie jar string incl. access_token=<JWT>; _csrf=…
FLIPKART_VENDOR_COOKIE=
FLIPKART_VENDOR_EMAIL=

# Source of a fresh jar (run these yourself; this study never runs them):
#   ~/ecomcliauto/auth/login/flipkart-seller-cdp.sh   -> out/flipkart-seller.curl
#   ~/ecomcliauto/auth/login/flipkart-vendor-cdp.sh   -> out/flipkart-vendor-fresh.curl
