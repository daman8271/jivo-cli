# Amazon portal study — READ-ONLY. Copy to .env (gitignored, chmod 0600).
#
# ⚠️ This study NEVER logs in (GUARDRAILS G9: consume a session, never mint one).
#    A fresh login rotates cookies out from under JIVO's live 10:30 IST cron and
#    can kick the e-com team out of the portal. These are CONSUMED, not created.
#
# Sessions are produced by the pre-existing live automation and read from:
#   Vendor Central : ~/.config/amazon-vc-cli/config.toml     (accounts.mart / accounts.wellness)
#   Seller Central : ~/ecomcliauto/auth/login/out/amazon-mp.cookies.json
#
# Point the CLI at those instead of duplicating secrets here:
AMAZON_VC_CONFIG=~/.config/amazon-vc-cli/config.toml
AMAZON_SC_COOKIE_JAR=~/ecomcliauto/auth/login/out/amazon-mp.cookies.json

# Which Vendor Central account to read under. wellness | mart
AMAZON_VC_ACCOUNT=wellness

# Non-secret account identifiers (safe to record — already in the seed docs).
# wellness: vendorGroupId 7691702  cid A2I4CTXZEM9HDK  "JIVO WELLNESS PVT. LTD."
# mart:     vendorGroupId 8592892  cid A2882479L2H86F  "Jivo Mart Private Limited."

# NEVER put a cookie, CSRF token, password, or TOTP seed in this file or in .env.
