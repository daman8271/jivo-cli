ound-color:#fff;border:1px solid var(--Alias-item-border-item-default, #D3D5D8);border-radius:4px;color:#232f3e}.katal .floating-widget__button:hover,.katal-visual-refresh-2024 .floating-widget__button:hover{background-color:#b6d0d3;border-color:#b6d0d3;color:#232f3e}.katal .floating-widget__button:active,.katal-visual-refresh-2024 .floating-widget__button:active{background-color:#b6d0d3;border-color:#b6d0d3;color:var(--kat-font-color-primary-dark, #b6d0d3)}.katal .floating-widget__button *[disabled],.katal-visual-refresh-2024 .floating-widget__button *[disabled]{background-color:#f5f9fa;border-color:#f5f9fa;color:#757575}.katal .floating-widget__side-panel--content,.katal-visual-refresh-2024 .floating-widget__side-panel--content{background-color:#fefefe}.katal .floating-widget__side-panel--content>[slot=description],.katal-visual-refresh-2024 .floating-widget__side-panel--content>[slot=description]{padding:12px 0 24px}.katal .floating-widget__side-panel--content>div>[slot=body],.katal .floating-widget__side-panel--content>div>[slot=body] iframe,.katal-visual-refresh-2024 .floating-widget__side-panel--content>div>[slot=body],.katal-visual-refresh-2024 .floating-widget__side-panel--content>div>[slot=body] iframe{min-height:calc(100vh - 200px)}.katal .floating-widget__side-panel--content>[slot=footer],.katal-visual-refresh-2024 .floating-widget__side-panel--content>[slot=footer]{display:flex;justify-content:right;position:absolute;bottom:0;width:100%;padding:24px;border-top:1px solid;border-top-color:var(--kat-border-divider-default, #D3D5D8)}.katal .floating-widget__side-panel__view-all .item,.katal-visual-refresh-2024 .floating-widget__side-panel__view-all .item{border-radius:7px;padding:16px}.katal .floating-widget__side-panel__view-all .item-body,.katal-visual-refresh-2024 .floating-widget__side-panel__view-all .item-body{padding:0 0 0 46px}.katal .floating-widget__side-panel__view-all .item-body__title,.katal-visual-refresh-2024 .floating-widget__side-panel__view