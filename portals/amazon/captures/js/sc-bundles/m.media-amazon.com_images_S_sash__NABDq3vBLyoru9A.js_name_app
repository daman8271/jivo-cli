েই।"},"pages.Error":{"retry-button-text":"বন্ধ করুন"}}}'),"translation-de.json":JSON.parse('{"de":{"pages.CloseModal":{"close_modal_content":"Möchten Sie die Änderungen wirklich verwerfen? Alle Änderungen, die Sie vorgenommen haben, werden nicht gespeichert und auch nicht geprüft.","close_modal_continue_editing":"Mit der Bearbeitung fortfahren","close_modal_discard_changes":"Änderungen verwerfen","close_modal_save":"Speichern","close_modal_title":"Sie haben Ihre Änderungen nicht gespeichert."},"pages.Error":{"retry-button-text":"Schließen"}}}'),"translation-en.json":JSON.parse('{"en":{"pages.CloseModal":{"close_modal_continue_editing":"Continue editing","close_modal_discard_changes":"Discard changes","close_modal_save":"Save","close_modal_title":"You have unsaved changes."},"pages.Error":{"call-for-retry-action-text":"Refresh this page and try again in a few minutes.","error-image-alt-text":"ErrorImage","retry-button-text":"Close","system-under-maintenance-text":"Sorry, our system is under maintenance."}},"en-AU":{"pages.CloseModal":{"close_modal_content":"Are you sure you want to discard changes? Any changes that you have made will not be saved and will not be verified."},"pages.Error":{}},"en-CA":{"pages.CloseModal":{"close_modal_content":"Are you sure you want to discard changes? Any changes you have made will not be saved and will not be verified."},"pages.Error":{}},"en-GB":{"pages.CloseModal":{"close_modal_content":"Are you sure you want to discard changes? Any changes you have made will not be saved and will not be verified."},"pages.Error":{}},"en-IE":{"pages.CloseModal":{"close_modal_content":"Are you sure that you want to discard the changes? Any changes that you have made will not be saved and will not be verified."},"pages.Error":{}},"en-IN":{"pages.CloseModal":{"close_modal_content":"Are you sure you want to discard changes? Any changes that you have made will not be saved and will not be verified."},"pages.Error":{}},"en-SG":{"pages.CloseModal":{"close_modal_content":"Are you sure you want to discard changes? Any changes you have made will not be saved and will not be verified."},"pages.Error":{}},"en-US":{"pages.CloseModal":{"close_modal_content":"Are you sure you want to discard changes? Any changes you have made will not be saved and will not be verified."},"pages.Error":{}},"en-ZA":{"pages.CloseModal":{"close_modal_content":"Are you sure you want to discard changes? Any changes you have made will not be saved and will not be verified."},"pages.Error":{}}}'),"translation-es.json":JSON.parse('{"es":{"pages.CloseModal":{"close_modal_discard_changes":"Descartar cambios","close_modal_save":"Guardar","close_modal_title":"Hay cambios sin guardar."},"pages.Error":{"retry-button-text":"Cerrar"}},"es-ES":{"pages.CloseModal":{"close_modal_content":"¿Seguro que quieres descartar los cambios? No se guardará ni verificará ninguno de los cambios que hayas hecho.","close_modal_continue_editing":"Continuar modificando"},"pages.Error":{}},"es-MX":{"pages.CloseModal":{"close_modal_content":"¿Confirmas que quieres descartar los cambios? Los cambios que hayas hecho no se guardarán ni se verificarán.","close_modal_continue_editing":"Continuar editando"},"pages.Error":{}}}'),"translation-fr.json":JSON.parse('{"fr":{"pages.CloseModal":{"close_modal_continue_editing":"Continuer la modification","close_modal_discard_changes":"Annuler les modifications","close_modal_save":"Enregistrer"},"pages.Error":{"retry-button-text":"Fermer"}},"fr-BE":{"pages.CloseModal":{"close_modal_content":"Êtes-vous sûr de vouloir ignorer les changements ? Les modifications effectuées ne seront pas enregistrées et vérifiées.","close_modal_title":"Vous avez des changements non enregistrés."},"pages.Error":{}},"fr-CA":{"pages.CloseModal":{"close_modal_content":"Voulez-vous vraiment annuler les modifications? Toutes les modifications que vous avez apportées ne seront pas enregistrées et ne seront pas vérifiées.","close_modal_title":"Vous avez des modifications non enregistrées."},"pages.Error":{}},"fr-FR":{"pages.CloseModal":{"close_modal_content":"Voulez-vous vraiment abandonner les modifications ? Toutes les modifications apportées ne seront pas enregistrées et ne seront pas vérifiées.","close_modal_title":"Vous avez des changements non enregistrés."},"pages.Error":{}}}'),"translation-gu.json":JSON.parse('{"gu":{"pages.CloseModal":{"close_modal_content":"શું તમે ખરેખર ફેરફારો કાઢી નાખવા માંગો છો? તમે કરેલા કોઈપણ ફેરફારો સાચવવામાં આવશે નહીં અને તેની ચકાસણી કરવામાં આવશે નહીં.","close_modal_continue_editing":"સંપાદન ચાલુ રાખો","close_modal_discard_changes":"ફેરફારો કાઢી નાખો","close_modal_save":"સેવ","close_modal_title":"તમારી પાસે સેવ ન કરેલા ફેરફારો છે."},"pages.Error":{"retry-button-text":"બંધ કરો"}}}'),"translation-hi.json":JSON.parse('{"hi":{"pages.CloseModal":{"close_modal_content":"क्या आप वाकई बदलावों को खारिज करना चाहते हैं? आपके द्वारा किए गए किसी भी बदलावों को सेव नहीं किया जाएगा और इन्हें वेरिफ़ाय नहीं किया जाएगा.","close_modal_continue_editing":"बदलाव करना जारी रखें","close_modal_discard_changes":"बदलावों को खारिज करें","close_modal_save":"सेव करें","close_modal_title":"आपके पास सेव नहीं किए गए बदलाव हैं."},"pages.Error":{"retry-button-text":"बंद करें"}}}'),"translation-it.json":JSON.parse('{"it":{"pages.CloseModal":{"close_modal_content":"Vuoi davvero annullare le modifiche? Eventuali modifiche da te apportate non verranno salvate e non saranno verificate.","close_modal_continue_editing":"Continua a modificare","close_modal_discard_changes":"Annulla modifiche","close_modal_save":"Salva","close_modal_title":"Alcune modifiche non sono state salvate."},"pages.Error":{"retry-button-text":"Chiudi"}}}'),"translation-ja.json":JSON.parse('{"ja":{"pages.CloseModal":{"close_modal_content":"変更を削除してよろしいですか？ 変更した内容は保存されず、確認も行われません。","close_modal_continue_editing":"編集を続ける","close_modal_discard_changes":"変更を破棄","close_modal_save":"保存","close_modal_title":"保存されていない変更があります。"},"pages.Error":{"retry-button-text":"閉じる"}}}'),"translation-kn.json":JSON.parse('{"kn":{"pages.CloseModal":{"close_modal_content":"ಬದಲಾವಣೆಗಳನ್ನು ತ್ಯಜಿಸಲು ನೀವು ಖಚಿತವಾಗಿ ಬಯಸುವಿರಾ? ನೀವು ಮಾಡಿದ ಯಾವುದೇ ಬದಲಾವಣೆಗಳನ್ನು ಉಳಿಸಲಾಗುವುದಿಲ್ಲ ಮತ್ತು ಪರಿಶೀಲಿಸಲಾಗುವುದಿಲ್ಲ.","close_modal_continue_editing":"ಸಂಪಾದನೆಯನ್ನು ಮುಂದುವರಿಸಿ","close_modal_discard_changes":"ಬದಲಾವಣೆಗಳನ್ನು ತಿರಸ್ಕರಿಸಿ","close_modal_save":"ಸೇವ್ ಮಾಡಿ","close_modal_title":"ನೀವು ಉಳಿಸದ ಬದಲಾವಣೆಗಳನ್ನು ಹೊಂದಿದ್ದೀರಿ."},"pages.Error":{"retry-button-text":"ಮುಚ್ಚಲಾಗಿದೆ"}}}'),"translation-ko.json":JSON.parse('{"ko":{"pages.CloseModal":{"close_modal_content":"변경 사항을 취소하시겠습니까? 변경한 사항은 저장되지 않으며 확인되지 않습니다.","close_modal_continue_editing":"편집 계속","close_modal_discard_changes":"변경 사항 취소","close_modal_save":"저장","close_modal_title":"저장되지 않은 변경 사항이 있습니다."},"pages.Error":{"retry-button-text":"닫기"}}}'),"translation-ml.json":JSON.parse('{"ml":{"pages.CloseModal":{"close_modal_content":"മാറ്റങ്ങൾ ഉപേക്ഷിക്കണമെന്ന് തീർച്ചയാണോ? നിങ്ങൾ വരുത്തിയ ഒരു മാറ്റങ്ങളും സംരക്ഷിക്കപ്പെടില്ല, പരിശോധിച്ചുറപ്പിക്കപ്പെടുകയുമില്ല.","close_modal_continue_editing":"എഡിറ്റ് ചെയ്യുന്നത് തുടരുക","close_modal_discard_changes":"മാറ്റങ്ങൾ ഉപേക്ഷിക്കുക","close_modal_save":"സംരക്ഷിക്കുക","close_modal_title":"നിങ്ങൾക്ക് സംരക്ഷിക്കാത്ത മാറ്റങ്ങൾ ഉണ്ട്."},"pages.Error":{"retry-button-text":"അടയ്‌ക്കുക"}}}'),"translation-mr.json":JSON.parse('{"mr":{"pages.CloseModal":{"close_modal_content":"तुम्हाला नक्की बदल रद्द करायचे आहेत का? तुम्ही केलेले कोणतेही बदल सेव्ह होणार नाहीत आणि त्याची पडताळणी होणार नाही.","close_modal_continue_editing":"संपादित करणे चालू ठेवा","close_modal_discard_changes":"बदल रद्द करा","close_modal_save":"सेव्‍ह करा","close_modal_title":"तुमच्याकडे सेव्ह न केलेले बदल आहेत."},"pages.Error":{"retry-button-text":"बंद करा"}}}'),"translation-nl.json":JSON.parse('{"nl":{"pages.CloseModal":{"close_modal_continue_editing":"Doorgaan met bewerken","close_modal_save":"Opslaan"},"pages.Error":{"retry-button-text":"Sluiten"}},"nl-BE":{"pages.CloseModal":{"close_modal_content":"Weet je zeker dat je de wijzigingen wilt verwijderen? Eventuele wijzigingen die je hebt aangebracht, worden niet opgeslagen en worden niet geverifieerd.","close_modal_discard_changes":"Wijzigingen verwijderen","close_modal_title":"Je hebt niet-opgeslagen wijzigingen."},"pages.Error":{}},"nl-NL":{"pages.CloseModal":{"close_modal_content":"Weet je zeker dat je de wijzigingen wilt annuleren? Eventuele wijzigingen die je hebt aangebracht, worden niet opgeslagen en worden niet geverifieerd.","close_modal_discard_changes":"Wijzigingen negeren","close_modal_title":"Niet alle wijzigingen zijn opgeslagen."},"pages.Error":{}}}'),"translation-pl.json":JSON.parse('{"pl":{"pages.CloseModal":{"close_modal_content":"Czy na pewno chcesz odrzucić zmiany? Wszelkie wprowadzone przez Ciebie zmiany nie zostaną zapisane i nie będą podlegać weryfikacji.","close_modal_continue_editing":"Kontynuuj edycję","close_modal_discard_changes":"Odrzuć zmiany","close_modal_save":"Zapisz","close_modal_title":"Masz niezapisane zmiany."},"pages.Error":{"retry-button-text":"Zamknij"}}}'),"translation-pt.json":JSON.parse('{"pt":{"pages.Error":{"retry-button-text":"Fechar"}},"pt-BR":{"pages.CloseModal":{"close_modal_content":"Tem certeza de que deseja descartar as alterações? As alterações feitas não serão salvas e não serão verificadas.","close_modal_continue_editing":"Continuar alteração","close_modal_discard_changes":"Descartar alteração","close_modal_save":"Salvar","close_modal_title":"Você tem alterações não salvas."},"pages.Error":{}},"pt-PT":{"pages.CloseModal":{"close_modal_content":"Tem a certeza de que pretende rejeitar as alterações? Quaisquer alterações que tenha feito não serão guardadas e não serão verificadas.","close_modal_continue_editing":"Continuar a editar","close_modal_discard_changes":"Rejeitar alterações","close_modal_save":"Guardar","close_modal_title":"Tem alterações não guardadas."},"pages.Error":{}}}'),"translation-sv.json":JSON.parse('{"sv":{"pages.CloseModal":{"close_modal_content":"Är du säker på att du vill ignorera ändringarna? Eventuella ändringar som du har gjort sparas och verifieras inte.","close_modal_continue_editing":"Fortsätt redigera","close_modal_discard_changes":"Ignorera ändringar","close_modal_save":"Spara","close_modal_title":"Du har ändringar som inte har sparats."},"pages.Error":{"retry-button-text":"Stäng"}}}'),"translation-ta.json":JSON.parse('{"ta":{"pages.CloseModal":{"close_modal_content":"நிச்சயமாக மாற்றங்களை நிராகரிக்க வேண்டுமா? நீங்கள் செய்த எந்த மாற்றங்களும் சேமிக்கப்படாது, சரிபார்க்கப்படாது.","close_modal_continue_editing":"திருத்தத்தைத் தொடரவும்","close_modal_discard_changes":"மாற்றங்களை நிராகரி","close_modal_save":"சேமி","close_modal_title":"சேமிக்கப்படாத மாற்றங்கள் உள்ளன."},"pages.Error":{"retry-button-text":"மூடுக"}}}'),"translation-te.json":JSON.parse('{"te":{"pages.CloseModal":{"close_modal_content":"మీరు ఖచ్చితంగా మార్పులను విస్మరించాలనుకుంటున్నారా? మీరు చేసిన ఏవైనా మార్పులు సేవ్ కావు అలాగే ధృవీకరించబడవు.","close_modal_continue_editing":"ఎడిటింగ్‌ను కొనసాగించండి","close_modal_discard_changes":"మార్పులను విస్మరించండి","close_modal_save":"సేవ్ చేయి","close_modal_title":"మీరు సేవ్ చేయని మార్పులు ఉన్నాయి."},"pages.Error":{"retry-button-text":"మూసివేయండి"}}}'),"translation-th.json":JSON.parse('{"th":{"pages.CloseModal":{"close_modal_content":"คุณแน่ใจหรือไม่ว่าต้องการละทิ้งการเปลี่ยนแปลง การเปลี่ยนแปลงใดๆ ที่คุณทำไว้จะไม่ได้รับการบันทึกและจะไม่ได้รับการตรวจสอบยืนยัน","close_modal_continue_editing":"ดำเนินการแก้ไขต่อ","close_modal_discard_changes":"ยกเลิกการเปลี่ยนแปลง","close_modal_save":"บันทึก","close_modal_title":"คุณมีการเปลี่ยนแปลงที่ยังไม่ได้บันทึก"},"pages.Error":{"retry-button-text":"ปิด"}}}'),"translation-tr.json":JSON.parse('{"tr":{"pages.CloseModal":{"close_modal_content":"Değişiklikleri iptal etmek istediğinizden emin misiniz? Yaptığınız herhangi bir değişiklik kaydedilmez ve doğrulanmaz.","close_modal_continue_editing":"Düzenlemeye devam edin","close_modal_discard_changes":"Değişiklikleri at","close_modal_save":"Kaydet","close_modal_title":"Kaydedilmemiş değişiklikleriniz var."},"pages.Error":{"retry-button-text":"Kapat"}}}'),"translation-vi.json":JSON.parse('{"vi":{"pages.CloseModal":{"close_modal_content":"Bạn có chắc muốn hủy thay đổi không? Mọi thay đổi bạn đã thực hiện sẽ không được lưu và sẽ không được xác minh.","close_modal_continue_editing":"Tiếp tục chỉnh sửa","close_modal_discard_changes":"Hủy thay đổi","close_modal_save":"Lưu","close_modal_title":"Bạn có các thay đổi chưa được lưu."},"pages.Error":{"retry-button-text":"Đóng"}}}'),"translation-zh.json":JSON.parse('{"zh-CN":{"pages.CloseModal":{"close_modal_content":"是否确定要放弃更改？ 您所做的任何更改都不会保存，也不会进行验证。","close_modal_continue_editing":"继续编辑","close_modal_discard_changes":"放弃更改","close_modal_save":"保存","close_modal_title":"您的某些更改未保存。"},"pages.Error":{"retry-button-text":"关闭"}},"zh-TW":{"pages.CloseModal":{"close_modal_content":"您確定要捨棄變更內容嗎？ 您所做的任何變更都不會儲存，也不會受到驗證。","close_modal_continue_editing":"繼續編輯","close_modal_discard_changes":"捨棄變更","close_modal_save":"儲存","close_modal_title":"您有未儲存的變更。"},"pages.Error":{"retry-button-text":"關閉"}}}'),"translation.json":JSON.parse('{"und":{"pages.CloseModal":{"close_modal_content":"Are you sure you want to discard changes? Any changes you have made will not be saved and will not be verified.","close_modal_continue_editing":"Continue editing","close_modal_discard_changes":"Discard changes","close_modal_save":"Save","close_modal_title":"You have unsaved changes."},"pages.Error":{"call-for-retry-action-text":"Refresh this page and try again in a few minutes.","error-image-alt-text":"ErrorImage","retry-button-text":"Close","system-under-maintenance-text":"Sorry, our system is under maintenance."}}}')},be="en-US";function Ae(){/*! regenerator-runtime -- Copyright (c) 2014-present, Facebook, Inc. -- license (MIT): https://github.com/facebook/regenerator/blob/main/LICENSE */Ae=function(){return t};var e,t={},a=Object.prototype,r=a.hasOwnProperty,n=Object.defineProperty||function(e,t,a){e[t]=a.value},i="function"==typ