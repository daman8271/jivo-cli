AA,CAIJ,8HACI,iBAAA,CACA,OAAA,CACA,MAAA,CACA,YAAA,CACA,KAAA,CACA,8BAAA,CACA,SAAA,CAEA,oKACI,YAAA,CACA,QAAA,CACA,mDAAA,CAAA,2CAAA,CAEA,kBAAA,CACA,oBAAA,CAGJ,kKACI,cAAA,CACA,UAAA,CAMJ,wWACI,cAAA,CAGJ,w5CAII,cAAA,CACA,iBAAA,CACA,WAAA,CACA,wBAAA,CACA,UAAA,CACA,WAAA,CAEA,wgDACI,UAAA,CACA,iBAAA,CACA,KAAA,CACA,MAAA,CACA,OAAA,CACA,QAAA,CACA,kCAAA,CACA,qCAAA,CAGJ,gkGACI,iBAAA,CAMJ,wwBACI,8BAAA,CAGJ,g/EAII,cAAA,CAHA,wpFACI,oCAAA,CAQR,gwBACI,+BAAA,CAGJ,w9EAII,cAAA,CAHA,goFACI,qCAAA,CAShB,kHACI,mBAAA,CACA,iBAAA,CACA,aAAA,CACA,eAAA,CACA,UAAA,CACA,cAAA,CAEA,8JACI,UAAA,CACA,WAAA,CACA,cAAA,CACA,WAAA,CACA,eAAA,CACA,aAAA,CAEA,oLACI,YA1ID,CA2IC,cA3ID,CA4IC,IAAA,CACA,IAAA,CACA,GAAA,CAGJ,8LACI,cAAA,CACA,4MACI,YAnJP,CAoJO,cApJP,CA2JT,0GACI,iCAAA,CACA,qDAAA,CACA,iBAtJO,CAuJP,wBAAA,CACA,eAAA,CACA,wBAAA,CAEA,8IACI,SAAA,CACA,eAAA,CACA,QAAA,CAGJ,sIACI,YAAA,CACA,qBAAA,CACA,iBAAA,CAKR,sFACI,YAAA,CACA,eAAA,CACA,QAAA,CAEA,gHACI,sCAtMH,CAyMD,4GACI,iCAAA,CACA,aAtMC,CAuMD,kBAAA,CACA,kBAAA,CACA,iBAAA,CACA,eAAA,CACA,kBAAA,CAKR,wFACI,kBAAA,CACA,iBAAA,CAEA,wMACI,cAAA,CACA,UAAA,CAIA,gcACI,aArNX,CAsNW,oBAAA,CAIR,sGACI,kBAAA,CACA,wBA7NR,CA8NQ,UAAA,CACA,iBAAA,CACA,UAAA,CACA,WAAA,CACA,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,iBAAA,CACA,WAAA,CACA,SAAA,CACA,eAAA,CAKR,gFACI,iBAAA,CAGA,0FACI,0CApQA,CAsQJ,0FACI,6CAnQA,CAqQJ,4FACI,4CAxQE,CA6QV,oFACI,iBAAA,CACA,0BAAA,CACA,8BAAA,CACA,8BAAA,CACA,8BAAA,CACA,oCAAA,CACA,gBAAA,CACA,4BAAA,CACA,cAAA,CACA,qBAAA,CACA,+DAAA,CACA,iBAAA,CACA,aA/QK,CAiRL,gGACI,wBAAA,CACA,oBAAA,CACA,aApRC,CAsRL,kGACI,wBAAA,CACA,oBAAA,CACA,iDAAA,CAEJ,4GACI,wBAAA,CACA,oBAAA,CACA,aAAA,CAQJ,8GACI,wBA3SO,CA4SP,oJACI,mBAAA,CAIA,0SACI,8BAAA,CAGR,0IACI,YAAA,CACA,qBAAA,CACA,iBAAA,CACA,QAAA,CACA,UAAA,CACA,YAtSD,CAuSC,oBAAA,CACA,2DAvTN,CA8TE,4HACI,iBA/SD,CAgTC,YAAA,CAEA,sIACI,kBAAA,CACA,oJACI,kBAAA,CAIR,wJACI,mBAAA,CACA,YAAA,CACA,qBAAA,CAMJ,wKACI,2DAnVV,CAoVU,WAAA,CAEJ,wJACI,UAAA,CACA,gBAAA,CAMR,gIACI,kBAAA,CAEJ,0HACI,WAAA,CAEJ,kIACI,OAAA,CAEJ,8IACI,wBAAA,CAKZ,oGACI,aA3WJ,CA4WI,iBAAA,CACA,wBAAA,CACA,cAAA,CAIA,8KACI,YAAA,CAEJ,8HACI,mBAAA",sourcesContent:['$statusInfo: #0A6FC2;\n$statusInfoVar: var(--kat-text-status-info, $statusInfo);\n$statusDanger: #CF2900;\n$statusDangerVar: var(--kat-text-status-danger, $statusDanger);\n$statusWarn: #EBAC00;\n$statusWarnVar: var(--kat-text-status-warning, $statusWarn);\n$disabled: #868D95;\n$disabledVar: var(--kat-text-disabled, $disabled);\n$primary: #002F36;\n$primaryVar: var(--kat-text-primary, $primary);\n$modalBackgroundColor: #fefefe;\n$accentBG: #d3d5d8;\n$secondaryBG: #F7F7F8;\n$secondaryBGVar: var(--kat-background-message-secondary, $secondaryBG);\n$secondaryColor: #232F3E;\n$dividers: #D3D5D8;\n$dividersVar: var(--kat-border-divider-default, $dividers);\n\n// Specific to Floating Widget\n$badge: #E20000;\n$border: #0859A0;\n\n// Carousel\n$carouselInactive: #BDC0C5;\n$carouselActive: #5E6A78;\n\n// View All Panel\n$closeDefaultState: #002F36;\n$closeActiveState: $statusInfo;\n\n// Widget Settings\n$panelBaseSpacing: 24px;\n$baseBorderRadius: 7px;\n\n// Responsiveness\n$min-break-point: 750px;\n$max-break-point: 749px;\n\n.katal, .katal-visual-refresh-2024 { \n    .floating-widget {\n        // Resets\n        text-align: left;\n        position: relative;\n\n        // Custom carousel controls (Deprecated)\n        .kat-carousel-controls-container {\n            display: none !important; // We are using custom controls\n            position: absolute;\n            bottom: 0;\n            display: grid;\n            height: 50px;\n            grid-template-columns: 1fr min-content 1fr;\n            width: 100%;\n        }\n\n        // Styling for custom controls: <ItemCardCarouselControls />\n        .carousel-controls-container {\n            position: absolute;\n            top: 8px;\n            left: 0;\n            display: grid;\n            gap: 0;\n            grid-template-columns: 50px 1fr;\n            width: 50%;\n\n            .carousel-controls {\n                display: grid;\n                gap: 20px;\n                grid-template-columns: 28px min-content 28px;\n                // Safari fix for grid cells\n                align-items: center;\n                justify-items: center;\n            }\n\n            .carousel-counter {\n                font-size: 13px;\n                color: #000;\n            }\n        }\n    \n        .kat-carousel-controls-container,\n        .carousel-controls-container {\n            > button.kat-carousel-hide {\n                display: inline;\n            }\n\n            .kat-carousel-right-button,\n            .carousel-right-button,\n            .kat-carousel-left-button,\n            .carousel-left-button {\n                cursor: pointer;\n                position: relative;\n                border: none;\n                background: transparent;\n                width: 16px;\n                height: 18px;\n\n                &:before {\n                    content: "";\n                    position: absolute;\n                    top: 0;\n                    left: 0;\n                    width: 0;\n                    height: 0;\n                    border-top: 9px solid transparent;\n                    border-bottom: 9px solid transparent;\n                }\n\n                KatIcon, kat-icon {\n                    visibility: hidden;\n                }\n            }\n\n            .kat-carousel-right-button,\n            .carousel-right-button {\n                &:before {\n                    border-left: 16px solid $carouselActive;\n                }\n                \n                &.kat-carousel-hide, &.kat-carousel-disable, &.disabled {\n                    &:before {\n                        border-left-color: $carouselInactive !important;\n                    }\n                    cursor: default;\n                }\n            }\n            \n            .kat-carousel-left-button,\n            .carousel-left-button {\n                &:before {\n                    border-right: 16px solid $carouselActive;\n                }\n                \n                &.kat-carousel-hide, &.kat-carousel-disable, &.disabled {\n                    &:before {\n                        border-right-color: $carouselInactive !important;\n                    }\n                    cursor: default;\n                }\n            }\n            \n        }\n\n        // Custom Dots (Deprecated)\n        .kat-carousel-nav-dots {\n            justify-self: center;\n            align-self: center;\n            grid-column: 2;\n            position: static;\n            grid-row: 1;\n            padding: 0 16px;\n\n            .kat-carousel-nav-dot { \n                width: 18px;\n                height: 18px;\n                cursor: pointer;\n                padding: 2px;\n                margin-left: 8px;\n                display: block;\n\n                svg circle {\n                    fill: $carouselInactive;\n                    stroke: $carouselInactive;\n                    cx: 7;\n                    cy: 7;\n                    r: 6;\n                }\n\n                &.kat-current-dot {\n                    cursor: default;\n                    circle {\n                        fill: $carouselActive;\n                        stroke: $carouselActive;\n                    }\n                }\n            }\n        }\n\n        // Task items\n        kat-carousel-items {\n            transition: height 0.4s ease-in-out;\n            box-shadow: 0px 4px 8px 0px rgba(0, 31, 36, 0.1490196078);\n            border-radius: $baseBorderRadius;\n            border: 1px solid $border;\n            overflow: hidden;\n            padding-top: 0 !important;\n\n            kat-carousel-item {\n                padding: 0;\n                box-shadow: none;\n                border: 0;\n            }\n\n            [slot="footer"] {\n                display: flex;\n                justify-content: right;\n                position: relative;\n            }\n        }\n\n        // Item Cards\n        kat-card {\n            padding: 16px;\n            box-shadow: none;\n            border: 0;\n\n            [slot="title"] {\n                color: $primaryVar;\n            }\n\n            .item-body {\n                transition: height 0.4s ease-in-out;\n                color: $secondaryColor;\n                padding: 0 0 0 30px;\n                margin-bottom: 15px;\n                position: relative;\n                min-height: 60px;\n                line-height: normal;\n            }\n        }\n\n        // View all link\n        &__view-all {\n            padding-right: 30px;\n            position: relative;\n\n            &, &::part(link) {\n                cursor: pointer;\n                color: #000;\n            }\n\n            &:hover, &:focus {\n                &, &::part(link) {\n                    color: $border;\n                    text-decoration: none;\n                }\n            }\n\n            &__badge {\n                border-radius: 100%;\n                background-color: $badge;\n                color: #fff;\n                text-align: center;\n                width: 24px;\n                height: 24px;\n                display: flex;\n                align-items: center;\n                justify-content: center;\n                position: absolute;\n                right: -30px;\n                top: -100%;\n                margin-top: 12px;\n            }\n        }\n    \n        // Task item icons\n        &__icon {\n            position: absolute;\n\n            // Driven by the taskSeverity value within the config\n            &.info {\n                color: $statusInfoVar;\n            }\n            &.warn {\n                color: $statusWarnVar;\n            }\n            &.error {\n                color: $statusDangerVar;\n            }\n        }\n\n        // Custom Button (secondary)\n        &__button {\n            border-radius: 1px;\n            font-size: var(--font-size);\n            font-weight: var(--font-weight);\n            font-family: var(--font-family);\n            line-height: var(--line-height);\n            letter-spacing: var(--letter-spacing);\n            padding: 8px 24px;\n            text-align: var(--text-align);\n            cursor: pointer;\n            background-color: #fff;\n            border: 1px solid var(--Alias-item-border-item-default, #D3D5D8);\n            border-radius: 4px;\n            color: $secondaryColor;\n\n            &:hover {\n                background-color: #b6d0d3;\n                border-color: #b6d0d3;\n                color: $secondaryColor;\n            }\n            &:active {\n                background-color: #b6d0d3;\n                border-color: #b6d0d3;\n                color: var(--kat-font-color-primary-dark, #b6d0d3);\n            }\n            *[disabled] {\n                background-color: #f5f9fa;\n                border-color: #f5f9fa;\n                color: #757575;\n            }\n        }\n\n        // Side Panel component\n        &__side-panel {\n\n            // Panel Content\n            &--content {\n                background-color: $modalBackgroundColor;\n                > [slot="description"] {\n                    padding: calc($panelBaseSpacing/2) 0 $panelBaseSpacing;\n                }\n                > div > [slot="body"]{\n                    // 100 viewport height minus header/footer\n                    &, iframe {\n                        min-height: calc(100vh - 200px);\n                    }\n                }\n                > [slot="footer"]{\n                    display: flex;\n                    justify-content: right;\n                    position: absolute;\n                    bottom: 0;\n                    width: 100%;\n                    padding: $panelBaseSpacing;\n                    border-top: 1px solid;\n                    border-top-color: $dividersVar;\n                }\n            }\n\n            // View all panel view\n            &__view-all {\n                // Task Items UI within View All panel\n                .item{\n                    border-radius: $baseBorderRadius;\n                    padding: 16px;\n\n                    &-body {\n                        padding: 0 0 0 46px;\n                        &__title {\n                            padding-bottom: 8px;\n                        }\n                    }\n\n                    [slot="footer"] {\n                        padding: 24px 15px 0;\n                        display: flex;\n                        justify-content: right;\n                    }\n                }\n\n                // Task item divider\n                kat-divider{ \n                    &[variant=athens] {\n                        background-color: $dividersVar;\n                        opacity: 50%;\n                    }\n                    &.divider {\n                        width: 100%;\n                        margin: $panelBaseSpacing auto;\n                    }\n                }\n            }\n\n            &__form {\n                .form-field {\n                    margin-bottom: 24px;\n                }\n                .divider {\n                    margin: 24px;\n                }\n                kat-checkbox {\n                    gap: 8px;\n                }\n                kat-label kat-icon {\n                    color: $secondaryColor !important;\n                }\n            }\n        }\n\n        .title__new-tag {\n            color: $badge;\n            padding-left: 10px;\n            text-transform: uppercase;\n            font-size: 14px;\n        }\n\n        &.disabled-navigation {\n            .kat-carousel-controls-container {\n                display: none;\n            }\n            kat-card {\n                padding-bottom: 16px;\n            }\n        }\n    }\n}\n'],sourceRoot:""}]),t.Z=o},47420:(e,t,a)=>{"use strict";var r=a(94015),n=a.n(r),i=a(23645),o=a.n(i)()(n());o.push([e.id,":root{--dew-main-black: rgba(