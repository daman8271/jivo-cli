flyoutOverlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background-color: var(--dew-main-black);\n  z-index: 999;\n  display: none;\n}\n\n.flyoutPanel {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  background-color: var(--dew-main-black);\n  --box-shadow: -2px 0 10px var(--dew-main-black);\n  z-index: 1000;\n}\n\n.flyoutPanelContent {\n  position: absolute;\n  top: 0;\n  right: 0;\n  height: 100%;\n  width: 0%;\n  background-color: var(--dew-main-white);\n  overflow: hidden;\n  box-sizing: border-box;\n  transition: width 0.5s ease-in-out;\n}\n\n/* If you change please check the size of content in Layout Panel*/\n.flyoutPanel.active .flyoutPanelContent {\n  max-width: min(31.25rem, 100vw);\n  min-width: min(31.25rem, 100vw);\n}\n\n.contentWrapper {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  box-sizing: border-box;\n}\n\n/* Skeleton Component CSS */\n.container {\n  display: flex;\n  flex-direction: column;\n  height: 100%; /* Ensure the container takes up the full height of its parent */\n  box-sizing: border-box;\n  padding: 16px;\n}\n\n.body {\n  display: flex;\n  flex-direction: column;\n  flex-grow: 1; /* Main content takes up remaining space */\n  gap: 1rem;\n  margin-top: 4rem;\n}\n\n.skeleton {\n  animation: skeleton-loading 1s linear infinite alternate;\n}\n\n@keyframes skeleton-loading {\n  0% {\n    background-color: hsl(200, 20%, 80%);\n  }\n  100% {\n    background-color: hsl(200, 20%, 95%);\n  }\n}\n.skeleton-text {\n  width: 100%;\n  height: 4rem;\n  margin-bottom: 0.5rem;\n  border-radius: 0.25rem;\n}\n\n.skeleton-text__body {\n  height: 1rem;\n}\n\n.skeleton-footer {\n  height: 1rem;\n}\n\n/*# sourceMappingURL=index.css.map */\n"],sourceRoot:""}]),t.Z=o},21767:(e,t,a)=>{"use strict";var r=a(94015),n=a.n(r),i=a(23645),o=a.n(i)()(n());o.push([e.id,':root{--kat-line-height-xxsmall:0.3;--kat-line-height-xsmall:0.5;--kat-line-height-small:0.8;--kat-line-height-medium:1;--kat-lin