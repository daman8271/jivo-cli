block;\n  position: fixed; /* Stay in place */\n  z-index: 100; /* Sit on top */\n  text-align: left !important; /* Align text left */\n  left: 0;\n  top: 0;\n  width: 100%; /* Full width */\n  height: 100%; /* Full height */\n  overflow: auto; /* Enable scroll if needed */\n  background-color: rgb(0,0,0); /* Fallback color */\n  background-color: rgba(0,0,0,0.4); /* Black w/ opacity */\n  -webkit-animation-name: fadeIn; /* Fade in the background */\n  -webkit-animation-duration: 0.4s;\n  animation-name: fadeIn;\n  animation-duration: 0.4s\n}\n\n// Shares panel width between custom slide out panel and KatPanel\n@mixin responsive-panel-width {\n  @media (min-width: $break-point) {\n    width: min(40%, 595px) !important;\n  }\n\n  @media (max-width: $break-point) {\n    width: 100% !important;\n  }\n}\n\n/* Modal Content */\n.remediation-widget-modal-content {\n  position: fixed;\n  overflow-y: auto;\n  padding: 60px 0 75px 0;\n  top: 0;\n  right: 0;\n  background-color: $modalBackgroundColor;\n  width: min(40%, 750px);\n  height: 100%;\n  -webkit-animation-name: slideIn;\n  -webkit-animation-duration: 0.4s;\n  animation-name: slideIn;\n  animation-duration: 0.4s;\n\n  &,\n  .form-actions,\n  .inform__footer,\n  .inform__header,\n  .vas__header,\n  .vas__footer,\n  .dac_verification__header,\n  .w8ben_verification__header,\n  .denver_verification__header,\n  .brkyc_verification__header,\n  .cakyc_verification__header,\n  .relatedAccounts_verification__header,\n  .AccountTrustIPI_verification__header {\n    @include responsive-panel-width;\n  }\n}\n\n.remediation-widget-wrapper {\n  kat-panel {\n    @include responsive-panel-width;\n  }\n\n  // MYP Action Panel requires a fixed width based on the style constraints of\n  // the federated module that loads within it.\n  kat-panel#myp-action-panel {\n    width: 100% !important;\n    max-width: 410px !important;\n  }\n\n  .ActionPanelFooter-module__footer--WdzK- {\n    @include responsive-panel-width;\n  }\n}\n\n.form-actions,\n.inform__footer,\n.inform__header,\n.vas__header,\n.vas__footer,\n.penalty_recovery__header,\n.dac_verification__header,\n.w8ben_verification__header,\n.denver_verification__header,\n.brkyc_verification__header,\n.cakyc_verification__header,\n.relatedAccounts_verification__header,\n.AccountTrustIPI_verification__header {\n  position: fixed;\n  z-index: 10000;\n  background-color: $modalBackgroundColor;\n  padding: 20px;\n  width: 100%;\n}\n\n.form-actions {\n  display: flex;\n  flex-direction: row-reverse;\n  align-items: flex-end;\n  gap: 20px;\n  border-top: 1px solid $dividerColor;\n  bottom: 0;\n}\n\n.remediation-widget-modal-header {\n  position: fixed;\n  top: 15px;\n  right: 20px;\n  z-index: 100001;\n  height: 34px;\n  width: 34px;\n\n  /* The Close Button */\n  .close {\n    color: $closeText;\n    font-size: 24px;\n    line-height: 24px;\n    height: 34px;\n    width: 34px;\n    padding: 4px;\n    border: 1px solid transparent;\n\n    &:hover,\n    &:focus,\n    &:active {\n      color: $closeTextActive;\n      text-decoration: none;\n      cursor: pointer;\n      border-color: $closeTextActive;\n    }\n  }\n}\n\n.iframe-wrapper {\n  flex: 0 0 66%;\n  height: 100%;\n}\n\n.iframe-content {\n  height: 100%;\n}\n\n.espresso-form {\n  height: 85vh;\n}\n\n/* Add Animation */\n@-webkit-keyframes slideIn {\n  from {right: -300px; opacity: 0}\n  to {right: 0; opacity: 1}\n}\n\n@keyframes slideIn {\n  from {right: -300px; opacity: 0}\n  to {right: 0; opacity: 1}\n}\n\n@-webkit-keyframes fadeIn {\n  from {opacity: 0}\n  to {opacity: 1}\n}\n\n@keyframes fadeIn {\n  from {opacity: 0}\n  to {opacity: 1}\n}\n\n.inform,\n.vas,\n.dac_verification,\n.w8ben_verification,\n.denver_verification,\n.brkyc_verification,\n.cakyc_verification,\n.relatedAccounts_verification,\n.AccountTrustIPI_verification,\n.penalty_recovery {\n  &__header {\n    border-bottom: 1px solid $dividerColor;\n    top: 0;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding-right: 60px;\n\n    h2, h2.form-title,\n    .form-title {\n      font-size: 18px !important;\n      font-weight: bold !important;\n      line-height: 1;\n      margin: 0;\n    }\n  }\n\n  &__body {\n    padding: 20px 30px;\n  }\n}\n\n.action-panel-banner {\n  display: flex !important;\n  align-items: center;\n  background-color: #E3ECED;\n  border-radius: 10px;\n  height: 64px;\n  margin: 20px 0;\n  padding-left: 40px;\n  padding-top: 5px;\n}\n\n.mini-action-panel-banner {\n  &__at_risk {\n    display: flex !important;\n    align-items: center;\n    border-radius: 44px;\n    height: 31px;\n    padding: 5px 10px;\n    background-color: #FFF5D1;\n  }\n\n  &__critical {\n    display: flex !important;\n    align-items: center;\n    border-radius: 44px;\n    height: 31px;\n    padding: 5px 10px;\n    background-color: #FFDBDB;\n  }\n}\n\n.mini-action-panel-banner .ahd-risk-banner-icon {\n  margin-right: 10px;\n}\n\n.mini-action-panel-banner {\n  &__critical {\n    h5 {\n      margin: 0;\n    }\n\n    .ahd-risk-banner-icon {\n      margin-right: 10px;\n    }\n  }\n\n  &__at_risk {\n    h5 {\n      margin: 0;\n    }\n\n    .ahd-risk-banner-icon {\n      margin-right: 10px;\n    }\n  }\n}\n\n#dac-action-panel-impact.priority-action-past-due,\n#w8ben-action-panel-impact.priority-action-past-due,\n#w8ben-action-panel-impact.priority-action-due-date,\n#dac-action-panel-impact.priority-action-due-date,\n#brkyc-action-panel-impact.priority-action-due-date,\n#brkyc-action-panel-impact.priority-action-past-due,\n#cakyc-action-panel-impact.priority-action-due-date,\n#cakyc-action-panel-impact.priority-action-past-due,\n#AccountTrustIPI-action-panel-impact.priority-action-due-date,\n#AccountTrustIPI-action-panel-impact.priority-action-past-due,\n#relatedAccounts-action-panel-impact.priority-action-past-due,\n#relatedAccounts-action-panel-impact.priority-action-due-date {\n  margin-left: 20px;\n}\n\n.priority-action-past-due {\n  font-weight: bold;\n  color: #B60000;\n}\n\n.flex-end-container {\n  display: flex;\n  justify-content: flex-end;\n}\n"],sourceRoot:""}]),t.Z=o},13323:(e,t,a)=>{"use strict";var r=a(94015),n=a.n(r),i=a(23645),o=a.n(i)()(n());o.push([e.id,".selling-assistant-widget{width:-webkit-fit-content;width:-moz-fit-content;width:fit-content;max-width:100%}.selling-assistant-loading{display:flex;justify-content:center;padding:20px}.selling-assistant-error{padding:16px;color:#d13212;background-color:#fdf2f2;border:1px solid #f5c6cb;border-radius:4px}","",{version:3,sources:["webpack://./node_modules/@amzn/account-health-action-panel/dist/components/SellingAssistantAccountHealthWidget/sellingAssistantAccountHealthWidget.scss"],names:[],mappings:"AAAA,0BACE,yBAAA,CAAA,sBAAA,CAAA,iBAAA,CACA,cAAA,CAGF,2BACE,YAAA,CACA,sBAAA,CACA,YAAA,CAGF,yBACE,YAAA,CACA,aAAA,CACA,wBAAA,CACA,wBAAA,CACA,iBAAA",sourcesContent:[".selling-assistant-widget {\n  width: fit-content;\n  max-width: 100%;\n}\n\n.selling-assistant-loading {\n  display: flex;\n  justify-content: center;\n  padding: 20px;\n}\n\n.selling-assistant-error {\n  padding: 16px;\n  color: #d13212;\n  background-color: #fdf2f2;\n  border: 1px solid #f5c6cb;\n  border-radius: 4px;\n}\n"],sourceRoot:""}]),t.Z=o},9359:(e,t,a)=>{"use strict";var r=a(94015),n=a.n(r),i=a(23645),o=a.n(i)()(n());o.push([e.id,".takeover-v2-image-container{margin:0 0 20px 0;width:100%;height:350px;display:flex;align-items:center;justify-content:center}.takeover-v2-image-container.red-grey-bg{background-color:#ccc}.takeover-v2-image-container.red-red-bg{background-color:#b02705}.takeover-v2-image-container.yellow-grey-bg{background-color:#ccc}.takeover-v2-image-container.yellow-yellow-bg{background-color:#f5bd4e}.takeover-v2-image-container.default-bg{background-color:#b02705}.takeover-v2-modal-header{font-size:24px;font-weight:700;color:#002f36;line-height:40px}.takeover-v2-modal-description{font-size:16px;line-height:24px}.takeover-v2-modal{--body-padding: 0px;--width: 80vw;--max-width: 800px;--fo