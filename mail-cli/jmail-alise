#!/usr/bin/env bash
# jmail against daman@alise.in (Hostinger) instead of the JIVO accounts mailbox.
# Reads ALISE_MAIL_* from the repo-root .env (gitignored) and maps them to the
# ZOHO_MAIL_* names jmail's config expects. Usage: ./jmail-alise search --limit 20
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/.." && pwd)"
env_file="$root/.env"
[[ -f "$env_file" ]] || { echo "no .env at $root" >&2; exit 1; }
get() { grep -E "^$1=" "$env_file" | head -1 | cut -d= -f2-; }
export ZOHO_MAIL_USER="$(get ALISE_MAIL_USER)"
export ZOHO_MAIL_APP_PASSWORD="$(get ALISE_MAIL_APP_PASSWORD)"
export ZOHO_MAIL_IMAP_HOST="$(get ALISE_MAIL_IMAP_HOST)"
export ZOHO_MAIL_IMAP_PORT="$(get ALISE_MAIL_IMAP_PORT)"
[[ -n "$ZOHO_MAIL_USER" ]] || { echo "ALISE_MAIL_USER not set in .env" >&2; exit 1; }
exec "$here/jmail" "$@"
