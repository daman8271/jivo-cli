#!/usr/bin/env bash
# jmail against accounts007@jivo.in — maps ZOHO_MAIL_ACCOUNTS007_* onto the names jmail expects.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/.." && pwd)"
env_file="$root/.env"
[[ -f "$env_file" ]] || { echo "no .env at $root" >&2; exit 1; }
get() { grep -E "^$1=" "$env_file" | head -1 | cut -d= -f2-; }
export ZOHO_MAIL_USER="$(get ZOHO_MAIL_ACCOUNTS007_USER)"
export ZOHO_MAIL_APP_PASSWORD="$(get ZOHO_MAIL_ACCOUNTS007_APP_PASSWORD)"
export ZOHO_MAIL_IMAP_HOST="$(get ZOHO_MAIL_ACCOUNTS007_IMAP_HOST)"
export ZOHO_MAIL_IMAP_PORT="$(get ZOHO_MAIL_ACCOUNTS007_IMAP_PORT)"
[[ -n "$ZOHO_MAIL_USER" ]] || { echo "ZOHO_MAIL_ACCOUNTS007_USER not set" >&2; exit 1; }
exec "$here/jmail" "$@"
