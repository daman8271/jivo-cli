# FLEET / SERVER-ROOM ACCESS — gitignored, do NOT commit
# Set up 2026-07-25. Tailscale subnet router opened the JIVO server-room LAN.

# --- The door (Tailscale) ---
# Machine "jivo" (Tailscale IP 100.104.229.5) = the SAP application server.
# It advertises the server-room subnet 20.20.45.0/24 (route APPROVED, key expiry DISABLED).
# From any tailnet device we can now reach every 20.20.45.x host. Permanent.
TS_JIVO_NODE=100.104.229.5
TS_SUBNET=20.20.45.0/24

# --- SAP application server (the "jivo" box) — WORKING ---
# Windows admin over SMB. Shares: B1_SHR (SAP install), FR6Share (RanceLab POS),
# SCSW_WORKING_SHARE, Software, Users, C$, ADMIN$.
SAPSRV_HOST=100.104.229.5
SAPSRV_SMB_USER=ADMIN
SAPSRV_SMB_PASS=English@jivo

# --- File server JIVO-APP (20.20.45.25) — attachments live here — NOT YET UNLOCKED ---
# Share \\20.20.45.25\Attachments_Oil\JIVO_OIL\Attachments  (the invoice PDFs).
# Separate machine, separate local login. ADMIN/English@jivo and SAP creds all REJECTED.
# TODO: get JIVO-APP's own share username/password from IT.
JIVOAPP_HOST=20.20.45.25
JIVOAPP_SHARE=Attachments_Oil
# WORKING 2026-07-29: the REAL JIVO-APP login is  ADMIN / TFGr#957#$%#  (machine JIVO-APP).
# Verified from jivo-dbsap: lists ALL shares (Attachments_Oil / _Mart / _Bev, C$/D$/E$, Desktop),
# browses & pulls files. Attachments live flat under e.g. Attachments_Oil\JIVO_OIL\<file>.
# Pull:  smbclient //20.20.45.25/Attachments_Oil -A <authfile> -c "cd JIVO_OIL; get \"<name>\" /tmp/x"
#   -> then  scp jivo-sap:/tmp/x  down.  Password has % # $  → ALWAYS use an -A auth file
#   (username=ADMIN / password=TFGr#957#$%#), never -U user%pass.
# JIVO-APP is also reachable by RDP on PUBLIC 103.89.45.25:13579 (SMB 445 is closed publicly;
# reach the share via the INTERNAL 20.20.45.25 from jivo-dbsap, same server-room LAN).
JIVOAPP_SMB_USER=ADMIN
JIVOAPP_SMB_PASS=TFGr#957#$%#
JIVOAPP_RDP=103.89.45.25:13579
# superseded WRONG guesses (both LOGON_FAILURE): superadmin/Aqr@3609, superadmin/Jivo!@#$2026.
# (Aside: Jivo!@#$2026 is also NOT the Linux root pw — su/sudo reject it; root pw still unknown.)

# --- REVERSE SSH TUNNEL — reach jivo-dbsap from ANY IP (added 2026-07-29, WORKING) ---
# We no longer depend on being on a whitelisted IP. The box holds an outbound
# self-healing reverse tunnel to the fleet VPS. Connect from anywhere:  ssh jivo-sap-any
#   path: Mac -> vps-pub -> VPS 127.0.0.1:47192 -> reverse tunnel -> jivo-dbsap:22
# Only port 22 is tunneled (HANA 30015 / Service Layer 50000 are NOT exposed).
# Box side:  ~superadmin/revtun/box-revtun.sh (keeper; cron @reboot + */5 watchdog);
#            dedicated key ~superadmin/.ssh/jivo_revtun (private stays on the box).
# VPS side:  box key authorized RESTRICTED in root ~/.ssh/authorized_keys:
#            restrict,port-forwarding,permitlisten="127.0.0.1:47192"
# Mac side:  ~/.ssh/config Host jivo-sap-any (ProxyJump vps-pub).
# The direct whitelisted path `ssh jivo-sap` still works too (unchanged).
# Full reproducible install/teardown + docs: connections/reverse-tunnel/
REVTUN_VPS_PORT=47192
REVTUN_CONNECT_ALIAS=jivo-sap-any

# --- SAP/HANA LINUX box (103.89.45.192) — OS / SSH login — added 2026-07-28 ---
# This box runs HANA (port 30015) + the SAP Service Layer (port 50000). Public IP.
# OS/SSH login (port 22) — DISTINCT from the HANA *database* login (user ZIA, kept in
# connections/hana.env). Provided by the owner from the accounts manager.
# STATUS: CREDENTIAL CONFIRMED VALID — screenshot 2026-07-29 shows `superadmin` logging
# into this box from a LAN Windows machine (C:\Users\mtpl_s):
#   ssh superadmin@20.20.45.192  ->  superadmin@jivo-dbsap:~>
# So the login WORKS. What's still pending is only OUR remote path: repeated failed SSH
# attempts with the wrong (ZIA) login tripped a fail2ban ban on our VPN IP 149.40.62.35,
# blocking all .192 ports (HANA had worked minutes earlier from the same IP). That ban
# is temporary; the credential itself is proven good.
# LESSON: use the correct creds on the FIRST try and install an SSH key immediately;
# do NOT retry failed passwords against .192 (each failure deepens the ban).
# CRUCIAL: this Mac reaches .192 THROUGH A VPN (interface utun5), so .192 sees us as
# the VPN exit IP 149.40.62.35 — NOT the office IP. That 149.40.62.35 is what got
# fail2ban-banned. To unban/whitelist, the IP is 149.40.62.35. Symptom of the ban:
# TCP connects on 22/30015/50000 but the app stream is RST ("connection reset by
# peer" on HANA; empty SSH banner). Alt path: disabling the VPN switches egress to the
# normal ISP IP (a clean, unbanned IP) — only works if .192 also allows that IP.
# Plan once unbanned: ssh in as superadmin, append our key
# (~/.ssh/jivo_accounts_box.pub) to authorized_keys, add a `jivo-sap` alias in
# ~/.ssh/config, then reach the Windows share 20.20.45.25 from this box (same LAN,
# creds above) to finally pull the invoice-attachment PDFs.
# The box hostname is `jivo-dbsap` (the SAP/HANA database box, Linux). It is dual-homed:
#   PUBLIC  103.89.45.192  <- how WE reach it remotely (firewalled / fail2ban-guarded)
#   INTERNAL 20.20.45.192  <- how LAN machines reach it (clean, no public firewall)
# (last octet .192 matches on both = same physical box.) The internal path is reachable
# from us only via the jivo Tailscale subnet route (20.20.45.0/24), which is currently
# offline; so remotely we use the public IP.
SAPLINUX_HOST=103.89.45.192
SAPLINUX_INTERNAL_IP=20.20.45.192
SAPLINUX_HOSTNAME=jivo-dbsap
SAPLINUX_SSH_PORT=22
SAPLINUX_SSH_USER=superadmin
SAPLINUX_SSH_PASS=Jivo!@#$2026
# Dedicated key already generated on the Mac Air for this box:
#   private: ~/.ssh/jivo_accounts_box   public: ~/.ssh/jivo_accounts_box.pub
#
