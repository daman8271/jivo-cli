# HANA via SSH tunnel through jivo-dbsap (rides port 22, immune to the 30015 firewall).
# Start tunnel:  ssh -f -N -o ExitOnForwardFailure=yes -L 13015:127.0.0.1:30015 jivo-sap
#   (ExitOnForwardFailure=yes so it FAILS loudly if 13015 is already taken, instead of
#    silently leaving you on a stale/other tunnel.)
# Then:          hana-sql -env connections/hana-tunnel.env "SELECT ... FROM DUMMY"
# GITIGNORED. Same ZIA DB login as hana.env, just pointed at the local tunnel port.
HANA_HOST=127.0.0.1
HANA_PORT=13015
HANA_USER=ZIA
HANA_PASSWORD=Jivo@4321
