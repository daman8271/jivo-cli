30:["$","p",null,{"className":"text-xs text-zinc-500 mt-3 leading-relaxed","children":["Every order the plan raises follows that same loop — a shortage the plan never orders against simply stays short."," ",["$","span",null,{"className":"text-zinc-300 tabular-nums","children":[39," of ",43]}]," ","order-chains land and unblock inside September — ",["$","span",null,{"className":"tabular-nums","children":32}]," ","of those see the freed SKU run again before month-end, ",["$","span",null,{"className":"tabular-nums","children":7}]," ","clear too late in the schedule to run — and ",["$","span",null,{"className":"tabular-nums","children":4}]," land only after 30 Sep. Leads run ",["$","span",null,{"className":"tabular-nums","children":[6,"–",11," days"]}]," (",6," ","d packaging, ",11," d oil — measured). Watch the chains land day by day on the"," ",["$","$L5",null,{"href":"/days","className":"text-amber-300 hover:underline","children":"day pages"}],". ",["$","span",null,{"title":"blocker → order → land → run, chained from sim/events-sep.json; waited_days is the sim's own counter","className":"inline-block align-middle text-[10px] font-semibold tracking-wider px-1.5 py-px rounded border bg-violet-500/15 text-violet-300 border-violet-500/30","children":"SIMULATED"}]]}]
