[Unit]
Description=Astha complete Factory supplier and material purchase-order discovery
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/mark4-astha/app
ExecStart=/usr/bin/python3 /root/mark4-astha/app/scripts/collect_material_supply.py --mode orders --config /root/.config/jivo-factory-pp-cli/config.toml --cache-dir /root/mark4-astha/private/material-supply --source-root /root/jivo-courier/jolly --interval 180
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/mark4-astha

[Install]
WantedBy=multi-user.target
