[Unit]
Description=Astha Factory stock, receipt, QC and EXIM material reconciliation
After=network-online.target mark4-astha-material-orders.service

[Service]
Type=simple
WorkingDirectory=/root/mark4-astha/app
ExecStart=/usr/bin/python3 /root/mark4-astha/app/scripts/collect_material_supply.py --mode materials --config /root/.config/jivo-factory-pp-cli/config.toml --cache-dir /root/mark4-astha/private/material-supply --source-root /root/jivo-courier/jolly --output /root/mark4-astha/state/material-supply.json --interval 60
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# The documented EXIM client refreshes its existing local authentication cache.
# This grants no business API write path.
ReadWritePaths=/root/mark4-astha /root/jivo-courier/exim/.secrets

[Install]
WantedBy=multi-user.target
