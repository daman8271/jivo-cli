1d:["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"text-[15px] leading-relaxed text-zinc-100","children":"Does GP-FG — Oil's own corner of the Gupta building — belong inside the space model with its own ceiling, or does it stay outside because the building is committed to Mart?"}],["$","div",null,{"className":"mt-2.5 rounded-lg border-l-2 border-emerald-500/50 bg-emerald-500/5 px-3 py-2","children":[["$","div",null,{"className":"text-[11px] uppercase tracking-wider text-emerald-400/80","children":"My guess"}],["$","div",null,{"className":"mt-0.5 text-sm text-zinc-300","children":"Give it a ceiling and keep it in. It is doing real work. Note its 226,320 L includes about 203,000 L of imported soyabean tins booked as semi-finished, which an earlier count filtered out — a tin of oil takes up floor whatever group it sits in."}]]}],"",["$","div",null,{"className":"mt-2.5 flex flex-wrap gap-x-5 gap-y-1 text-xs text-zinc-500","children":[["$","span",null,{"children":[["$","span",null,{"className":"text-zinc-600","children":"blocks:"}]," ","Giving GP-FG a ceiling, and deciding whether overflow from BH-BT/BH-PF may legitimately be planned into it."]}],"",""]}],""]}]
