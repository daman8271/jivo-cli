22:["$","div","13",{"className":"rounded-xl border border-zinc-800 bg-zinc-900/50 overflow-hidden","children":["$","div",null,{"className":"flex gap-3 p-4","children":[["$","div",null,{"className":"flex flex-col items-center gap-1.5 pt-0.5","children":[["$","span",null,{"className":"h-2 w-2 rounded-full bg-sky-500"}],["$","span",null,{"className":"text-xs tabular-nums text-zinc-500","children":13}]]}],["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"text-[15px] leading-relaxed text-zinc-100","children":"Should the day plan refuse to schedule a run whose bill of materials exceeds the packaging actually on hand, or only warn? Today three of the seven runs raised were short — canola 1,644 L available against 10,000 needed, and 3,735 SANO 5 L tins against 4,000."}],["$","div",null,{"className":"mt-2.5 rounded-lg border-l-2 border-emerald-500/50 bg-emerald-500/5 px-3 py-2","children":[["$","div",null,{"className":"text-[11px] uppercase tracking-wider text-emerald-400/80","children":"My guess"}],["$","div",null,{"className":"mt-0.5 text-sm text-zinc-300","children":"Warn loudly, do not refuse — the floor clearly starts runs short and finishes them, and a hard block would stop work the plant knows how to do."}]]}],["$","div",null,{"className":"mt-2 rounded-lg border-l-2 border-amber-500/60 bg-amber-500/5 px-3 py-2","children":[["$","div",null,{"className":"text-[11px] uppercase tracking-wider text-amber-400/80","children":"Changed since the rebuild"}],["$","div",null,{"className":"mt-0.5 text-sm text-amber-100/90","children":"v2 currently REFUSES to schedule short. Your answer flips it to warn-only."}]]}],["$","div",null,{"className":"mt-2.5 flex flex-wrap gap-x-5 gap-y-1 text-xs text-zinc-500","children":[["$","span",null,{"children":[["$","span",null,{"className":"text-zinc-600","children":"blocks:"}]," ","Whether the day plan the engine emits is actually schedulable or just arithmetic."]}],"",""]}],""]}]]}]}]
