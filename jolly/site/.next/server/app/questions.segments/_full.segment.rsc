24:["$","div","15",{"className":"rounded-xl border border-zinc-800 bg-zinc-900/50 overflow-hidden","children":["$","div",null,{"className":"flex gap-3 p-4","children":[["$","div",null,{"className":"flex flex-col items-center gap-1.5 pt-0.5","children":[["$","span",null,{"className":"h-2 w-2 rounded-full bg-sky-500"}],["$","span",null,{"className":"text-xs tabular-nums text-zinc-500","children":15}]]}],["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"text-[15px] leading-relaxed text-zinc-100","children":"Who is supposed to key the case counts into the production app during the shift, and does anyone check them? The segments add to 59,723 cases for August, the run headers say 88,139, and SAP says the plant made about 105,000."}],["$","div",null,{"className":"mt-2.5 rounded-lg border-l-2 border-emerald-500/50 bg-emerald-500/5 px-3 py-2","children":[["$","div",null,{"className":"text-[11px] uppercase tracking-wider text-emerald-400/80","children":"My guess"}],["$","div",null,{"className":"mt-0.5 text-sm text-zinc-300","children":"The operator keys them and nobody checks. Use the app for TIME and SAP for VOLUME — that combination reconciles, and the two on their own do not."}]]}],"",["$","div",null,{"className":"mt-2.5 flex flex-wrap gap-x-5 gap-y-1 text-xs text-zinc-500","children":[["$","span",null,{"children":[["$","span",null,{"className":"text-zinc-600","children":"blocks:"}]," ","Whether the factory app can ever be the production system of record, or stays a shift diary with SAP as the volume truth."]}],"",""]}],""]}]]}]}]
25:["$","div","16",{"className":"rounded-xl border border-zinc-800 bg-zinc-900/50 overflow-hidden","children":["$","div",null,{"className":"flex gap-3 p-4","children":[["$","div",null,{"className":"flex flex-col items-center gap-1.5 pt-0.5","children":[["$","span",null,{"className":"h-2 w-2 rounded-full bg-sky-500"}],["$","span",null,{"className":"text-xs tabular-nums text-zinc-500","children":16}]]}],["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"text-[15px] leading-relaxed text-zinc-100","children":"Would you have the dispatch team set the planned dispatch date a day or two ahead instead of on the day? The field, the priority flag and a 14-day board already exist and are empty beyond today."}],["$","div",null,{"className":"mt-2.5 rounded-lg border-l-2 border-emerald-500/50 bg-emerald-500/5 px-3 py-2","children":[["$","div",null,{"className":"text-[11px] uppercase tracking-wider text-emerald-400/80","children":"My guess"}],["$","div",null,{"className":"mt-0.5 text-sm text-zinc-300","children":"Yes, and it costs nothing — one field filled a day earlier. But it may be that the truck genuinely is not known until the morning, in which case there is nothing to fill in."}]]}],"",["$","div",null,{"className":"mt-2.5 flex flex-wrap gap-x-5 gap-y-1 text-xs text-zinc-500","children":[["$","span",null,{"children":[["$","span",null,{"className":"text-zinc-600","children":"blocks:"}]," ","Any forward space forecast. I can build the report the moment the data exists; I cannot invent the dates."]}],"",""]}],""]}]]}]}]
26:["$","div","17",{"className":"rounded-xl border border-zinc-800 bg-zinc-900/50 overflow-hidden","children":["$","div",null,{"className":"flex gap-3 p-4","children":[["$","div",null,{"className":"flex flex-col items-center gap-1.5 pt-0.5","children":[["$","span",null,{"className":"h-2 w-2 rounded-full bg-sky-500"}],["$","span",null,{"className":"text-xs tabular-nums text-zinc-500","children":17}]]}],["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"text-[15px] leading-relaxed text-zinc-100","children":"Do customer returns and branch stock transfers physically come through the same gate? The app has finished modules for both and neither has ever been used once, while SAP books 28 A/R returns, 6 vendor returns and 444 stock transfers in Oil in August alone."}],["$","div",null,{"className":"mt-2.5 rounded-lg border-l-2 border-emerald-500/50 bg-emerald-500/5 px-3 py-2","children":[["$","div",null,{"className":"text-[11px] uppercase tracking-wider text-emerald-400/80","children":"My guess"}],["$","div",null,{"className":"mt-0.5 text-sm text-zinc-300","children":"Same gate, recorded as an ordinary vehicle entry with no returns paperwork behind it. The volumes are small next to dispatch, so I would not chase it before the outbound side is fixed."}]]}],"",["$","div",null,{"className":"mt-2.5 flex flex-wrap gap-x-5 gap-y-1 text-xs text-zinc-500","children":[["$","span",null,{"children":[["$","span",null,{"className":"text-zinc-600","children":"blocks:"}]," ","Whether the free-space model needs an inbound-returns term as well as the outbound one."]}],"",""]}],""]}]]}]}]
27:["$","div","18",{"className":"rounded-xl border border-zinc-800 bg-zinc-900/50 overflow-hidden","children":["$","div",null,{"className":"flex gap-3 p-4","children":[["$","div",null,{"className":"flex flex-col items-center gap-1.5 pt-0.5","children":[["$","span",null,{"className":"h-2 w-2 rounded-full bg-sky-500"}],["$","span",null,{"className":"text-xs tabular-nums text-zinc-500","children":18}]]}],["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"text-[15px] leading-relaxed text-zinc-100","children":"Is the crude-out / cold-press-back job-work loop through BH-GJ weighed and recorded anywhere? The gate's job-work module has 14 records and every one has an empty SAP document, empty production order and empty item list."}],["$","div",null,{"className":"mt-2.5 rounded-lg border-l-2 border-emerald-500/50 bg-emerald-500/5 px-3 py-2","children":[["$","div",null,{"className":"text-[11px] uppercase tracking-wider text-emerald-400/80","children":"My guess"}],["$","div",null,{"className":"mt-0.5 text-sm text-zinc-300","children":"It is weighed at the job worker's end and comes back to us as a GRPO quantity we do not independently check. That is why the 3% refining loss can only be inferred from ratios, never measured."}]]}],"",["$","div",null,{"className":"mt-2.5 flex flex-wrap gap-x-5 gap-y-1 text-xs text-zinc-500","children":[["$","span",null,{"children":[["$","span",null,{"className":"text-zinc-600","children":"blocks:"}]," ","Closing the oil material balance."]}],"",""]}],""]}]]}]}]
