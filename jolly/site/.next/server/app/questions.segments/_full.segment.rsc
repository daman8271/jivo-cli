p-3 p-4","children":[["$","div",null,{"className":"flex flex-col items-center gap-1.5 pt-0.5","children":[["$","span",null,{"className":"h-2 w-2 rounded-full bg-sky-500"}],["$","span",null,{"className":"text-xs tabular-nums text-zinc-500","children":11}]]}],["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"text-[15px] leading-relaxed text-zinc-100","children":"Two things about the weighbridge, and they resolve together: when was it last calibrated and stamped — and should the received quantity follow OUR weighed net instead of the supplier's billed quantity?"}],["$","div",null,{"className":"mt-2.5 rounded-lg border-l-2 border-emerald-500/50 bg-emerald-500/5 px-3 py-2","children":[["$","div",null,{"className":"text-[11px] uppercase tracking-wider text-emerald-400/80","children":"My guess"}],["$","div",null,{"className":"mt-0.5 text-sm text-zinc-300","children":"The bridge is probably fine and the suppliers are probably short-loading slightly — the shortfall is too consistent across four different suppliers to be one scale drifting. But I would get the certificate before saying a word to anyone."}]]}],"",["$","div",null,{"className":"mt-2.5 flex flex-wrap gap-x-5 gap-y-1 text-xs text-zinc-500","children":[["$","span",null,{"children":[["$","span",null,{"className":"text-zinc-600","children":"blocks:"}]," ","Whether to raise this with AWL, Dhanlaxmi, Vaishnodevi and Arora at all. I will not call it a loss until the calibration certificate is seen."]}],"",""]}],""]}]]}]}],["$","div","12",{"className":"rounded-xl border border-zinc-800 bg-zinc-900/50 overflow-hidden","children":["$","div",null,{"className":"flex gap-3 p-4","children":[["$","div",null,{"className":"flex flex-col items-center gap-1.5 pt-0.5","children":[["$","span",null,{"className":"h-2 w-2 rounded-full bg-sky-500"}],["$","span",null,{"className":"text-xs tabular-nums text-zinc-500","children":12}]]}],["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"text-[15px] leading-relaxed text-zinc-100","children":"The 43.91 MT of imported pomace olive that came in on 17 August (truck RJ47GA8215, POs 220526015 and 220526016, Rs 1.00 Cr) — where is it physically now? Bhakharpur, Gujarat, or already out to job work?"}],"$L20","","$L21",""]}]]}]}],"$L22","$L23","$L24","$L25","$L26","$L27"]}]]}]
15:["$","section","low",{"className":"mt-8","children":[["$","div",null,{"className":"flex items-baseline justify-between mb-3","children":[["$","h2",null,{"className":"text-lg font-semibold","children":"Low"}],["$","span",null,{"className":"text-xs text-zinc-500","children":[4," question","s"]}]]}],["$","div",null,{"className":"space-y-3","children":[["$","div","19",{"className":"rounded-xl border border-zinc-800 bg-zinc-900/50 overflow-hidden","children":["$","div",null,{"className":"flex gap-3 p-4","children":[["$","div",null,{"className":"flex flex-col items-center gap-1.5 pt-0.5","children":[["$","span",null,{"className":"h-2 w-2 rounded-full bg-zinc-600"}],["$","span",null,{"className":"text-xs tabular-nums text-zinc-500","children":19}]]}],["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"text-[15px] leading-relaxed text-zinc-100","children":"Mart inbound never touches the gate app — zero of 346 SAP goods receipts in July and August, Rs 20.6 Cr in August. Different physical gate, or the app just is not used there?"}],["$","div",null,{"className":"mt-2.5 rounded-lg border-l-2 border-emerald-500/50 bg-emerald-500/5 px-3 py-2","children":[["$","div",null,{"className":"text-[11px] uppercase tracking-wider text-emerald-400/80","children":"My guess"}],["$","div",null,{"className":"mt-0.5 text-sm text-zinc-300","children":"Same gate, app not used — Mart's receipts are keyed straight into SAP by their own team."}]]}],"",["$","div",null,{"className":"mt-2.5 flex flex-wrap gap-x-5 gap-y-1 text-xs text-zinc-500","children":[["$","span",null,{"children":[["$","span",null,{"className":"text-zinc-600","children":"blocks:"}]," ","Whether any of the inbound half of this study can be extended to Mart."]}],"",""]}],""]}]]}]}],["$","div","20",{"className":"rounded-xl border border-zinc-800 bg-zinc-900/50 overflow-hidden","children":["$","div",null,{"className":"flex gap-3 p-4","children":[["$","div",null,{"className":"flex flex-col items-center gap-1.5 pt-0.5","children":[["$","span",null,{"className":"h-2 w-2 rounded-full bg-zinc-600"}],["$","span",null,{"className":"text-xs tabular-nums text-zinc-500","children":20}]]}],["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"text-[15px] leading-relaxed text-zinc-100","children":"The line-clearance checklist has never once been answered NO — 216 clearances, 1,944 checkpoint answers, not a single failure — and 21 of the 47-minute changeover is spent waiting for QA to sign it. Is QA on the floor or called across?"}],["$","div",null,{"className":"mt-2.5 rounded-lg border-l-2 border-emerald-500/50 bg-emerald-500/5 px-3 py-2","children":[["$","div",null,{"className":"text-[11px] uppercase tracking-wider text-emerald-400/80","children":"My guess"}],["$","div",null,{"className":"mt-0.5 text-sm text-zinc-300","children":"QA is called across rather than standing on the line, and the checklist is a formality nobody fails. I would keep the checklist and move QA closer."}]]}],"",["$","div",null,{"className":"mt-2.5 flex flex-wrap gap-x-5 gap-y-1 text-xs text-zinc-500","children":[["$","span",null,{"children":[["$","span",null,{"className":"text-zinc-600","children":"blocks:"}]," ","Whether the scheduler should batch SKUs to dodge changeovers (worth about 12 hours of line time in August) or ignore them."]}],"",""]}],""]}]]}]}],["$","div","21",{"className":"rounded-xl border border-zinc-800 bg-zinc-900/50 overflow-hidden","children":["$","div",null,{"className":"flex gap-3 p-4","children":[["$","div",null,{"className":"flex flex-col items-center gap-1.5 pt-0.5","children":[["$","span",null,{"className":"h-2 w-2 rounded-full bg-zinc-600"}],["$","span",null,{"className":"text-xs tabular-nums text-zinc-500","children":21}]]}],["$","div",null,{"className":"min-w-0 flex-1","children":[["$","p",null,{"className":"text-[15px] leading-relaxed text-zinc-100","children":"Nobody has ever signed a waste approval — 517 logs, four signature slots each, zero signatures since May. Is that chain meant to be used, or is it paperwork the app came with?"}],"$L28","","$L29",""]}]]}]}],"$L2a"]}]]}]
