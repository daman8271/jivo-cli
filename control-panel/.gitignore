# secrets & session state
.env
credentials.md
recon/cookies.txt
recon/*.txt
# raw scrape dumps (large; regenerable)
recon/pages/
recon/apiprobe/
recon/samples/
*.log
# CLI build junk
cli/**/node_modules/
cli/**/dist/
