#!/usr/bin/env python3
"""Grant: sap-credentials — put a named SAP login onto a box so it can write.

Daman authorised Sardar to MOVE credentials on 2026-08-22. This is the grant
that does it, and it is the thing that actually unblocks an operator: everything
else can be perfect and they still cannot create a document without a working
SAP login on their machine.

THE ONE RULE HERE: move, never show.

The credential value is read from the store, written to the box, and never
printed — not into the reply, not into the audit log, not into the tmux pane, not
into a finding. Sardar reads untrusted operator text, so a credential that
reaches his output is a credential that can be talked out of him. Moving one
unblocks an operator; displaying one just leaks it. Everything this script
reports is a NAME (USER01), a length, or a yes/no.

ATTRIBUTION IS THE POINT. Each SAP user belongs to a person — USER01 is AVTAR
SINGH, USER06 is LOVPREET SINGH, USER36 is NAVDEEP SINGH, USER07 is NEETU. Every
write lands in JIVO's shared log under that name, so putting the wrong one on a
box silently attributes one person's work to another. This grant therefore
refuses to place a credential whose owner does not match the box's operator
unless policy.json says so explicitly.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import (  # noqa: E402
    ALIAS, APPLY, BOX, DEAD_SAP_HOST, KIT, NOT_FOUND_RE, OPERATOR, READONLY_SAP_USERS,
    Report, SSH_CONFIG, WINDOWS, j, prove_write_path, q, require_reachable,
    run_in, ssh,
)

ROOT = os.environ.get("SUMMON_ROOT", "/opt/jivo-summon")
STORE = os.path.join(ROOT, "credentials")
POLICY = os.path.join(ROOT, "policy.json")
TS = time.strftime("%Y%m%d-%H%M%S")

# Which SAP user this box should log in as. policy.json is the roster of record.
WANT = os.environ.get("SAP_USER", "").strip()

rep = Report("sap-credentials", BOX)


def load_policy() -> dict:
    try:
        return json.loads(open(POLICY, encoding="utf-8").read())
    except (OSError, json.JSONDecodeError):
        return {}


if not WANT:
    rep.blocked(
        f"policy.json does not say which SAP user {BOX} should log in as "
        f"(sap_user is empty), so there is nothing to place. Each SAP user "
        f"belongs to a named person and every write is logged under that name — "
        f"guessing one would attribute this operator's work to somebody else. "
        f"Daman sets this field."
    )
    sys.exit(rep.emit())

if WANT.lower() in READONLY_SAP_USERS:
    rep.blocked(
        f"policy.json asks for '{WANT}' on {BOX}, but that account is read-only "
        f"at JIVO — placing it would leave the operator exactly as stuck, with a "
        f"login that works and writes that fail. It needs a named user."
    )
    sys.exit(rep.emit())

src = os.path.join(STORE, f"{WANT}.env")
if not os.path.isfile(src):
    have = sorted(
        f[:-4] for f in os.listdir(STORE) if f.endswith(".env")
    ) if os.path.isdir(STORE) else []
    rep.note("store", False, f"no credential set for {WANT}")
    rep.blocked(
        f"There is no credential set for {WANT} in the store, so it cannot be "
        f"placed on {BOX}. The store currently holds: "
        f"{', '.join(have) if have else 'nothing'}. Adding one is Daman's step — "
        f"he scp's it to {STORE}/<USER>.env. I do not invent credentials."
    )
    sys.exit(rep.emit())

# Read the set. From here on the VALUES never leave this process except by being
# written to the target box.
try:
    body = open(src, encoding="utf-8").read()
except OSError as exc:
    rep.blocked(f"could not read the credential set for {WANT}: {exc}")
    sys.exit(rep.emit())

def field(name: str) -> str:
    m = re.search(rf"^{name}\s*=\s*[\"']?([^\"'\r\n]*)", body, re.M)
    return (m.group(1) or "").strip() if m else ""

got_user = field("SAPB1_USER")
host = field("SAPB1_HOST")
company = field("SAPB1_COMPANYDB")
pw_len = len(field("SAPB1_PASSWORD"))

# Report shape only — never the secret.
rep.note("credential_set", True,
         f"{WANT}: user={got_user} host={host} company={company} "
         f"password={pw_len} chars (value never printed)")

if got_user.upper() != WANT.upper():
    rep.blocked(
        f"the credential set named {WANT}.env actually logs in as "
        f"'{got_user}'. Refusing to place it: the filename is what policy.json "
        f"matches on, so a mismatch means somebody's writes would be logged "
        f"under the wrong name. A human should fix the store."
    )
    sys.exit(rep.emit())

if host == DEAD_SAP_HOST:
    rep.blocked(
        f"the {WANT} credential set still points at {DEAD_SAP_HOST}, the "
        f"decommissioned SAP host — placing it would just move the 502 onto "
        f"{BOX}. The store needs the current host."
    )
    sys.exit(rep.emit())

# --- attribution check ------------------------------------------------------
# Every SAP write lands in JIVO's shared log under the SAP user's name. Placing
# one person's account on another person's box silently misattributes their work,
# and it is invisible afterwards. This has already happened once on this fleet.
pol = load_policy()
owners = pol.get("sap_user_owners", {})
owner = (owners.get(WANT) or owners.get(WANT.upper()) or "").strip()
box_op = (OPERATOR or pol.get("boxes", {}).get(BOX, {}).get("operator", "")).strip()
if owner and box_op and owner.lower() != box_op.lower():
    allowed = pol.get("boxes", {}).get(BOX, {}).get("shared_sap_user_ok", False)
    rep.note("attribution", False, f"{WANT} belongs to {owner}, box operator is {box_op}")
    if not allowed:
        rep.blocked(
            f"{WANT} is {owner}'s SAP account, but {BOX} belongs to {box_op}. "
            f"Every SAP write is logged under the SAP user's name, so placing "
            f"this would file {box_op}'s work under {owner} — wrong, and "
            f"invisible once it has happened. Either give {box_op} their own SAP "
            f"user, or set shared_sap_user_ok on this box if that really is "
            f"intended."
        )
        sys.exit(rep.emit())
    rep.did(f"NOTE: {BOX} is deliberately sharing {owner}'s SAP user {WANT} "
            f"(shared_sap_user_ok is set) — its writes will be logged as {owner}.")
else:
    rep.note("attribution", True,
             f"{WANT} matches this box's operator" if owner else
             f"no recorded owner for {WANT}; nothing to contradict")

if not require_reachable(rep):
    sys.exit(rep.emit())

# Where sapb1 reads its .env: the directory the binary sits in.
exe_dir = j(KIT, "sap-b1", "accounts-kit") if WINDOWS else j(KIT, "sap-b1", "cli")
exe = j(exe_dir, "sapb1.exe" if WINDOWS else "sapb1")
chk = (f"if exist {exe} (echo YES) else (echo NO)" if WINDOWS
       else f"test -x {q(exe)} && echo YES || echo NO")
rc, out = ssh(chk)
if "YES" not in out or "NO" in out:
    rep.note("sapb1", False, f"no sapb1 at {exe}")
    rep.blocked(
        f"{BOX} has no sapb1 binary at {exe}, so there is nowhere for a "
        f"credential to be useful yet. Sync the kit first."
    )
    sys.exit(rep.emit())
rep.note("sapb1", True, exe)

target = j(exe_dir, ".env")

if not APPLY:
    rep.note("plan", None,
             f"would place the {WANT} credential set at {target} "
             f"(backing up any existing .env), then verify with `sapb1 doctor`")
    sys.exit(rep.emit(message_ok=f"{BOX}: ready to receive the {WANT} SAP login."))

# Back up whatever is there first. It may be the only copy of something.
if WINDOWS:
    prep = f"if exist {target} copy /y {target} {target}.bak-{TS}"
else:
    prep = f"[ -f {q(target)} ] && cp {q(target)} {q(target)}.bak-{TS} || true"
rc, out = ssh(prep)
rep.note("backup", rc == 0, out.strip()[-140:] or "backed up any existing .env")

# Write it over stdin: no plaintext temp file on either side, and the value never
# appears in a command line (where `ps` would expose it to any local user).
remote = (f'cmd /c "more > {target}"' if WINDOWS
          else f"cat > {q(target)} && chmod 600 {q(target)}")
try:
    cp = subprocess.run(
        ["ssh", "-F", SSH_CONFIG, "-o", "ConnectTimeout=12", "-o", "BatchMode=yes",
         ALIAS, remote],
        input=body, capture_output=True, text=True, timeout=90, check=False,
    )
    placed = cp.returncode == 0
    # Never surface stderr verbatim here — on a bad day it can echo the input.
    rep.note("place", placed,
             f"wrote the {WANT} credential set to {target}" if placed
             else f"ssh exited {cp.returncode} while writing the credential")
except subprocess.TimeoutExpired:
    placed = False
    rep.note("place", False, "timed out writing the credential")

if not placed:
    rep.blocked(f"could not write the {WANT} credential set to {BOX}.")
    sys.exit(rep.emit())

rep.did(f"placed the {WANT} SAP login on {BOX} (owner: {owner or 'unrecorded'})")

# Lock it down. An .env with a live SAP password should not be world-readable.
if WINDOWS:
    ssh(f"icacls {target} /inheritance:r /grant:r Administrators:F >nul 2>&1")
else:
    ssh(f"chmod 600 {q(target)}")

# --- prove it, without ever printing the secret -----------------------------
rc, out = run_in(exe_dir, "sapb1.exe doctor" if WINDOWS else "./sapb1 doctor",
                 timeout=180)
# doctor masks the password itself, but be defensive: report only the verdict.
if re.search(r"^\s*[✓v]\s*login", out, re.M) or "connected to" in out:
    m = re.search(r"connected to (\S+) as (\S+)", out)
    rep.note("login", True,
             f"logged in to {m.group(1)} as {m.group(2)}" if m else "login OK")
    rep.did(f"verified: {BOX} can now log in to SAP as {WANT}")
else:
    reason = ""
    m = re.search(r"login to .* failed: (.*)", out)
    if m:
        reason = m.group(1).strip()[:160]
    rep.note("login", False, reason or "login did not succeed")
    rep.blocked(
        f"the {WANT} credential set is now on {BOX} but the login failed"
        + (f": {reason}" if reason else "") +
        ". Most often the password in the store has been rotated in SAP since it "
        "was captured, or this box cannot reach the SAP host from its network. "
        "Nothing was leaked — the value was written, not shown."
    )

# The write path itself. --dry-run contacts SAP not at all.
if not rep.blockers:
    if not prove_write_path(rep, exe_dir):
        rep.blocked(
            f"{BOX} logs in to SAP as {WANT} now, but `sapb1 draft --dry-run` "
            f"still fails. That is no longer a credential problem — look at the "
            f"branch/series or the kit version."
        )

sys.exit(rep.emit(
    message_ok=(f"{BOX} is logged in to SAP as {WANT} and the write path is open. "
                f"Documents created there will be logged under "
                f"{owner or WANT}."),
    message_bad=f"{WANT} was placed on {BOX} but it is not working yet.",
))
