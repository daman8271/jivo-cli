{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jivo.local/schemas/product-identity-release-attestation.v1.schema.json",
  "title": "JIVO Product Identity Release Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "contract_name",
    "dataset_version",
    "schema_version",
    "release_status",
    "map",
    "evidence_artifacts",
    "verification"
  ],
  "properties": {
    "format_version": {"const": "1.0.0"},
    "contract_name": {"const": "jivo-product-identity-release-attestation"},
    "dataset_version": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"},
    "release_status": {"const": "released"},
    "map": {"$ref": "#/$defs/artifact"},
    "evidence_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidenceArtifact"}
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier_version", "check_count"],
      "properties": {
        "verifier_version": {"type": "string", "minLength": 1},
        "check_count": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "relativeUri": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"$ref": "#/$defs/relativeUri"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "uri", "sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "uri": {"$ref": "#/$defs/relativeUri"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
