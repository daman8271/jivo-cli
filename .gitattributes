# The question log is append-only from many operators at once. Union merge
# keeps every line from both sides instead of raising a conflict nobody in
# Accounts should ever have to resolve by hand.
harness/questions/log.jsonl merge=union

# The corrections digest is generated (harness/bin/harness.py build). On a
# conflict, rebuild it rather than hand-merging.
harness/corrections/INDEX.md merge=union
