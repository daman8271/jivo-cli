# credentials — NEVER commit
.env

# OS noise
.DS_Store

# gstack tool state (contains a live terminal token)
.gstack/

# tunnel/share access files
*.env
.env*
*.local.md

# Credential files copied aside during a migration or edit are STILL live
# credentials, and this repo is public. Neither rule above catches them:
# `*.env` needs the name to END in .env and `.env*` needs it to START with
# .env, so `hana.env.pre-migration-2026-08-17.bak` slipped past both and sat
# untracked-but-committable on 2026-08-17. Match the .env anywhere in the name.
*.env.*
*.env-*

# live session tokens — NEVER commit
*.token
.token
token.json
session.json

# ── harness ──────────────────────────────────────────────────────────
# Personal Claude Code settings. The SHARED harness hooks live in
# .claude/settings.json, which IS tracked — that is what makes the
# self-learning layer work on clone with no setup.
.claude/settings.local.json
.claude/worktrees/

# Per-machine harness state: turn counters and this operator's role tag.
# Never shared — each person has their own.
harness/.state/
harness/.persona

# This operator's registered identity (name + department), written by setup.py
# and stamped onto every report they produce. Per-machine, never shared.
harness/.operator

# NOTE: per-operator session logs are TRACKED, not ignored. Every operator
# commits their own `chats/<name>/` and `queries/<name>/` subfolder straight to
# `main` — one shared journal, no branches. This means every operator can read
# every other operator's logs after a pull; that is a deliberate accepted
# trade, not an oversight.

# Salted hash of the override password. Per-machine and never the plaintext,
# but there is no reason for one operator's hash to travel to another.
harness/guard.hash
__pycache__/
*.pyc

# Question/query logs: appended on EVERY prompt and tool call. Tracking them
# made every operator's worktree permanently dirty, which aborts `git pull` —
# breaking the very distribution the harness exists for. They also carried
# verbatim question text into a shared repo. Local-only; share via an
# aggregated export, never a live-appended tracked file.
harness/questions/log.jsonl
harness/questions/queries.jsonl

# built fleet installers embed the registrar PRIVATE key - never commit them
connections/fleet/JIVO-VPS-TUNNEL.cmd
connections/fleet/*.built.cmd
connections/fleet/JIVO-VPS-TUNNEL-MAC.command

# Obsidian workspace state — local editor noise
.obsidian/

# TankhaPay (HR/payroll) — removed from the repo 2026-07-31, kept local only
portals/tankhapay/
tankhapay/

# one-shot handoff briefings — self-deleting, never committed
HANDOFF-*.md

# Linux deploy artifacts. mcp-gateway/bin/ is a local STAGING area: the deploy
# scripts build from source and scp the result to the VPS, so these are rebuilt
# output, not source. Committing them put ~117 MB of binaries into a PUBLIC
# repo's permanent history and made every office clone pay for them forever.
# The Windows .exe files ARE tracked, deliberately — office PCs run those
# directly from a pull, and there is no build step on those machines.
mcp-gateway/bin/*.linux-amd64
jsap-mcp/dist/
distribution/server/*.linux-amd64

# acc: real paperwork / payloads never leave the machine (repo is public)
acc/_samples/

# summon agent: the live fleet roster (hostnames, kit paths, operator names, SAP
# usernames). Deployed to /opt/jivo-summon/policy.json by scp, never committed —
# this repo is public. summon/agent/policy.example.json is the shape.
summon/agent/policy.json

# summon: the SAP credential store. Lives ONLY at /opt/jivo-summon/credentials/
# on the VPS (0600, root-only). Never committed — this repo is public.
summon/credentials/
