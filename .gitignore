# credentials — NEVER commit
.env

# OS noise
.DS_Store

# gstack tool state (contains a live terminal token)
.gstack/

# tunnel/share access files
*.env
.env*
*.local.md

# live session tokens — NEVER commit
*.token
.token
token.json
session.json

# ── harness ──────────────────────────────────────────────────────────
# Personal Claude Code settings. The SHARED harness hooks live in
# .claude/settings.json, which IS tracked — that is what makes the
# self-learning layer work on clone with no setup.
.claude/settings.local.json
.claude/worktrees/

# Per-machine harness state: turn counters and this operator's role tag.
# Never shared — each person has their own.
harness/.state/
harness/.persona

# This operator's registered identity (name + department), written by setup.py
# and stamped onto every report they produce. Per-machine, never shared.
harness/.operator

# NOTE: per-operator session logs are TRACKED, not ignored. Every operator
# commits their own `chats/<name>/` and `queries/<name>/` subfolder straight to
# `main` — one shared journal, no branches. This means every operator can read
# every other operator's logs after a pull; that is a deliberate accepted
# trade, not an oversight.

# Salted hash of the override password. Per-machine and never the plaintext,
# but there is no reason for one operator's hash to travel to another.
harness/guard.hash
__pycache__/
*.pyc

# Question/query logs: appended on EVERY prompt and tool call. Tracking them
# made every operator's worktree permanently dirty, which aborts `git pull` —
# breaking the very distribution the harness exists for. They also carried
# verbatim question text into a shared repo. Local-only; share via an
# aggregated export, never a live-appended tracked file.
harness/questions/log.jsonl
harness/questions/queries.jsonl

# built fleet installers embed the registrar PRIVATE key - never commit them
connections/fleet/JIVO-VPS-TUNNEL.cmd
connections/fleet/*.built.cmd
connections/fleet/JIVO-VPS-TUNNEL-MAC.command

# Obsidian workspace state — local editor noise
.obsidian/
