# Copy to .env next to this file. Never commit .env.

# Anthropic API key with billing enabled.
# NOTE: this is NOT your Claude Code / Max subscription. It is a separate
# per-token API key from console.anthropic.com. Without it the app runs but
# cannot answer anything.
ANTHROPIC_API_KEY=sk-ant-...

# The read-only JIVO MCP gateway (mcp-gateway/). All eight backends behind one
# endpoint. On the VPS this is usually loopback; from the Mac, tunnel it:
#   ssh -N -L 7700:127.0.0.1:7700 vps
JIVO_GATEWAY_URL=http://127.0.0.1:7700/mcp

# Model. Opus 5 unless you have a reason.
JIVO_CHAT_MODEL=claude-opus-5
JIVO_CHAT_EFFORT=high

# Cookie signing secret. Generate once: python3 -c "import secrets;print(secrets.token_hex(32))"
JIVO_CHAT_SECRET=change-me

# Where the SQLite file lives.
JIVO_CHAT_DB=./jivo-chat.db

# Hard ceiling on Claude spend per user per day, in rupees. 0 = no cap.
JIVO_CHAT_DAILY_CAP_INR=200
