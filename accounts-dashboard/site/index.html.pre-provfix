<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>JIVO Accounts Board</title>
<meta name="color-scheme" content="dark light">
<script>
/* Resolve the theme BEFORE first paint, so a dark reader never gets a white
   flash. Dark is the default; the toggle writes the override to localStorage. */
(function(){var t;try{t=localStorage.getItem('jivo-theme')}catch(e){}
 document.documentElement.setAttribute('data-theme',t==='light'?'light':'dark')})();
</script>
<style>
/* ── JIVO daylight ────────────────────────────────────────────────────────
   Same light language as the godown board (jivo.in brand). Light-only, on
   purpose: this is read in office daylight, on a phone, by Accounts.        */
:root{
  --brand:#0A7D3F; --brand-deep:#1F3524; --ink:#22301F;
  --sage:#586055;  --soft:#8B9184;
  --cream:#F5F4EF; --card:#FFFFFF; --card-warm:#FAF9F4;
  --line:#E4E2D6;  --line-soft:#ECEAE0;

  /* categorical — fixed order, never cycled. Validated: lightness band,
     chroma floor, CVD separation, normal-vision floor, contrast. All pass. */
  --c1:#0A7D3F; --c2:#1D63C4; --c3:#C2610A; --c4:#8B2E9E; --c5:#0894B0; --c6:#B01253;

  /* ageing severity — sequential, one warm hue, monotonic light→dark.
     'not due' is a STATUS (brand green), not a step of the ramp.
     The two lightest steps sit under 3:1 on cream, so every ageing mark
     carries a visible value label and a table view. */
  --age-nd:#0A7D3F;
  --age1:#D99A4E; --age2:#C97F2E; --age3:#B5651B;
  --age4:#9A4D12; --age5:#7D370D; --age6:#5A2108;

  /* status — reserved, never reused as "series 7". Always word + colour. */
  --ok:#0A7D3F; --warn:#935800; --bad:#B3261E; --info:#1D5F8A; --dead:#7D786C;

  --radius:14px;
  --shadow:0 1px 2px rgba(31,53,36,.05), 0 8px 24px -12px rgba(31,53,36,.14);

  /* live-dot glow, tokenised so the dark theme can re-tint it */
  --pulse:rgba(10,125,63,.45); --pulse-0:rgba(10,125,63,0);
}
*{box-sizing:border-box;min-width:0}
html,body{margin:0;padding:0}
body{
  background:var(--cream); color:var(--ink);
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  font-size:15px; line-height:1.5;
  -webkit-font-smoothing:antialiased;
  font-variant-numeric:tabular-nums;
  padding-bottom:96px;
}
h1,h2,h3{margin:0;font-weight:650;letter-spacing:-.01em;color:var(--brand-deep)}
a{color:var(--brand)}
.wrap{max-width:1280px;margin:0 auto;padding:0 20px}

/* ── masthead ─────────────────────────────────────────────────────────── */
.mast{padding:26px 0 18px}
.mast-top{display:flex;flex-wrap:wrap;gap:16px;align-items:flex-end;justify-content:space-between}
.brandmark{font-size:26px;font-weight:800;letter-spacing:.02em;color:var(--brand)}
.brandmark span{color:var(--brand-deep);font-weight:650;letter-spacing:-.01em}
.stamp{font-size:13px;color:var(--sage);text-align:right}
.stamp b{color:var(--ink);font-weight:600}

/* controls row: company switcher + theme toggle sit on one line */
.ctrls{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:14px}

/* segmented company switcher */
.seg{display:inline-flex;background:var(--card);border:1px solid var(--line);
     border-radius:999px;padding:3px;gap:2px;flex-wrap:wrap}
.seg button{
  appearance:none;border:0;background:transparent;cursor:pointer;
  font:inherit;font-size:13.5px;font-weight:600;color:var(--sage);
  padding:7px 15px;border-radius:999px;transition:background .15s,color .15s;
}
.seg button:hover{background:var(--card-warm);color:var(--ink)}
.seg button[aria-pressed=true]{background:var(--brand);color:#fff}
.seg button:focus-visible{outline:2px solid var(--brand);outline-offset:2px}

/* theme toggle — same pill language as the switcher, never the loud thing */
.themetog{
  appearance:none;cursor:pointer;font:inherit;font-size:12.5px;font-weight:600;
  display:inline-flex;align-items:center;gap:6px;white-space:nowrap;
  background:var(--card);border:1px solid var(--line);color:var(--sage);
  border-radius:999px;padding:8px 14px;
  transition:background .15s,color .15s,border-color .15s;
}
.themetog:hover{border-color:var(--brand);color:var(--brand);background:var(--card-warm)}
.themetog:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
.themetog .ic{font-size:13px;line-height:1}

/* ── hero KPI strip ───────────────────────────────────────────────────── */
/* Explicit 4-up: eight figures land as two clean rows instead of an auto-fit
   6 + 2 with an orphan gap on the end. */
.kpis{display:grid;gap:12px;margin:20px 0 8px;grid-template-columns:repeat(4,1fr)}
@media (max-width:1000px){.kpis{grid-template-columns:repeat(3,1fr)}}
.kpi{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
     padding:15px 17px;box-shadow:var(--shadow)}
.kpi .lab{font-size:11.5px;font-weight:650;letter-spacing:.06em;text-transform:uppercase;color:var(--soft)}
.kpi .val{font-size:27px;font-weight:700;letter-spacing:-.02em;margin:5px 0 2px;color:var(--brand-deep)}
.kpi .sub{font-size:12.5px;color:var(--sage)}
.kpi.is-bad .val{color:var(--bad)} .kpi.is-warn .val{color:var(--warn)}
/* the figure SAP reports, struck through, beside the one that is true */
.kpi .sub s{color:var(--bad);text-decoration-thickness:1px;text-underline-offset:2px}

/* ── sticky section nav ───────────────────────────────────────────────── */
.navbar{position:sticky;top:0;z-index:20;background:rgba(245,244,239,.93);
        backdrop-filter:blur(8px);border-bottom:1px solid var(--line);margin-top:16px}
/* right pad keeps the last pill clear of the fixed corner badge */
.navrow{display:flex;gap:6px;overflow-x:auto;padding:10px 130px 10px 0;scrollbar-width:thin}
.navrow a{
  flex:0 0 auto;font-size:12.5px;font-weight:600;text-decoration:none;
  color:var(--sage);background:var(--card);border:1px solid var(--line);
  padding:6px 12px;border-radius:999px;white-space:nowrap;transition:.15s
}
.navrow a:hover{border-color:var(--brand);color:var(--brand)}

/* ── section cards ────────────────────────────────────────────────────── */
section.card{
  background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
  box-shadow:var(--shadow);margin:18px 0;padding:20px 22px;scroll-margin-top:64px
}
.card-head{display:flex;flex-wrap:wrap;gap:10px;align-items:baseline;justify-content:space-between;margin-bottom:4px}
.card-head h2{font-size:18px}
.card-head .src{font-size:11.5px;color:var(--soft);font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.blurb{font-size:13.5px;color:var(--sage);margin:2px 0 16px;max-width:78ch}
.minikpis{display:grid;gap:10px;margin-bottom:16px;
          grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}
.mk{background:var(--card-warm);border:1px solid var(--line-soft);border-radius:10px;padding:11px 13px}
.mk .lab{font-size:10.5px;font-weight:650;letter-spacing:.05em;text-transform:uppercase;color:var(--soft)}
.mk .val{font-size:19px;font-weight:700;color:var(--brand-deep);margin-top:3px;letter-spacing:-.01em}
.mk .val.bad{color:var(--bad)} .mk .val.warn{color:var(--warn)} .mk .val.ok{color:var(--ok)}

/* ── charts ───────────────────────────────────────────────────────────── */
.chart{margin:6px 0 18px}
.chart-title{font-size:12.5px;font-weight:650;color:var(--sage);margin-bottom:10px}
.legend{display:flex;flex-wrap:wrap;gap:12px;margin:10px 0 0;font-size:12px;color:var(--sage)}
.legend i{display:inline-block;width:11px;height:11px;border-radius:3px;margin-right:5px;vertical-align:-1px}
/* horizontal bars: 2px surface gap between fills, 4px rounded data end */
.hbar{display:grid;grid-template-columns:minmax(90px,190px) 1fr auto;gap:10px;
      align-items:center;margin-bottom:7px;font-size:13px}
.hbar .nm{color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hbar .tr{background:var(--line-soft);border-radius:5px;height:15px;overflow:hidden;display:flex}
.hbar .fl{height:100%;border-radius:0 4px 4px 0;box-shadow:0 0 0 1px var(--card) inset}
.hbar .vl{color:var(--brand-deep);font-weight:650;font-size:12.5px;white-space:nowrap}
/* stacked ageing bar */
.stack{display:flex;height:26px;border-radius:6px;overflow:hidden;background:var(--line-soft)}
.stack div{height:100%;box-shadow:1px 0 0 var(--card)}
.stack div:last-child{box-shadow:none}

/* ── tables ───────────────────────────────────────────────────────────── */
.tscroll{overflow:auto;max-height:420px;border:1px solid var(--line-soft);border-radius:10px}
.tscroll.tall{max-height:560px}
table{border-collapse:separate;border-spacing:0;width:100%;font-size:13px}
thead th{
  position:sticky;top:0;z-index:1;background:var(--card);
  text-align:left;font-weight:650;font-size:11.5px;letter-spacing:.04em;
  text-transform:uppercase;color:var(--soft);padding:9px 11px;
  border-bottom:1px solid var(--line);white-space:nowrap;cursor:pointer;user-select:none
}
thead th:hover{color:var(--brand)}
thead th .ar{opacity:.45;font-size:9px;margin-left:3px}
tbody td{padding:8px 11px;border-bottom:1px solid var(--line-soft);white-space:nowrap}
tbody tr{content-visibility:auto;contain-intrinsic-size:34px}
tbody tr:hover{background:var(--card-warm)}
td.num{text-align:right;font-variant-numeric:tabular-nums}
td.neg{color:var(--bad)}
td.nm{white-space:normal;min-width:180px;max-width:340px}
.pill{display:inline-block;font-size:11px;font-weight:650;padding:2px 8px;border-radius:999px;
      border:1px solid transparent;white-space:nowrap}
.pill.ok{background:#E8F3EC;color:#0A5C2F;border-color:#CFE6D8}
.pill.warn{background:#FBF0DC;color:#6E4200;border-color:#EFDFC0}
.pill.bad{background:#FBE9E7;color:#8C1D17;border-color:#F0CFCB}
.pill.dead{background:#EFEEE9;color:#5C5850;border-color:#E0DED5}
.pill.info{background:#E4EFF6;color:#154B6E;border-color:#CCE0EC}
.tnote{font-size:12px;color:var(--soft);margin-top:8px;max-width:80ch;line-height:1.5}
.tnote b{color:var(--sage)}

/* ── states ───────────────────────────────────────────────────────────── */
.empty{padding:26px;text-align:center;color:var(--soft);font-size:13.5px;
       background:var(--card-warm);border:1px dashed var(--line);border-radius:10px}
.err{padding:14px 16px;background:#FBE9E7;border:1px solid #F0CFCB;border-radius:10px;
     color:#8C1D17;font-size:13px;margin-bottom:12px}
.err b{display:block;margin-bottom:3px}
.caveat{background:#FBF0DC;border:1px solid #EFDFC0;border-radius:10px;padding:12px 14px;
        font-size:13px;color:#6E4200;margin:0 0 16px;line-height:1.55}
.caveat b{color:#4E2F00}
.caveat s{color:var(--bad)}

/* live indicator — the board refreshes itself, so say so */
.live{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--sage)}
.live i{width:7px;height:7px;border-radius:50%;background:var(--brand);
        box-shadow:0 0 0 0 var(--pulse);animation:pulse 2.4s ease-out infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 var(--pulse)}
                 70%{box-shadow:0 0 0 7px var(--pulse-0)}
                 100%{box-shadow:0 0 0 0 var(--pulse-0)}}

footer{margin:34px 0 0;padding:22px 0 10px;border-top:1px solid var(--line);
       font-size:12.5px;color:var(--soft)}
footer h3{font-size:13px;color:var(--sage);margin-bottom:8px}
footer code{background:var(--card);border:1px solid var(--line-soft);border-radius:4px;padding:1px 5px;font-size:11.5px}
.lineage{display:grid;gap:6px 18px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));margin-bottom:14px}

/* ── mobile ───────────────────────────────────────────────────────────────
   This is read on a phone at a desk in the office, so the phone layout is not
   a shrunk desktop. Four things actually matter:
     1. the hero goes 2-up, not 1-up — eight stacked cards is a lot of thumb
        before you reach any content;
     2. the first column of every table STICKS while you scroll sideways, so a
        row of numbers never loses the party name it belongs to;
     3. bars put the name on its own line instead of fighting the bar for a
        90px column;
     4. touch targets reach 44px.                                             */
@media (max-width:760px){
  .wrap{padding:0 14px}
  section.card{padding:16px 14px;border-radius:12px;margin:14px 0}
  .mast{padding:18px 0 12px}
  .mast-top{gap:10px}
  .brandmark{font-size:20px}
  .stamp{text-align:left;font-size:12.5px}

  /* 2-up hero: 8 figures in 4 rows rather than 8 */
  .kpis{grid-template-columns:repeat(2,1fr);gap:9px;margin:16px 0 4px}
  .kpi{padding:11px 12px;border-radius:11px}
  .kpi .lab{font-size:10px;letter-spacing:.04em}
  .kpi .val{font-size:19px;margin:4px 0 2px}
  .kpi .sub{font-size:11px;line-height:1.35}

  .minikpis{grid-template-columns:repeat(2,1fr);gap:8px}
  .mk{padding:9px 11px}
  .mk .val{font-size:16px}
  .mk .lab{font-size:9.5px}

  .card-head h2{font-size:17px}
  .card-head .src{font-size:10px}
  .blurb{font-size:13px;margin-bottom:13px}

  /* bars: name on its own line, bar and value share the next */
  .hbar{grid-template-columns:1fr auto;gap:6px 9px;margin-bottom:11px}
  .hbar .nm{grid-column:1 / -1;font-size:12.5px;color:var(--sage)}
  .hbar .tr{height:13px}
  .legend{gap:7px 12px;font-size:11.5px}

  /* tables: freeze the identifying column while the numbers scroll past it */
  .tscroll{max-height:400px}
  .tscroll.tall{max-height:440px}
  table{font-size:12px}
  thead th{padding:8px 9px;font-size:10px;letter-spacing:.02em}
  tbody td{padding:7px 9px}
  thead th:first-child,tbody td:first-child{
    position:sticky;left:0;z-index:2;background:var(--card);
    box-shadow:1px 0 0 var(--line-soft);
  }
  thead th:first-child{z-index:3}
  tbody tr:hover td:first-child{background:var(--card-warm)}
  td.nm{min-width:130px;max-width:190px}
  .tnote{font-size:11.5px}

  /* 44px touch targets */
  .seg{width:100%;justify-content:space-between}
  .seg button{flex:1;padding:11px 8px;font-size:12.5px;min-height:44px}
  .themetog{min-height:44px;padding:10px 14px}
  .navrow{padding:6px 90px 6px 0;gap:5px}
  .navrow a{padding:10px 13px;font-size:12px;min-height:40px;display:flex;align-items:center}
  .caveat{font-size:12.5px;padding:11px 12px}
}
/* Company switcher: full name on desktop, short form on a phone. Rendered both
   ways and toggled, because "Wellness (Oil)" wraps a 4-up pill row onto two
   lines at 390px and the tab stops looking like a tab. */
.seg .sm{display:none}
@media (max-width:760px){
  .seg .lg{display:none}
  .seg .sm{display:inline}
  /* keep the masthead clear of the fixed corner badge */
  .mast-top > div:first-child{padding-right:96px}
}
/* only genuinely tiny screens drop to one column — two-up halves the scroll
   before the reader reaches any actual section */
@media (max-width:340px){
  .kpis,.minikpis{grid-template-columns:1fr}
  .kpi .val{font-size:22px}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
@media print{.navbar{display:none}.tscroll{max-height:none;overflow:visible}}
/* ── JIVO after dark ──────────────────────────────────────────────────────
   Same board, re-tokenised for a dark room. Nothing about the layout or the
   data changes; only the palette is swapped, and every swap keeps the rules
   the light palette was built on:
     • one fixed categorical order, never cycled, still CVD-separable;
     • the ageing ramp stays ONE warm hue and stays monotonic — but on dark
       "worse" reads as HOTTER, not darker, so the ramp runs dim → bright
       (the light board runs light → dark for the same reason);
     • 'not due' stays a STATUS in brand green, not a step of the ramp;
     • status colours stay reserved, never reused as "series 7".
   Applied from a data-theme attribute set before first paint, so there is no
   white flash and the office can still switch back to daylight.            */
:root[data-theme="dark"]{
  color-scheme:dark;

  --brand:#3FC177; --brand-deep:#EDF4EE; --ink:#E3E9E4;
  --sage:#A3ADA5;  --soft:#7F8A81;
  --cream:#0E1311; --card:#161C18; --card-warm:#1C231E;
  --line:#2B342D;  --line-soft:#222A24;

  /* categorical — same hue order as daylight, lifted into a dark-legible band */
  --c1:#35C46F; --c2:#6BA5FF; --c3:#E8913A; --c4:#C98BE6; --c5:#3DC3DC; --c6:#F5729E;

  /* ageing severity — one warm hue, monotonic dim → bright (worse = hotter) */
  --age-nd:#3FC177;
  --age1:#97704A; --age2:#B0813F; --age3:#C69138;
  --age4:#DCA333; --age5:#EEB23D; --age6:#FFC350;

  --ok:#3FC177; --warn:#E0A63A; --bad:#FF7A6B; --info:#6BB6EE; --dead:#8B948C;

  /* on dark, a drop shadow does nothing — the border carries the edge, the
     shadow only sinks the card slightly into the page */
  --shadow:0 1px 2px rgba(0,0,0,.45), 0 10px 26px -14px rgba(0,0,0,.6);

  --pulse:rgba(63,193,119,.45); --pulse-0:rgba(63,193,119,0);
}

/* brand green is light in dark mode, so the pressed tab needs dark ink */
:root[data-theme="dark"] .seg button[aria-pressed=true]{color:#07130C}

/* sticky nav's translucent backdrop follows the page, not the cream */
:root[data-theme="dark"] .navbar{background:rgba(14,19,17,.92)}

/* pills / callouts: the only rules with baked-in colour. Tinted surface,
   light text — same five meanings, same word-plus-colour pairing. */
:root[data-theme="dark"] .pill.ok  {background:#14301F;color:#7FDCA4;border-color:#20492F}
:root[data-theme="dark"] .pill.warn{background:#33260C;color:#F0C173;border-color:#4E3A12}
:root[data-theme="dark"] .pill.bad {background:#3A1A16;color:#FF9E92;border-color:#552722}
:root[data-theme="dark"] .pill.dead{background:#242926;color:#9BA39C;border-color:#333A35}
:root[data-theme="dark"] .pill.info{background:#132A3A;color:#8CC8F0;border-color:#1E4058}
:root[data-theme="dark"] .err{background:#3A1A16;border-color:#552722;color:#FF9E92}
:root[data-theme="dark"] .caveat{background:#332609;border-color:#4E3A12;color:#F0C173}
:root[data-theme="dark"] .caveat b{color:#FFD79A}
:root[data-theme="dark"] footer code{background:var(--card-warm)}
</style>
</head>
<body>

<div class="wrap">
  <header class="mast">
    <div class="mast-top">
      <div>
        <h1 class="brandmark">JIVO <span>Accounts Board</span></h1>
        <div class="ctrls">
          <div class="seg" id="companySwitch" role="group" aria-label="Company"></div>
          <button class="themetog" id="themeToggle" type="button">
            <span class="ic" aria-hidden="true">☀</span><span class="tl">Light</span>
          </button>
        </div>
      </div>
      <div class="stamp" id="stamp"></div>
    </div>
    <div class="kpis" id="heroKpis"></div>
  </header>
</div>

<nav class="navbar"><div class="wrap"><div class="navrow" id="navrow"></div></div></nav>

<main class="wrap" id="main">
  <div class="empty" id="boot">Loading SAP data…</div>
</main>

<div class="wrap"><footer id="foot"></footer></div>

<script>
/* ══════════════════════════════════════════════════════════════════════════
   JIVO Accounts Board — renderer
   Reads site/data.json (built by pipeline/build_data.py straight from SAP
   HANA, read-only). No network calls, no CDN, no framework.
   ══════════════════════════════════════════════════════════════════════════ */

const AGE_ORDER = ['A_notdue','B_1-30','C_31-60','D_61-90','E_91-180','F_181-365','G_365+'];
const AGE_LABEL = {'A_notdue':'Not due','B_1-30':'1–30 d','C_31-60':'31–60 d',
                   'D_61-90':'61–90 d','E_91-180':'91–180 d','F_181-365':'181–365 d','G_365+':'365 d +'};
const AGE_VAR   = {'A_notdue':'--age-nd','B_1-30':'--age1','C_31-60':'--age2','D_61-90':'--age3',
                   'E_91-180':'--age4','F_181-365':'--age5','G_365+':'--age6'};
const CAT = ['--c1','--c2','--c3','--c4','--c5','--c6'];

/* ── number formatting: Indian grouping, crores and lakhs ──────────────── */
function inGroup(s){                       // 12345678 -> 1,23,45,678
  s = String(s);
  if (s.length <= 3) return s;
  const last3 = s.slice(-3);
  let rest = s.slice(0, -3), out = '';
  while (rest.length > 2){ out = ',' + rest.slice(-2) + out; rest = rest.slice(0, -2); }
  return (rest ? rest + out : out.replace(/^,/, '')) + ',' + last3;
}
/* Money-unit convention across all section SQL — the column name carries the
   unit, so a query can return whatever scale reads best in a TSV:
       FOO_L -> INR lakhs    FOO_CR -> INR crores    FOO_INR / anything else -> rupees
   scale() lifts a value to rupees before formatting, so one formatter serves
   every section and nothing is ever displayed 100,000x wrong. */
function scale(v, col){
  if (v === null || v === undefined || v === '' || isNaN(v)) return v;
  if (/_CR$/i.test(col)) return Number(v) * 1e7;
  if (/_L$/i.test(col))  return Number(v) * 1e5;
  return Number(v);
}
/* Which columns are money at all. Three agents worked independently and each
   picked its own suffix, so match all of them — a money column rendered as a
   plain integer reads as a document count, which is worse than ugly. */
/* Identifiers are numerals, not quantities. A document number rendered with
   Indian grouping ("1,60,22,01,113") reads as an amount and cannot be searched
   for in SAP, so these columns are printed exactly as stored. */
function isIdCol(c){
  return /(_code|_num|_no|_entry|_id|_ref|_key|_type|_masked)$/i.test(c)
      && !/(_pct|_amt)$/i.test(c);
}
function isMoneyCol(c){
  return (/(_inr|_cr|_l|_amt|_gross|_net|_gst|_cost|amount|total|balance|_bal|value|payable|open|credit|debit|paid|advance|sum)$/i.test(c)
          || /^(ub|unrec)_\d/i.test(c))
      && !/(_cnt|_docs|_count|_pct|_n|_lines|_rank|_days)$/i.test(c)
      && !/_docs_/i.test(c);   // RET_DOCS_ZERO_VALUE / RET_DOCS_OPEN are counts, not money
}
function money(n, opts){
  opts = opts || {};
  if (n === null || n === undefined || n === '' || isNaN(n)) return '—';
  n = Number(n);
  const sign = n < 0 ? '−' : '', a = Math.abs(n);
  if (!opts.exact){
    if (a >= 1e7) return sign + '₹' + (a/1e7).toFixed(2) + ' Cr';
    if (a >= 1e5) return sign + '₹' + (a/1e5).toFixed(2) + ' L';
  }
  return sign + '₹' + inGroup(Math.round(a));
}
function num(n){
  if (n === null || n === undefined || n === '' || isNaN(n)) return '—';
  return inGroup(Math.round(Number(n)));
}
function pct(n, d){ return (!d || isNaN(n)) ? '—' : (100*Number(n)/Number(d)).toFixed(1) + '%'; }
function esc(s){ return String(s === null || s === undefined ? '' : s)
  .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
/* Chart colours are handed to the browser as a live var() reference, not as a
   resolved hex. Resolving here would BAKE the palette into the inline style at
   render time, and flipping the theme would then leave every bar, stack and
   legend swatch painted in the old theme's colours until the next re-render. */
function cvar(v){ return `var(${v})`; }
function isNumCol(k){ return /^(n|cnt|count|qty|days|amt|amount|total|bal|balance|open|paid|value|val|cr|l|pct|_)/i.test(k)
                        || /(_cr|_l|_amt|_qty|_n|_days|_pct|amount|total|balance|value|count)$/i.test(k); }

/* ── generic helpers ──────────────────────────────────────────────────── */
function sumBy(rows, key){ return (rows||[]).reduce((a,r)=> a + (Number(r[key])||0), 0); }
function el(html){ const d = document.createElement('div'); d.innerHTML = html.trim(); return d.firstElementChild; }

/* horizontal bar list: name | bar | value. 4px rounded data end, 1px surface ring. */
function hbars(items, colorVar){
  const max = Math.max(1, ...items.map(i => Math.abs(i.v)));
  return items.map((i,ix) => {
    const c = i.color || cvar(colorVar || CAT[ix % CAT.length]);
    const w = Math.max(1.5, 100 * Math.abs(i.v) / max);
    return `<div class="hbar"><div class="nm" title="${esc(i.name)}">${esc(i.name)}</div>`
         + `<div class="tr"><div class="fl" style="width:${w}%;background:${c}"></div></div>`
         + `<div class="vl">${i.label !== undefined ? i.label : money(i.v)}</div></div>`;
  }).join('');
}

/* stacked ageing bar + legend, with visible value labels (contrast relief) */
function ageStack(buckets){
  const total = AGE_ORDER.reduce((a,b) => a + (Number(buckets[b])||0), 0);
  if (!total) return '<div class="empty">Nothing outstanding.</div>';
  const segs = AGE_ORDER.map(b => {
    const v = Number(buckets[b])||0;
    if (!v) return '';
    return `<div style="width:${(100*v/total).toFixed(2)}%;background:${cvar(AGE_VAR[b])}"
             title="${AGE_LABEL[b]}: ${money(v)}"></div>`;
  }).join('');
  const leg = AGE_ORDER.filter(b => Number(buckets[b])).map(b =>
    `<span><i style="background:${cvar(AGE_VAR[b])}"></i>${AGE_LABEL[b]} <b>${money(buckets[b])}</b></span>`
  ).join('');
  return `<div class="stack">${segs}</div><div class="legend">${leg}</div>`;
}

/* generic sortable table — renders whatever columns the SQL returned */
function table(rows, opts){
  opts = opts || {};
  if (!rows || !rows.length) return `<div class="empty">${opts.emptyMsg || 'No rows.'}</div>`;
  const cols = opts.cols || Object.keys(rows[0]);
  const head = cols.map(c => `<th data-c="${esc(c)}">${esc(opts.head && opts.head[c] || c)}<span class="ar">▲▼</span></th>`).join('');
  const body = rows.map(r => '<tr>' + cols.map(c => {
    const v = r[c];
    if (opts.cell && opts.cell[c]) return opts.cell[c](v, r);
    if (typeof v === 'number'){
      if (isIdCol(c)) return `<td>${esc(String(v))}</td>`;
      /* A percentage must never go through num() — Math.round turns 0.94% into
         "1" and a lag of 0.6 days into "1". Percentages keep their decimal. */
      if (/(_pct|_pct_of_[a-z]+)$/i.test(c))
        return `<td class="num">${v.toFixed(2)}%</td>`;
      return `<td class="num${v<0?' neg':''}">${isMoneyCol(c) ? money(scale(v,c)) : num(v)}</td>`;
    }
    return `<td class="${/name|desc|remark|item/i.test(c) ? 'nm' : ''}">${esc(v === null ? '—' : v)}</td>`;
  }).join('') + '</tr>').join('');
  const note = opts.note ? `<div class="tnote">${opts.note}</div>` : '';
  return `<div class="tscroll${opts.tall ? ' tall' : ''}"><table><thead><tr>${head}</tr></thead>`
       + `<tbody>${body}</tbody></table></div>${note}`;
}

function wireSort(root){
  root.querySelectorAll('table').forEach(t => {
    t.querySelectorAll('thead th').forEach((th, ix) => {
      th.addEventListener('click', () => {
        const tb = t.tBodies[0], rows = [...tb.rows];
        const dir = th.dataset.dir === 'asc' ? -1 : 1;
        t.querySelectorAll('thead th').forEach(o => delete o.dataset.dir);
        th.dataset.dir = dir === 1 ? 'asc' : 'desc';
        rows.sort((a,b) => {
          const x = a.cells[ix].textContent.trim(), y = b.cells[ix].textContent.trim();
          const nx = parseFloat(x.replace(/[^0-9.−-]/g,'').replace('−','-'));
          const ny = parseFloat(y.replace(/[^0-9.−-]/g,'').replace('−','-'));
          if (!isNaN(nx) && !isNaN(ny)) return (nx - ny) * dir;
          return x.localeCompare(y) * dir;
        });
        rows.forEach(r => tb.appendChild(r));
      });
    });
  });
}

/* ══ section definitions ═══════════════════════════════════════════════════
   Each entry declares its identity and how to draw itself. `render` receives
   ({summary, detail, errors}) for the ACTIVE company and returns HTML.
   Sections fall back to a generic table until a bespoke renderer is fitted,
   so the board is useful the moment data.json exists.                        */
const SECTIONS = [
  { id:'vendor-ageing',   title:'Vendor Ageing',        src:'OPCH · OVPM · ORPC · OCRD',
    blurb:'What JIVO owes each vendor, aged on the bill due date — after netting off advances paid but never applied to a bill, and open debit notes.' },
  { id:'customer-ageing', title:'Customer Ageing',      src:'OINV · ORCT · ORIN · OCRD',
    blurb:'What each customer owes JIVO, aged on the invoice due date, credit-adjusted: unapplied receipts and open credit notes are applied oldest-invoice-first before ageing.' },
  { id:'open-item-list',  title:'Open Item List',       src:'OINV · ORIN · ORCT · OPCH · ORPC · OVPM',
    blurb:'Every open document on both sides of the ledger, one row each — the drill-down behind both ageings.' },
  { id:'grpo',            title:'GRPO — Goods Receipt PO', src:'OPDN · PDN1',
    blurb:'Goods received against purchase orders. Open GRPOs are stock taken in with no vendor bill booked against it yet — an unrecorded liability.' },
  { id:'goods-return',    title:'Goods Return',         src:'ORPD · RPD1',
    blurb:'Stock sent back to vendors, and whether an A/P credit note followed it. A return with no credit note is money given back in goods but never recovered on paper.' },
  { id:'return-note',     title:'Return Note',          src:'ORDN · RDN1',
    blurb:'Customer returns coming back into JIVO, and whether a credit note was raised against each.' },
  { id:'provisions',      title:'Provisions Register',  src:'OACT · OJDT · JDT1',
    blurb:'Month-end expense provisions: what was provided, what has been reversed or utilised, and what is still sitting open — with the age of the un-reversed balance.' },
  { id:'budget-heads',    title:'Budget Heads — Expense & GL', src:'JSAP bud.jsBudgetTable',
    blurb:'Every expense approved against a budget head, by the EFFECTIVE month it belongs to — with the sub-head and the GL account it lands on. This is the only place that carries the effective month and the budget head; SAP knows neither. Oil and Beverages only — Mart does not run the process.' },
  { id:'factory-indirect', title:'Factory Indirect & Casual Labour', src:'JDT1 · OACT',
    blurb:'The whole INDIRECT EXPENSE tree (5600000) by posting month, with CASUAL LABOUR (5100008) alongside it — that account sits under DIRECT EXPENSE and is invisible in an indirect-only cut, which is why it is pulled in here. Straight from the posted ledger.' },
  { id:'cash-sale',       title:'Cash Sale',            src:'OINV · ORCT · OCTG',
    blurb:'Invoices settled in cash rather than on credit.' },
  { id:'bank-accounts',   title:'Bank A/c Wise',        src:'ODSC · OACT · JDT1',
    blurb:'Position and movement per bank account. Account numbers are masked to the last 4 digits.' },
  { id:'bank-reco',       title:'Bank Reconciliation',  src:'OBNK · OITR · ORCT · OVPM',
    blurb:'What SAP itself knows about reconciled versus unreconciled bank items, and cheques issued but not yet cleared. SAP-side only — no external bank statement is loaded.' },
  { id:'transporter',     title:'Transporter As Per SAP', src:'OINV UDFs',
    blurb:'Dispatch value by transporter, from the transporter/LR/vehicle user-defined fields on invoices. The standard SAP shipping table is empty at JIVO — these UDFs are the only source.' },
];

/* ══ state ════════════════════════════════════════════════════════════════ */
let DATA = null, COMPANY = 'oil';

function activeRows(sec, kind){
  const s = DATA.sections[sec];
  if (!s) return [];
  if (COMPANY === 'group'){
    return DATA.companies.flatMap(c =>
      (s[kind] && s[kind][c.key] || []).map(r => Object.assign({ _co: c.label }, r)));
  }
  return (s[kind] && s[kind][COMPANY]) || [];
}
function activeErrors(sec){
  const s = DATA.sections[sec];
  if (!s || !s.errors) return [];
  return Object.entries(s.errors)
    .filter(([k]) => COMPANY === 'group' || k.endsWith('.' + COMPANY))
    .map(([k,v]) => k + ': ' + v);
}

/* ══ render ═══════════════════════════════════════════════════════════════ */
const SHORT = {oil:'Oil', mart:'Mart', bev:'Bev', group:'Group'};
function renderSwitch(){
  const opts = DATA.companies.map(c => ({key:c.key, label:c.label.replace(/JIVO\s*/,'')}))
                             .concat([{key:'group', label:'Group'}]);
  document.getElementById('companySwitch').innerHTML = opts.map(o =>
    `<button data-k="${o.key}" aria-pressed="${o.key===COMPANY}">`
  + `<span class="lg">${esc(o.label)}</span>`
  + `<span class="sm">${esc(SHORT[o.key] || o.label)}</span></button>`).join('');
  document.querySelectorAll('#companySwitch button').forEach(b =>
    b.addEventListener('click', () => { COMPANY = b.dataset.k; renderAll(); }));
}

function renderNav(){
  document.getElementById('navrow').innerHTML =
    SECTIONS.map(s => `<a href="#${s.id}">${esc(s.title)}</a>`).join('');
}

/* "3 minutes ago" beats a timestamp on a board that refreshes itself — the
   reader wants to know it is current, not to do arithmetic. */
function ago(d){
  const s = Math.max(0, (Date.now() - d.getTime()) / 1000);
  if (s < 90) return 'just now';
  if (s < 5400) return Math.round(s / 60) + ' min ago';
  if (s < 172800) return Math.round(s / 3600) + ' h ago';
  return Math.round(s / 86400) + ' d ago';
}

function renderStamp(){
  const g = new Date(DATA.generated_at);
  document.getElementById('stamp').innerHTML =
    `Position as at <b>${esc(DATA.as_of)}</b><br>`
  + `<span class="live"><i></i>updated ${esc(ago(g))}</span><br>`
  + `<span style="color:var(--soft)">read-only from SAP HANA</span>`;
}

function renderSections(){
  const main = document.getElementById('main');
  main.innerHTML = SECTIONS.map((s, i) => {
    const summary = activeRows(s.id, 'summary');
    const detail  = activeRows(s.id, 'detail');
    const errs    = activeErrors(s.id);
    let inner = '';
    /* A section fed by a second system keeps its last good figures when that
       system is unreachable. Say so on the card — a stale number that looks
       live is the one failure mode worth shouting about. */
    const meta = DATA.sections[s.id] || {};
    if (meta.stale_since)
      inner += `<div class="caveat"><b>Last good read.</b> This section's source was `
             + `unreachable on the latest build, so these are the figures as at `
             + `${esc(ago(new Date(meta.stale_since)))} — the rest of the board is `
             + `current.</div>`;
    if (errs.length)
      inner += `<div class="err"><b>This section could not be built for the selected company.</b>${
        errs.map(esc).join('<br>')}</div>`;
    if (RENDERERS[s.id])
      inner += RENDERERS[s.id]({summary, detail, id:s.id});
    else if (summary.length || detail.length)
      inner += (summary.length ? table(summary, {tall:true}) : '')
             + (detail.length  ? `<div class="chart-title" style="margin-top:16px">Detail</div>`
                                 + table(detail, {tall:true}) : '');
    else if (!errs.length)
      inner += `<div class="empty">No rows for this company.</div>`;

    return `<section class="card" id="${s.id}">
      <div class="card-head"><h2>${esc(s.title)}</h2><span class="src">${esc(s.src)}</span></div>
      <p class="blurb">${esc(s.blurb)}</p>${inner}</section>`;
  }).join('');
  wireSort(main);
}

/* ══ bucket detection ═════════════════════════════════════════════════════
   Ageing SQL may name its buckets B0_NOTDUE…B6_365PLUS (party ageing) or
   AGE_0_30_L…AGE_365P_L (provision ageing). Detect rather than hard-code, so
   one renderer serves every ageing-shaped section.                           */
const BUCKET_PRETTY = {
  B0_NOTDUE:'Not due', B1_1_30:'1–30 d', B2_31_60:'31–60 d', B3_61_90:'61–90 d',
  B4_91_180:'91–180 d', B5_181_365:'181–365 d', B6_365PLUS:'365 d +',
  AGE_0_30_L:'0–30 d', AGE_31_90_L:'31–90 d', AGE_91_365_L:'91–365 d', AGE_365P_L:'365 d +',
  NOTDUE_INR:'Not due', D1_30_INR:'1–30 d', D31_60_INR:'31–60 d', D61_90_INR:'61–90 d',
  D91_180_INR:'91–180 d', D181_365_INR:'181–365 d', D365P_INR:'365 d +',
  UB_0_30:'0–30 d', UB_31_60:'31–60 d', UB_61_90:'61–90 d', UB_91_180:'91–180 d',
  UB_181_365:'181–365 d', UB_365PLUS:'365 d +',
  UNREC_0_30_L:'0–30 d', UNREC_31_60_L:'31–60 d', UNREC_61_90_L:'61–90 d', UNREC_90PLUS_L:'90 d +',
};
const BUCKET_COLOR = {
  B0_NOTDUE:'--age-nd', B1_1_30:'--age1', B2_31_60:'--age2', B3_61_90:'--age3',
  B4_91_180:'--age4', B5_181_365:'--age5', B6_365PLUS:'--age6',
  AGE_0_30_L:'--age1', AGE_31_90_L:'--age3', AGE_91_365_L:'--age5', AGE_365P_L:'--age6',
  NOTDUE_INR:'--age-nd', D1_30_INR:'--age1', D31_60_INR:'--age2', D61_90_INR:'--age3',
  D91_180_INR:'--age4', D181_365_INR:'--age5', D365P_INR:'--age6',
  UB_0_30:'--age1', UB_31_60:'--age2', UB_61_90:'--age3', UB_91_180:'--age4',
  UB_181_365:'--age5', UB_365PLUS:'--age6',
  UNREC_0_30_L:'--age1', UNREC_31_60_L:'--age3', UNREC_61_90_L:'--age4', UNREC_90PLUS_L:'--age6',
};
/* Three naming conventions reached us from three independently-working agents.
   Detect rather than hard-code — order is preserved, oldest bucket last. */
const BUCKET_SETS = [
  ['B0_NOTDUE','B1_1_30','B2_31_60','B3_61_90','B4_91_180','B5_181_365','B6_365PLUS'],
  ['NOTDUE_INR','D1_30_INR','D31_60_INR','D61_90_INR','D91_180_INR','D181_365_INR','D365P_INR'],
  ['AGE_0_30_L','AGE_31_90_L','AGE_91_365_L','AGE_365P_L'],
  ['UB_0_30','UB_31_60','UB_61_90','UB_91_180','UB_181_365','UB_365PLUS'],
  ['UNREC_0_30_L','UNREC_31_60_L','UNREC_61_90_L','UNREC_90PLUS_L'],
];
function detectBuckets(row){
  if (!row) return null;
  for (const set of BUCKET_SETS){
    const have = set.filter(c => c in row);
    if (have.length >= 3) return have;
  }
  return null;
}
/* group a tall/faceted result into {facetValue: rows[]} preserving row order */
function facets(rows, col){
  const m = new Map();
  (rows||[]).forEach(r => { const k = r[col]; if (!m.has(k)) m.set(k, []); m.get(k).push(r); });
  return m;
}
/* `chrono` keeps a time series in time order. Ranking a month series by value
   destroys the one thing it is for — you cannot see a trend in a sorted bar list. */
function barsFrom(rows, labelCol, valCol, n, colorVar, chrono){
  let r = rows.filter(x => Number(x[valCol]));
  r = chrono
    ? r.slice().sort((a,b) => String(a[labelCol]).localeCompare(String(b[labelCol])))
    : r.slice().sort((a,b) => Math.abs(Number(b[valCol])||0) - Math.abs(Number(a[valCol])||0));
  if (n) r = chrono ? r.slice(-n) : r.slice(0, n);
  return hbars(r.map(x => ({ name: x[labelCol], v: scale(Number(x[valCol])||0, valCol) })), colorVar);
}
/* stacked bar over detected buckets, with a fully value-labelled legend —
   the lightest ramp steps sit under 3:1 on cream, so the label is the relief */
function bucketStack(rows, cols){
  const tot = {};
  cols.forEach(c => tot[c] = rows.reduce((a,r) => a + scale(Number(r[c])||0, c), 0));
  const grand = cols.reduce((a,c) => a + tot[c], 0);
  if (grand <= 0) return '<div class="empty">Nothing outstanding.</div>';
  const segs = cols.map(c => tot[c] <= 0 ? '' :
    `<div style="width:${(100*tot[c]/grand).toFixed(2)}%;background:${cvar(BUCKET_COLOR[c]||'--age3')}"
      title="${esc(BUCKET_PRETTY[c]||c)}: ${money(tot[c])}"></div>`).join('');
  const leg = cols.filter(c => tot[c] > 0).map(c =>
    `<span><i style="background:${cvar(BUCKET_COLOR[c]||'--age3')}"></i>${
      esc(BUCKET_PRETTY[c]||c)} <b>${money(tot[c])}</b></span>`).join('');
  return `<div class="stack">${segs}</div><div class="legend">${leg}</div>`;
}

function mk(lab, val, cls, sub){
  return `<div class="mk"><div class="lab">${esc(lab)}</div>`
       + `<div class="val ${cls||''}">${val}</div>`
       + (sub ? `<div class="lab" style="text-transform:none;letter-spacing:0;font-weight:500;margin-top:3px">${sub}</div>` : '')
       + `</div>`;
}

/* ══ party ageing (vendor + customer) ═════════════════════════════════════ */
function renderPartyAgeing(side){
  return function({summary}){
    if (!summary.length) return '<div class="empty">No open party balances.</div>';
    const cols = detectBuckets(summary[0]);
    const nameCol = 'CARD_NAME' in summary[0] ? 'CARD_NAME' : Object.keys(summary[0])[1];
    const codeCol = 'CARD_CODE' in summary[0] ? 'CARD_CODE' : Object.keys(summary[0])[0];
    const openCol = ['ADJ_OPEN','PAYABLE','RECEIVABLE','OPEN','ADJ_OPEN_TRADE']
                      .find(c => c in summary[0]) || (cols && cols[0]);
    const kindCol = ['ACCT_KIND','CARD_KIND','KIND'].find(c => c in summary[0]);
    const isTrade = r => !kindCol || r[kindCol] === 'TRADE';

    const trade = summary.filter(isTrade);
    const excl  = summary.filter(r => !isTrade(r));
    const tot   = rs => rs.reduce((a,r) => a + scale(Number(r[openCol])||0, openCol), 0);
    const late  = rs => cols ? rs.reduce((a,r) => a + cols.slice(3)
                        .reduce((x,c) => x + scale(Number(r[c])||0, c), 0), 0) : 0;

    const word = side === 'vendor' ? 'payable' : 'receivable';
    const kpis = [
      mk(`External trade ${word}`, money(tot(trade)), '', `${trade.length} parties`),
      mk('Overdue 61 d +', money(late(trade)), late(trade) > 0 ? 'bad' : 'ok',
         tot(trade) ? pct(late(trade), tot(trade)) + ' of the book' : ''),
      mk('Branch / intercompany', money(tot(excl)), 'warn',
         `${excl.length} accounts — flagged, not netted`),
    ].join('');

    const top = trade.slice()
      .sort((a,b) => scale(Number(b[openCol])||0,openCol) - scale(Number(a[openCol])||0,openCol))
      .slice(0, 15)
      .map(r => ({ name: r[nameCol], v: scale(Number(r[openCol])||0, openCol) }));

    const tblCols = [codeCol, nameCol, kindCol, openCol]
      .concat(cols || []).filter(Boolean)
      .filter((c,i,a) => a.indexOf(c) === i && c in summary[0]);

    return `<div class="minikpis">${kpis}</div>`
      + (cols ? `<div class="chart"><div class="chart-title">Where the external trade ${word} sits, by age</div>`
               + bucketStack(trade, cols) + `</div>` : '')
      + `<div class="chart"><div class="chart-title">Top 15 by ${word} (external trade only)</div>`
      + hbars(top, side === 'vendor' ? '--c3' : '--c2') + `</div>`
      + table(summary, {tall:true, cols:tblCols, head:Object.fromEntries(
          tblCols.map(c => [c, BUCKET_PRETTY[c] || c.replace(/_/g,' ').toLowerCase()])),
          note:`${summary.length} parties. Branch and intercompany rows are kept and marked — `
             + `they are JIVO's own accounts, not trade.`});
  };
}

/* ══ provisions ═══════════════════════════════════════════════════════════ */
function renderProvisions({summary}){
  if (!summary.length) return '<div class="empty">No provision accounts found in this book.</div>';
  const out   = r => Number(r.OUTSTANDING_CR_L) || 0;
  const total = summary.reduce((a,r) => a + out(r), 0) * 1e5;
  const stale = summary.filter(r => (Number(r.AGE_365P_L)||0) > 0);
  const staleV = stale.reduce((a,r) => a + (Number(r.AGE_365P_L)||0), 0) * 1e5;
  const never = summary.filter(r => r.NEVER_REVERSED === 'Y');
  const neverV = never.reduce((a,r) => a + out(r), 0) * 1e5;
  const dr = summary.filter(r => r.DEBIT_BALANCE_FLAG === 'Y');

  const kpis = [
    mk('Still provided for', money(total), '', `${summary.filter(r=>out(r)>0).length} accounts carrying a balance`),
    mk('Older than a year', money(staleV), staleV > 0 ? 'bad' : 'ok', `${stale.length} accounts`),
    mk('Never once reversed', money(neverV), neverV > 0 ? 'warn' : 'ok', `${never.length} accounts`),
    mk('Over-reversed (debit bal.)', String(dr.length), dr.length ? 'warn' : 'ok', 'should not happen'),
  ].join('');

  const cols = ['AGE_0_30_L','AGE_31_90_L','AGE_91_365_L','AGE_365P_L'].filter(c => c in summary[0]);
  const top = summary.filter(r => out(r) > 0)
    .sort((a,b) => out(b) - out(a)).slice(0, 12)
    .map(r => ({ name: r.ACCT_NAME, v: out(r) * 1e5 }));

  const tc = ['FAMILY','ACCT_CODE','ACCT_NAME','OUTSTANDING_CR_L','CREATED_FYTD_L','REVERSED_FYTD_L']
    .concat(cols).concat(['OLDEST_OPEN_DAYS','LAST_POST','NEVER_REVERSED'])
    .filter(c => c in summary[0]);

  return `<div class="minikpis">${kpis}</div>`
    + `<div class="chart"><div class="chart-title">Age of the un-reversed balance</div>`
    + bucketStack(summary, cols) + `</div>`
    + `<div class="chart"><div class="chart-title">Largest provisions still standing</div>`
    + hbars(top, '--c4') + `</div>`
    + table(summary, {tall:true, cols:tc, head:Object.fromEntries(tc.map(c =>
        [c, BUCKET_PRETTY[c] || c.replace(/_L$/,'').replace(/_/g,' ').toLowerCase()])),
        cell:{ NEVER_REVERSED:(v)=> `<td>${v==='Y'
          ? '<span class="pill warn">never reversed</span>' : ''}</td>` },
        note:'SAP\'s own G/L reconciliation is not used on these accounts, so the age of the '
           + 'un-reversed balance is computed oldest-credit-first — deliberately conservative.'});
}

/* ══ customer ageing — summarised by account KIND ═════════════════════════ */
function renderKindAgeing({summary, detail}){
  if (!summary.length) return '<div class="empty">No open customer balances.</div>';
  const by = {}; summary.forEach(r => by[r.KIND] = r);
  const T = by.TRADE || {}, Z = by.ZZ_TOTAL || {};
  const cols = detectBuckets(summary[0]) || [];
  const late = r => cols.slice(3).reduce((a,c) => a + (Number(r[c])||0), 0);
  const nonTrade = summary.filter(r => r.KIND !== 'TRADE' && r.KIND !== 'ZZ_TOTAL');
  const nonTradeV = nonTrade.reduce((a,r) => a + (Number(r.EFF_OPEN_INR)||0), 0);

  const caveat = `<div class="caveat"><b>Read the second number, not the first.</b>
    SAP shows <b>${money(Z.RAW_OPEN_INR)}</b> of open customer invoices across this book.
    But <b>${money(Z.UNAPPLIED_CREDIT_INR)}</b> of that is money already banked from
    customers, or credit notes already raised, that was never matched against the
    individual invoice — so the invoice still reads OPEN in SAP even though the cash is in.
    Netting that off leaves <b>${money(Z.EFF_OPEN_INR)}</b> genuinely outstanding.
    The buckets below are computed after that netting, oldest invoice first.</div>`;

  const kpis = [
    mk('External trade — really owed', money(T.EFF_OPEN_INR), '',
       /* the corrected money must not be quoted beside SAP's uncorrected counts:
          after netting, only a fraction of the open invoices carry any of it. */
       T.N_EFF_INV == null
         ? `${num(T.N_CUSTOMERS)} customers · ${num(T.N_OPEN_INV)} invoices`
         : `${num(T.N_EFF_CUSTOMERS)} customers · ${num(T.N_EFF_INV)} invoices carry it`
           + ` <s>${num(T.N_OPEN_INV)} open</s>`),
    mk('Of that, overdue 61 d +', money(late(T)), late(T) > 0 ? 'bad' : 'ok',
       T.EFF_OPEN_INR ? pct(late(T), T.EFF_OPEN_INR) + ' of the trade book' : ''),
    mk('Banked but unmatched', money(T.UNAPPLIED_CREDIT_INR), 'warn',
       'customer cash sitting unapplied'),
    mk('Branch / interco / staff', money(nonTradeV), 'warn',
       nonTrade.map(r => r.KIND.toLowerCase()).join(', ') + ' — not trade'),
  ].join('');

  const tc = ['KIND','N_CUSTOMERS','N_EFF_CUSTOMERS','N_OPEN_INV','N_EFF_INV',
              'RAW_OPEN_INR','UNAPPLIED_CREDIT_INR','EFF_OPEN_INR']
    .concat(cols).filter(c => c in summary[0]);

  return caveat + `<div class="minikpis">${kpis}</div>`
    + `<div class="chart"><div class="chart-title">Where the real external trade receivable sits, by age</div>`
    + bucketStack([T], cols)
    /* The total is allocation-invariant — re-running the netting newest-first
       gives the same figure to the paisa. The SPLIT is not, and on Mart it is
       load-bearing: 60 d + reads Rs 30.14 L oldest-first against Rs 8.46 Cr
       newest-first. Saying so is the difference between a measurement and a
       number someone chases. */
    + `<div class="tnote"><b>These buckets are a lower bound.</b> Unapplied cash is
       netted against the oldest invoice first, which is the accounting convention
       — but SAP's internal reconciliation is unused here, so no record exists of
       which invoice a payment was actually meant for. The <i>total</i> is
       unaffected by that choice (netting newest-first gives the same figure to the
       paisa); the <i>split across buckets</i> is not. On Mart the 60-day-plus
       figure moves from ₹30.14 L to ₹8.46 Cr depending on the assumption. Treat
       the ageing profile as indicative and the total as firm.</div>`
    + `</div>`
    + table(summary, {cols:tc, head:Object.fromEntries(tc.map(c => [c,
        BUCKET_PRETTY[c] || c.replace(/_INR$/,'').replace(/_/g,' ').toLowerCase()])),
        note:'BRANCH and INTERCO are JIVO\'s own accounts. STAFF is employee advances. '
           + 'Only TRADE is money owed by outside customers.'})
    + (detail.length ? `<div class="chart-title" style="margin-top:18px">Per customer</div>`
        + table(detail, {tall:true}) : '');
}

/* ══ faceted tall tables (cash sale, goods return, and later sections) ════ */
function renderFaceted(cfg){
  return function({summary}){
    if (!summary.length) return `<div class="empty">${cfg.empty || 'No rows.'}</div>`;
    const g = facets(summary, cfg.facet);
    let out = '';

    if (cfg.kpiFacet && g.has(cfg.kpiFacet)){
      const rows = g.get(cfg.kpiFacet);
      const r = cfg.kpiRow ? (rows.find(cfg.kpiRow) || rows[0]) : rows[0];
      out += `<div class="minikpis">${cfg.kpis(r, summary).join('')}</div>`;
    }
    (cfg.blocks || []).forEach(b => {
      if (!g.has(b.facet)) return;
      const rows = g.get(b.facet);
      if (!rows.length) return;
      out += `<div class="chart"><div class="chart-title">${esc(b.title)}</div>`;
      out += b.kind === 'bars'
        ? barsFrom(rows, b.labelCol || 'ROW_LABEL', b.valCol, b.top, b.color, b.chrono)
        : table(rows, {cols:(b.cols || []).filter(c => c in rows[0]), tall:b.tall,
                       head:b.head, note:b.note, cell:b.cell});
      out += `</div>`;
    });
    if (!out) out = table(summary, {tall:true});
    return out;
  };
}

/* ══ month pivots ═════════════════════════════════════════════════════════
   The two expense sections are month series — the ask was explicitly "April to
   July, with proper effective months". A pivot puts a month on every column so
   a run-rate is readable across one row, and names the value columns
   M_<YYYYMM>_L so table()'s own money rule formats them; a second formatter
   would have drifted from the first within a month.                          */
function monthsOf(rows){
  const m = new Map();
  (rows || []).forEach(r => {
    if (r.MONTH_KEY && !m.has(r.MONTH_KEY)) m.set(r.MONTH_KEY, r.MONTH_LABEL || r.MONTH_KEY);
  });
  return [...m.entries()].sort((a,b) => a[0].localeCompare(b[0]));
}
function titleCase(s){
  return String(s === null || s === undefined ? '' : s)
    .toLowerCase().replace(/(^|[\s\-/(])([a-z])/g, (m,a,b) => a + b.toUpperCase());
}
function mcol(k){ return 'M_' + String(k).replace('-','') + '_L'; }

function monthPivot(rows, keyCols, valCol, opts){
  opts = opts || {};
  /* In the Group tab activeRows() tags every row with _co. Without it as a key
     column the pivot would fold Oil's "Interest" and Beverages' "Interest" into
     one row and silently present a consolidated figure as one book's. */
  if (rows && rows.length && '_co' in rows[0] && keyCols.indexOf('_co') < 0)
    keyCols = ['_co'].concat(keyCols);
  const months = monthsOf(rows);
  const map = new Map();
  (rows || []).forEach(r => {
    /* JSON.stringify, not join('|') — a GL account name with a pipe in it would
       otherwise merge two different rows into one. */
    const id = JSON.stringify(keyCols.map(c => r[c] === undefined ? null : r[c]));
    if (!map.has(id)){
      const base = {};
      keyCols.forEach(c => base[c] = r[c]);
      months.forEach(([k]) => base[mcol(k)] = 0);
      base.TOTAL_L = 0;
      map.set(id, base);
    }
    const o = map.get(id), v = Number(r[valCol]) || 0;
    if (r.MONTH_KEY && (mcol(r.MONTH_KEY) in o)) o[mcol(r.MONTH_KEY)] += v;
    o.TOTAL_L += v;
  });
  const r2 = n => Math.round(n * 100) / 100;
  let out = [...map.values()];
  out.forEach(o => {
    months.forEach(([k]) => o[mcol(k)] = r2(o[mcol(k)]));
    o.TOTAL_L = r2(o.TOTAL_L);
  });
  out.sort((a,b) => Math.abs(b.TOTAL_L) - Math.abs(a.TOTAL_L));
  const shown = opts.top ? out.slice(0, opts.top) : out;
  const cols = keyCols.concat(months.map(([k]) => mcol(k)), ['TOTAL_L']);
  const head = Object.assign({TOTAL_L:'FY to date', _co:'Company'}, opts.head || {});
  months.forEach(([k,l]) => head[mcol(k)] = titleCase(l));
  let note = opts.note || '';
  if (opts.top && out.length > opts.top)
    note = `Showing the ${opts.top} largest of ${out.length} rows`
         + (note ? '. ' + note : '.');
  return table(shown, {tall:true, cols, head, note});
}

/* month totals as chronological bars — never ranked by value, that destroys
   the one thing a month series is for */
function monthBars(rows, valCol, colorVar){
  const L = 1e5;
  return hbars(monthsOf(rows).map(([k,l]) => ({
    name: titleCase(l),
    v: rows.filter(r => r.MONTH_KEY === k).reduce((a,r) => a + (Number(r[valCol])||0), 0) * L,
  })), colorVar);
}

/* one stacked bar over named parts, value-labelled (the lightest ramp steps sit
   under 3:1 on cream, so the label carries the meaning) */
function partStack(parts){
  const shown = parts.filter(p => Number(p.v) > 0);
  const tot = shown.reduce((a,p) => a + Number(p.v), 0);
  if (tot <= 0) return '<div class="empty">Nothing to split.</div>';
  const col = (p,i) => p.color || cvar(CAT[i % CAT.length]);
  const segs = shown.map((p,i) =>
    `<div style="width:${(100*p.v/tot).toFixed(2)}%;background:${col(p,i)}"`
  + ` title="${esc(p.name)}: ${money(p.v)}"></div>`).join('');
  const leg = shown.map((p,i) =>
    `<span><i style="background:${col(p,i)}"></i>${esc(p.name)} <b>${money(p.v)}</b></span>`).join('');
  return `<div class="stack">${segs}</div><div class="legend">${leg}</div>`;
}

/* ══ budget heads — JSAP, by effective month ══════════════════════════════ */
function renderBudgetHeads({summary, detail}){
  if (!summary.length)
    return `<div class="empty">This book does not run the JSAP budget process — `
         + `only Oil and Beverages do.</div>`;
  const L = 1e5;
  const months = monthsOf(summary);
  const span  = months.length
    ? titleCase(months[0][1]) + ' to ' + titleCase(months[months.length-1][1]) : '';
  const tot  = sumBy(summary, 'NET_L') * L;
  const pend = sumBy(summary, 'PENDING_L') * L;
  const rej  = sumBy(summary, 'REJECTED_L') * L;
  const cred = sumBy(summary, 'CREDITED_L') * L;
  const heads = new Set(summary.map(r => r.HEAD)).size;
  const gls   = new Set(detail.map(r => r.ACCT_CODE)).size;

  const kpis = [
    mk('Budget-tagged spend', money(tot), '',
       `${months.length} effective month${months.length === 1 ? '' : 's'}`
       + (span ? ' · ' + span : '')),
    mk('Average a month', money(months.length ? tot/months.length : 0), '',
       `${heads} budget heads · ${gls} GL accounts`),
    mk('Awaiting approval', money(pend), pend > 0 ? 'warn' : 'ok',
       'still in the approval queue'),
    mk('Rejected', money(rej), rej > 0 ? 'warn' : 'ok', 'put up and turned down'),
  ].join('');

  const byHead = [...new Set(summary.map(r => r.HEAD))].map(h => ({
    name: h,
    v: summary.filter(r => r.HEAD === h).reduce((a,r) => a + (Number(r.NET_L)||0), 0) * L,
  })).sort((a,b) => Math.abs(b.v) - Math.abs(a.v));

  const route = partStack([
    {name:'A/P invoice',            v: sumBy(summary,'AP_INVOICE_L') * L},
    {name:'Payment (direct debit)', v: sumBy(summary,'PAYMENT_L')    * L},
    {name:'Journal voucher',        v: sumBy(summary,'JOURNAL_L')    * L},
    {name:'Samples / promo credit', v: sumBy(summary,'SAMPLING_L')   * L},
  ]);

  return `<div class="minikpis">${kpis}</div>`
    + `<div class="caveat"><b>Consumption, not variance.</b> JIVO holds no budget `
    + `allocation figure for this financial year — JSAP's monthly allocation tables `
    + `stop at Mar-2026, and SAP's own budget carries 4 accounts for FY 26-27 — so `
    + `there is nothing here to compute a budget-versus-actual against. These are `
    + `the amounts approved against each head. They are also read at <b>draft</b> `
    + `stage: JSAP tracks the SAP draft, so a line is committed spend, not yet a `
    + `posted ledger entry.</div>`
    + `<div class="chart"><div class="chart-title">Spend by effective month — the `
    + `month the expense belongs to, not the month it was keyed</div>`
    + monthBars(summary, 'NET_L', '--c1') + `</div>`
    + `<div class="chart"><div class="chart-title">Which budget head is spending it`
    + (span ? ` (${esc(span)})` : '') + `</div>` + hbars(byHead, '--c2') + `</div>`
    + `<div class="chart"><div class="chart-title">How the spend reaches the books</div>`
    + route
    + (cred > 0 ? `<div class="tnote">A/P credit memos of ${money(cred)} are netted `
                + `off the totals above — they credit the expense GL back.</div>` : '')
    + `</div>`
    + `<div class="chart-title" style="margin-top:20px">Budget head × effective month</div>`
    + monthPivot(summary, ['HEAD'], 'NET_L', {head:{HEAD:'Budget head'}})
    + `<div class="chart-title" style="margin-top:20px">Which GL account is getting it</div>`
    + monthPivot(detail, ['ACCT_CODE','ACCT_NAME'], 'NET_L',
        {head:{ACCT_CODE:'GL code', ACCT_NAME:'GL account'}, top:40,
         note:'One row per GL account, all heads combined.'})
    + `<div class="chart-title" style="margin-top:20px">Full drill — head, sub-head `
    + `and GL</div>`
    + monthPivot(detail, ['HEAD','SUB_HEAD','ACCT_CODE','ACCT_NAME'], 'NET_L',
        {head:{HEAD:'Head', SUB_HEAD:'Sub-head', ACCT_CODE:'GL code',
               ACCT_NAME:'GL account'}, top:120});
}

/* ══ factory indirect + casual labour — SAP, by posting month ═════════════ */
function renderFactoryIndirect({summary, detail}){
  if (!summary.length)
    return `<div class="empty">Nothing posted to the indirect expense tree or to `
         + `casual labour in this book this financial year.</div>`;
  const L = 1e5;
  const months = monthsOf(summary);
  const partKeys = new Set(summary.filter(r => r.PART_MONTH === 'Y').map(r => r.MONTH_KEY));
  const closed = months.filter(([k]) => !partKeys.has(k));
  const isCasual = r => r.FAMILY === 'CASUAL LABOUR';

  const indT = summary.filter(r => !isCasual(r)).reduce((a,r) => a + (Number(r.NET_L)||0), 0) * L;
  const casT = summary.filter(isCasual).reduce((a,r) => a + (Number(r.NET_L)||0), 0) * L;
  const closedTot = summary.filter(r => !partKeys.has(r.MONTH_KEY))
                           .reduce((a,r) => a + (Number(r.NET_L)||0), 0) * L;

  const groups = [...new Set(summary.map(r => r.GRP_NAME))];
  const byGrp = groups.map(g => ({
    name: titleCase(g),
    v: summary.filter(r => r.GRP_NAME === g).reduce((a,r) => a + (Number(r.NET_L)||0), 0) * L,
  })).sort((a,b) => Math.abs(b.v) - Math.abs(a.v));

  /* A group whose latest CLOSED month sits far under its own run-rate is almost
     always a posting not yet passed — the month reads as a saving and is not
     one. Offered as a heuristic to go and check, never as a finding. */
  const watch = [];
  if (closed.length >= 3){
    const last = closed[closed.length-1][0];
    const at = (g,k) => summary.filter(r => r.GRP_NAME === g && r.MONTH_KEY === k)
                               .reduce((a,r) => a + (Number(r.NET_L)||0), 0);
    groups.forEach(g => {
      const hist = closed.slice(0,-1).map(([k]) => at(g,k)).sort((a,b) => a-b);
      const med = hist.length ? hist[Math.floor(hist.length/2)] : 0;
      const now = at(g,last);
      if (med > 1 && now < med * 0.4)
        watch.push({name: titleCase(g), now: now*L, med: med*L});
    });
  }

  return `<div class="minikpis">` + [
      mk('Indirect expense', money(indT), '',
         `${closed.length} closed month${closed.length === 1 ? '' : 's'}`
         + (closed.length ? ' · ' + titleCase(closed[0][1]) + ' to '
                            + titleCase(closed[closed.length-1][1]) : '')),
      mk('Casual labour', money(casT), '', 'GL 5100008 — sits under direct expense'),
      mk('Average a closed month', money(closed.length ? closedTot/closed.length : 0), '',
         'indirect and casual labour together'),
      mk('Biggest group', byGrp.length ? money(byGrp[0].v) : '—', '',
         byGrp.length ? byGrp[0].name : ''),
    ].join('') + `</div>`
    + (partKeys.size
        ? `<div class="caveat">The current month is a <b>part month</b> — still being `
        + `posted, so it reads low by construction. Depreciation is not run monthly `
        + `at JIVO, so it does not appear in these figures at all.</div>` : '')
    + (watch.length
        ? `<div class="caveat"><b>Looks under-booked.</b> In the latest closed month `
        + `these groups came in far below their own run-rate, which usually means the `
        + `entry has not been passed yet rather than a saving — `
        + watch.map(w => `${esc(w.name)} ${money(w.now)} against a typical `
                       + `${money(w.med)}`).join('; ') + `.</div>` : '')
    + `<div class="chart"><div class="chart-title">Indirect expense and casual labour `
    + `by month</div>` + monthBars(summary, 'NET_L', '--c3') + `</div>`
    + `<div class="chart"><div class="chart-title">Where it goes, by expense group</div>`
    + hbars(byGrp, '--c4') + `</div>`
    + `<div class="chart"><div class="chart-title">Share of the total</div>`
    + partStack(byGrp) + `</div>`
    + `<div class="chart-title" style="margin-top:20px">Expense group × month</div>`
    + monthPivot(summary, ['FAMILY','GRP_NAME'], 'NET_L',
        {head:{FAMILY:'Family', GRP_NAME:'Expense group'},
         note:'Debit less credit on each account, so a reversal or reclass shows as '
            + 'a negative month.'})
    + `<div class="chart-title" style="margin-top:20px">GL account × month</div>`
    + monthPivot(detail, ['ACCT_CODE','ACCT_NAME','GRP_NAME'], 'NET_L',
        {head:{ACCT_CODE:'GL code', ACCT_NAME:'GL account', GRP_NAME:'Group'},
         top:60});
}

const RENDERERS = {
  'budget-heads':      renderBudgetHeads,
  'factory-indirect':  renderFactoryIndirect,
  'vendor-ageing':   renderPartyAgeing('vendor'),
  'customer-ageing': renderKindAgeing,
  'provisions':      renderProvisions,

  'goods-return': renderFaceted({
    facet:'SCOPE', kpiFacet:'TOTAL', empty:'No goods returns in this book.',
    kpis:(r) => [
      mk('Returned to vendors', money(r.RET_GROSS), '', `${num(r.RET_DOCS)} documents`),
      mk('Share of goods received', (Number(r.RET_PCT_OF_GRPO)||0).toFixed(3) + '%', 'ok',
         `against ${money(r.GRPO_NET)} of item GRPO`),
      mk('Never credited by a supplier',
         money('RET_NOCN_EXT_GROSS' in r ? r.RET_NOCN_EXT_GROSS : r.RET_GROSS_NO_CN),
         Number('RET_NOCN_EXT_GROSS' in r ? r.RET_NOCN_EXT_GROSS : r.RET_GROSS_NO_CN) > 0 ? 'bad' : 'ok',
         `${num('RET_NOCN_EXT_DOCS' in r ? r.RET_NOCN_EXT_DOCS : r.RET_DOCS_NO_CN)} external returns with no A/P credit note`
         + (Number(r.RET_GROSS_NO_CN) > Number(r.RET_NOCN_EXT_GROSS)
            ? ` · ${money(Number(r.RET_GROSS_NO_CN) - Number(r.RET_NOCN_EXT_GROSS))} more is branch, intercompany or stock write-off`
            : '')),
      mk('Still open', num(r.RET_DOCS_OPEN), Number(r.RET_DOCS_OPEN) ? 'warn' : 'ok', 'documents'),
    ],
    blocks:[
      {facet:'MONTH',  kind:'bars', chrono:true, valCol:'RET_GROSS', labelCol:'GRP_LABEL', top:24,
       color:'--c3', title:'Goods returned by month'},
      {facet:'VENDOR', kind:'bars', valCol:'RET_GROSS', labelCol:'GRP_LABEL', top:12,
       color:'--c3', title:'Vendors we return most to'},
      {facet:'CLASS',  kind:'table', title:'External suppliers versus JIVO\'s own branches',
       cols:['GRP_LABEL','RET_DOCS','RET_NET','RET_GST','RET_GROSS','RET_DOCS_NO_CN','RET_GROSS_NO_CN','GRPO_DOCS','GRPO_NET','RET_PCT_OF_GRPO'],
       cell:{RET_GROSS_NO_CN: v => `<td class="num">${money(v)}</td>`,
             RET_PCT_OF_GRPO: v => `<td class="num">${(v === null || v === undefined || isNaN(v))
                                       ? '—' : Number(v).toFixed(3) + '%'}</td>`},
       note:'Share of GRPO is measured against ITEM goods receipts only — service '
          + 'receipts (freight, job work, imprest) can never come back on a goods return.'},
      {facet:'CREDIT_NOTE', kind:'table', title:'Did a credit note follow the return?',
       cols:['GRP_LABEL','RET_DOCS','RET_GROSS'],
       note:'A goods return with no A/P credit note is stock handed back to the vendor '
          + 'that JIVO never recovered on paper.'},
    ],
  }),

  'grpo': renderFaceted({
    facet:'SCOPE', kpiFacet:'TOTAL', empty:'No goods receipts in this book.',
    kpis:(r) => {
      /* The plain totals include JIVO's OWN cards — branch vendors, the sister
         company, and the internal "STOCK GOODS RECEIPTS" adjustment card. In
         Beverages 68% of the unbilled total is that internal card and in Mart 80%
         is intercompany, so the headline quotes the EXTERNAL-only twin and names
         what was taken out. EXT_* is missing from a pre-2026-08-21 data.json, so
         fall back to the total rather than showing a blank. */
      const has = ('EXT_UNBILLED_GROSS' in r) && r.EXT_UNBILLED_GROSS !== null;
      const ubT = Number(r.UNBILLED_GROSS) || 0, ubE = has ? (Number(r.EXT_UNBILLED_GROSS) || 0) : ubT;
      const own = ubT - ubE;
      return [
      mk('Goods received', money(has ? r.EXT_GRPO_GROSS : r.GRPO_GROSS), '',
         has ? `${num(r.EXT_GRPO_DOCS)} GRPOs from outside suppliers · ${money(r.GRPO_GROSS)} counting JIVO's own`
             : `${num(r.GRPO_DOCS)} GRPOs`),
      mk('No vendor bill yet', money(ubE), ubE > 0 ? 'bad' : 'ok',
         has ? `${num(r.EXT_UNBILLED_DOCS)} outside receipts` + (own > 0
                 ? ` · ${money(own)} more sits on JIVO's own branch / group / stock-adjustment cards`
                 : '')
             : `${num(r.UNBILLED_DOCS)} receipts — liability not booked`),
      mk('Unbilled 90 d +', money(has ? r.EXT_UB_90PLUS_GROSS : r.UB_90PLUS_GROSS),
         Number(has ? r.EXT_UB_90PLUS_DOCS : r.UB_90PLUS_DOCS) > 0 ? 'bad' : 'ok',
         `${num(has ? r.EXT_UB_90PLUS_DOCS : r.UB_90PLUS_DOCS)} receipts · oldest ${num(r.OLDEST_UB_DAYS)} days`),
      mk('Bill booked on receipt date', (Number(r.INV_SAMEDAY_PCT)||0).toFixed(0) + '%',
         Number(r.INV_SAMEDAY_PCT) < 80 ? 'warn' : 'ok',
         `average lag ${(Number(r.INV_LAG_AVG_DAYS)||0).toFixed(1)} days`),
      ];
    },
    blocks:[
      {facet:'VENDOR_UNBILLED', kind:'bars', valCol:'UNBILLED_GROSS', labelCol:'GRP_LABEL',
       top:12, color:'--c3', title:'Vendors whose goods we hold but whose bill has not arrived'},
      {facet:'MONTH',  kind:'bars', chrono:true, valCol:'GRPO_GROSS', labelCol:'GRP_LABEL', top:24,
       color:'--c1', title:'Goods received by month'},
      {facet:'VENDOR', kind:'bars', valCol:'GRPO_GROSS', labelCol:'GRP_LABEL', top:12,
       color:'--c1', title:'Biggest suppliers by goods received'},
      {facet:'BRANCH', kind:'table', title:'By GST branch',
       cols:['GRP_LABEL','GRPO_DOCS','GRPO_GROSS','UNBILLED_DOCS','UNBILLED_GROSS','INV_SAMEDAY_PCT','INV_LAG_AVG_DAYS']},
      {facet:'CLASS',  kind:'table', title:'External suppliers versus JIVO\'s own branches',
       cols:['GRP_LABEL','GRPO_DOCS','GRPO_GROSS','UNBILLED_DOCS','UNBILLED_GROSS','UB_90PLUS_GROSS','CLOSED_NOBILL_GROSS'],
       note:'The KPIs above quote the EXTERNAL row only. INTERCOMPANY, BRANCH and '
          + 'INTERNAL_ADJ are goods moved inside JIVO — INTERNAL_ADJ is the '
          + '"STOCK GOODS RECEIPTS" card, a stock adjustment that will never draw a '
          + 'vendor bill. A GRPO closed with no bill against it (CLOSED_NOBILL) was '
          + 'settled some other way — worth a look, since the goods were received '
          + 'on a purchase order.'},
    ],
  }),

  'transporter': renderFaceted({
    facet:'SCOPE', kpiFacet:'TOTAL', empty:'No transporter data in this book.',
    kpis:(r) => [
      mk('Dispatched', money(scale(r.DISP_VAL_L,'DISP_VAL_L')), '',
         `${num(r.DISP_DOCS)} invoices`),
      mk('Transporter named', (Number(r.NAMED_PCT)||0).toFixed(0) + '%',
         Number(r.NAMED_PCT) < 80 ? 'bad' : 'ok', 'of dispatches'),
      mk('LR number present', (Number(r.LR_PCT)||0).toFixed(0) + '%',
         Number(r.LR_PCT) < 80 ? 'bad' : 'ok', 'blanks are an e-way-bill gap'),
      mk('Freight paid', money(scale(r.FRT_SPEND_L,'FRT_SPEND_L')), '',
         `${(Number(r.FRT_PCT_OF_DISP)||0).toFixed(2)}% of dispatch value`),
    ],
    blocks:[
      {facet:'TRANSPORTER', kind:'bars', valCol:'DISP_VAL_L', labelCol:'GRP_LABEL', top:14,
       color:'--c5', title:'Who moves the most, by dispatch value'},
      {facet:'FREIGHT_VENDOR', kind:'bars', valCol:'FRT_SPEND_L', labelCol:'GRP_LABEL', top:12,
       color:'--c3', title:'Who we actually pay — freight vendors in the A/P ledger'},
      {facet:'MONTH', kind:'bars', chrono:true, valCol:'DISP_VAL_L', labelCol:'GRP_LABEL', top:24,
       color:'--c5', title:'Dispatch value by month'},
      {facet:'FIELD', kind:'table', title:'Where the data lives, and how much of it is filled in',
       cols:['GRP_LABEL','FILLED','FILL_PCT','VARIANTS','NOTE'],
       note:'The standard SAP shipping table is empty at JIVO, so every figure here '
          + 'comes from user-defined fields typed on the invoice. A low fill rate '
          + 'means the field is not being keyed, not that the shipment did not happen.'},
      {facet:'NAMECLASS', kind:'table', title:'Is the name usable?',
       cols:['GRP_LABEL','DISP_DOCS','DISP_VAL_L','NOTE']},
      {facet:'PARTY', kind:'table', title:'External customers versus JIVO\'s own branches',
       cols:['GRP_LABEL','DISP_DOCS','DISP_VAL_L','LR_PCT','VEH_PCT'],
       note:'The "Dispatched" KPI above is ALL dispatches — the EXTERNAL row here is '
          + 'the part that is real trade. BRANCH and INTERCOMPANY are goods moved '
          + 'inside JIVO between its own GST registrations and group companies; they '
          + 'still ride on a truck, so they are counted as dispatches, but they are '
          + 'not sales. "Freight paid" is A/P to carriers only — freight accrued '
          + 'straight to the ledger by journal entry, with no vendor bill, is not in it.'},
    ],
  }),

  'bank-reco': function({summary, detail}){
    if (!summary.length) return '<div class="empty">No bank accounts found in this book.</div>';
    const T = summary.find(r => r.ROW_TYPE === 'TOTAL') || {};
    const accts = summary.filter(r => r.ROW_TYPE === 'ACCOUNT');
    const cols = detectBuckets(T) || [];
    const behind = Number(T.DAYS_SINCE_RECON_N) || 0;

    /* The coverage number is the finding, not the ageing. Count it rather than
       parsing the TOTAL row's status string. */
    const neverN = accts.filter(r => /NEVER/.test(r.RECO_STATUS || '')
                                  && !/DORMANT/.test(r.RECO_STATUS || '')).length;
    const everN  = accts.filter(r => Number(r.RECONS_DONE_N) > 0).length;
    const caveat = `<div class="caveat"><b>This is not a bank reconciliation.</b>
      It is what SAP already holds. No bank statement file is loaded, so nothing here
      is matched against what the bank actually says, and SAP stores no bank-supplied
      closing balance either. What it can tell you is coverage — and coverage is the
      finding: <b>${num(everN)} of ${num(accts.length)}</b> accounts in this book have
      ever been reconciled, <b>${num(neverN)}</b> never once. The last one was
      <b>${esc(T.LAST_RECON_DATE || '—')}</b>, ${behind} days ago, leaving
      <b>${num(T.UNREC_LINES_N)}</b> of ${num(T.GL_LINES_N)} ledger lines unagreed.</div>`;

    /* The 90 d + figure blends an exception list with a coverage failure, and the
       coverage failure is the overwhelming majority of it (Oil 91%, Mart 96%,
       Bev 100% as at 2026-08-21). Split it, or the reader chases the wrong thing.
       And there are ZERO cheques in any JIVO book — RCT1/VPM1/OCHO are all empty
       and no uncancelled receipt or payment carries a CheckSum — so an
       'uncleared cheque' caption here would be describing something that does
       not exist. These are unagreed bank transfers. */
    const onNever = accts.filter(r => /NEVER/.test(r.RECO_STATUS || ''))
                         .reduce((a,r) => a + (Number(r.UNREC_90PLUS_L) || 0), 0);
    const tot90   = Number(T.UNREC_90PLUS_L) || 0;
    const kpis = [
      mk('Last reconciled', esc(T.LAST_RECON_DATE || '—'), behind > 30 ? 'bad' : 'ok',
         `${behind} days ago · ${num(T.RECONS_DONE_N)} reconciliations on record`),
      mk('Never reconciled', num(T.UNREC_LINES_N), Number(T.UNREC_LINES_N) ? 'warn' : 'ok',
         `ledger lines of ${num(T.GL_LINES_N)}`),
      mk('Unreconciled 90 d +', money(scale(T.UNREC_90PLUS_L,'UNREC_90PLUS_L')),
         Number(T.UNREC_90PLUS_N) ? 'bad' : 'ok',
         `${num(T.UNREC_90PLUS_N)} items · oldest ${esc(T.OLDEST_UNREC_DATE || '—')}`
         + (tot90 ? ` · ${pct(onNever, tot90)} on accounts never reconciled` : '')),
      mk('Uncleared payments 90 d +', money(scale(T.UNREC_90PLUS_PAYMENTS_L,'UNREC_90PLUS_PAYMENTS_L')),
         Number(T.UNREC_90PLUS_PAYMENTS_L) ? 'bad' : 'ok',
         'money out the bank has not agreed — no cheques exist in this book'),
    ].join('');

    const tc = ['ACCT_NAME','RECO_STATUS','RECONS_DONE_N','LAST_RECON_DATE','DAYS_SINCE_RECON_N',
                'GL_BAL_L','RECONCILED_BAL_L','RECON_TIEOUT_DIFF_L','UNREC_LINES_N',
                'UNREC_RECEIPTS_L','UNREC_PAYMENTS_L','UNREC_90PLUS_L','OLDEST_UNREC_DATE']
                .filter(c => accts.length && c in accts[0]);

    return caveat + `<div class="minikpis">${kpis}</div>`
      + (cols.length ? `<div class="chart"><div class="chart-title">How old the unreconciled items are</div>`
                       + bucketStack([T], cols) + `</div>` : '')
      + `<div class="chart"><div class="chart-title">Unreconciled value by account</div>`
      + hbars(accts.filter(r => Number(r.UNREC_90PLUS_L) || Number(r.UNREC_LINES_N))
          .sort((a,b) => (Number(b.UNREC_RECEIPTS_L)+Number(b.UNREC_PAYMENTS_L)||0)
                       - (Number(a.UNREC_RECEIPTS_L)+Number(a.UNREC_PAYMENTS_L)||0))
          .slice(0, 12)
          .map(r => ({ name: r.ACCT_NAME,
                       v: ((Number(r.UNREC_RECEIPTS_L)||0) + (Number(r.UNREC_PAYMENTS_L)||0)) * 1e5 })),
        '--c3') + `</div>`
      + table(accts, {tall:true, cols:tc, head:{ACCT_NAME:'account', RECO_STATUS:'status',
          RECONS_DONE_N:'recons', LAST_RECON_DATE:'last recon', DAYS_SINCE_RECON_N:'days since',
          GL_BAL_L:'g/l balance', RECONCILED_BAL_L:'agreed with bank',
          RECON_TIEOUT_DIFF_L:'tie-out diff', UNREC_LINES_N:'unrec lines',
          UNREC_RECEIPTS_L:'unrec receipts', UNREC_PAYMENTS_L:'unrec payments',
          UNREC_90PLUS_L:'unrec 90 d +', OLDEST_UNREC_DATE:'oldest unrec'},
          /* RECO_STATUS is one of DORMANT_NEVER_RECONCILED / NEVER_RECONCILED /
             RECONCILED_CURRENT / RECONCILED_LAGGING / RECONCILED_STALE. Matching
             on 'NEVER'/'CURRENT' exactly (as this did) never fired, so all 132
             accounts across the three books rendered amber — including the 61
             that have never been reconciled. Dormant stays neutral: an account
             with no ledger lines has nothing to reconcile and is not a failure. */
          cell:{ RECO_STATUS:(v) => `<td><span class="pill ${
            /DORMANT/.test(v||'')  ? ''
            : /NEVER/.test(v||'')   ? 'bad'
            : /CURRENT/.test(v||'') ? 'ok' : 'warn'}">${esc(v||'—')}</span></td>` }})
      + (detail && detail.length
          ? `<div class="chart-title" style="margin-top:18px">Every reconciliation SAP has recorded`
            + ` — cadence, and how late it was keyed</div>`
            + table(detail, {tall:true, head:{ACCT_NAME:'account', RECON_NO:'recon #',
                STMT_DATE:'statement date', PERFORMED_DATE:'keyed on', LAG_DAYS_N:'lag (days)',
                LINES_CLEARED_N:'lines cleared', CLEARED_RECEIPTS_L:'receipts',
                CLEARED_PAYMENTS_L:'payments', CLEARED_NET_L:'net', BANK_SIDE_L:'bank side',
                TIEOUT_DIFF_L:'tie-out', OLDEST_ITEM_DATE:'oldest item',
                MAX_ITEM_AGE_AT_STMT_N:'reached back (days)'}})
          : '');
  },

  'open-item-list': function({summary}){
    if (!summary.length) return '<div class="empty">No open items in this book.</div>';
    const r0 = summary[0];
    const shown = Number(r0.CO_ITEMS_SHOWN) || summary.length;
    const all   = Number(r0.CO_ITEMS_ALL)   || summary.length;
    const openAll = Number(r0.CO_OPEN_ALL) || 0;
    const ocrd    = Number(r0.CO_OCRD_NET) || 0;

    const caveat = `<div class="caveat"><b>Most of this list is not really open.</b>
      SAP carries <b>${num(all)}</b> documents still marked open, worth
      <b>${money(openAll)}</b>. The parties' actual ledger balances net to
      <b>${money(ocrd)}</b>. The difference is documents that were settled by journal
      entry or by an on-account payment that was never matched back to them, so SAP
      never closed the document. Read this list as <i>documents SAP has not closed</i>,
      not as money outstanding.</div>`;

    const by = facets(summary, 'DOCTYPE');
    const LBL = {AR_INV:'Customer invoices', AR_CN:'Credit notes to customers',
                 AR_RCT:'Receipts not applied', AP_INV:'Vendor bills',
                 AP_CN:'Credit notes from vendors', AP_PMT:'Payments not applied'};
    /* Bars carry DT_OPEN_ALL — the UNCAPPED per-doctype total that rides on every
       row of that doctype — not a sum of the rows on screen. Summing the shown
       rows would make the chart total the capped figure while the KPI above it
       shows the uncapped one, and the gap would look like an error. */
    const comp = [...by.entries()].map(([k, rows], i) => ({
      name: LBL[k] || k,
      v: Math.abs(Number(rows[0].DT_OPEN_ALL)
                  || rows.reduce((a, r) => a + Math.abs(Number(r.OPEN_AMT) || 0), 0)),
      color: cvar(CAT[i % CAT.length]),
    })).sort((a, b) => b.v - a.v);

    const kpis = [
      mk('Documents SAP has not closed', num(all), '', `showing the largest ${num(shown)}`),
      mk('Their face value', money(openAll), 'warn', 'not what is owed'),
      mk('What the ledgers actually net to', money(ocrd), '', 'across all parties'),
      mk('Migrated at go-live', money(r0.CO_MIGRATED_OPEN), 'warn',
         'opening balances from 30 Sep 2024'),
    ].join('');

    const tc = ['DOCTYPE','DOC_NUM','EXT_REF','CARD_NAME','ACCT_KIND','BPL_NAME','DOC_DATE',
                'DUE_DATE','DAYS_OVERDUE','AGE_BUCKET','DOC_TOTAL','APPLIED','OPEN_AMT',
                'CURRENCY','RECON_STATE','IS_MIGRATED'].filter(c => c in r0);

    return caveat + `<div class="minikpis">${kpis}</div>`
      + `<div class="chart"><div class="chart-title">What kind of document is sitting open</div>`
      + hbars(comp) + `</div>`
      + table(summary, {tall:true, cols:tc, head:{DOCTYPE:'type', DOC_NUM:'doc no',
          EXT_REF:'their ref', CARD_NAME:'party', ACCT_KIND:'kind', BPL_NAME:'branch',
          DOC_DATE:'dated', DUE_DATE:'due', DAYS_OVERDUE:'days over', AGE_BUCKET:'age',
          DOC_TOTAL:'document', APPLIED:'applied', OPEN_AMT:'still open',
          RECON_STATE:'recon', IS_MIGRATED:'migrated'},
          /* APPLIED is rupees, but isMoneyCol() does not match the bare word, so
             without this it prints as a plain integer next to a ₹ figure and
             reads as a document count. Rupees in, rupees out — no scaling. */
          cell:{ APPLIED:(v) => `<td class="num">${money(Number(v) || 0)}</td>`,
                 IS_MIGRATED:(v) => `<td>${Number(v)
                   ? '<span class="pill dead">go-live</span>' : ''}</td>`,
                 DOCTYPE:(v) => `<td><span class="pill ${
                   String(v).startsWith('AR') ? 'info' : 'warn'}">${esc(v)}</span></td>` },
          note:`Showing the ${num(shown)} largest of ${num(all)} open documents, worst first. `
             + `Sort any column by clicking its heading.`});
  },

  'return-note': renderFaceted({
    facet:'SCOPE', kpiFacet:'TOTAL', empty:'No customer returns in this book.',
    kpis:(r) => [
      mk('Returned by customers', money(r.RET_GROSS), '', `${num(r.RET_DOCS)} return notes`),
      mk('Stock value handed back', money(r.RET_STOCK_COST), '',
         (Number(r.RET_COST_PCT_OF_SALES)||0).toFixed(2) + '% of sales'),
      mk('Returned, never credited', money(r.RET_STOCK_COST_NO_CN),
         Number(r.RET_DOCS_NO_CN) > 0 ? 'bad' : 'ok',
         `${num(r.RET_DOCS_NO_CN)} returns with no credit note`),
      mk('Booked at zero value', num(r.RET_DOCS_ZERO_VALUE),
         Number(r.RET_DOCS_ZERO_VALUE) > 0 ? 'warn' : 'ok',
         `of ${num(r.RET_DOCS)} — stock moved, no value posted`),
    ],
    blocks:[
      {facet:'MONTH',    kind:'bars', chrono:true, valCol:'RET_STOCK_COST', labelCol:'GRP_LABEL', top:24,
       color:'--c6', title:'Stock returned by month, at cost'},
      {facet:'CUSTOMER', kind:'bars', valCol:'RET_STOCK_COST', labelCol:'GRP_LABEL', top:12,
       color:'--c6', title:'Customers who return most'},
      {facet:'CLASS',    kind:'table', title:'External customers versus JIVO\'s own branches',
       cols:['GRP_LABEL','RET_DOCS','RET_QTY_PCS','RET_NET','RET_GROSS','RET_STOCK_COST','RET_DOCS_NO_CN','SALES_NET','RET_COST_PCT_OF_SALES'],
       head:{RET_COST_PCT_OF_SALES:'RET_COST_PCT_OF_SALES (%)'},
       cell:{RET_COST_PCT_OF_SALES: v => `<td class="num">${(v === null || v === undefined || isNaN(v)) ? '—' : Number(v).toFixed(2) + '%'}</td>`}},
      {facet:'CREDIT_NOTE', kind:'table', title:'Did a credit note follow the return?',
       cols:['GRP_LABEL','RET_DOCS','RET_QTY_PCS','RET_STOCK_COST'],
       note:'A return note with no credit note means the goods came back into stock '
          + 'but the customer was never credited for them. Quantities are in PIECES '
          + '(single bottles), not cartons.'},
    ],
  }),

  'bank-accounts': function({summary}){
    if (!summary.length) return '<div class="empty">No bank or cash accounts found.</div>';
    const r0  = summary[0];
    const L   = v => (Number(v) || 0) * 1e5;
    const bal = r => L(r.BALANCE_L);
    /* Company totals ride on every row — read them off one, never by summing
       the rows (that would double the figure against the per-account list). */
    const liquid = L(r0.TOT_BANK_CURRENT_L) + L(r0.TOT_CASH_IN_HAND_L) + L(r0.TOT_WALLET_L);
    const fd     = L(r0.TOT_FIXED_DEPOSIT_L);
    const debt   = Math.abs(L(r0.TOT_BORROWINGS_L));
    const cc     = Math.abs(L(r0.TOT_CC_OD_NET_L));
    const dormant = summary.filter(r => r.DORMANT_90D_FLAG === 'Y' && bal(r) !== 0);

    const caveat = `<div class="caveat">JIVO runs its working capital on credit, not on
      a bank balance. Only <b>${money(liquid)}</b> is sitting in current accounts and
      cash; <b>${money(cc)}</b> is drawn on cash credit and overdraft, against
      <b>${money(fd)}</b> held in fixed deposits. A negative balance on a CC, OD or
      loan account below is <i>borrowing</i>, not an error.</div>`;

    const kpis = [
      mk('In current accounts and hand', money(liquid), liquid < 0 ? 'bad' : '',
         'immediately available'),
      mk('Fixed deposits', money(fd), 'ok', 'often margin against the credit line'),
      mk('Total borrowings', money(debt), 'warn', 'CC / OD, term and vehicle loans'),
      mk('Dormant 90 d +', String(dormant.length), dormant.length ? 'warn' : 'ok',
         'carrying a balance, no movement'),
    ].join('');

    const nameOf = r => r.GL_ACCT_LABEL_MASKED || r.BANK_NAME || r.GL_ACCT_CODE;
    /* Assets and liabilities are never charted on one axis — split in two. */
    const bars = (cats, colorVar) => hbars(summary
      .filter(r => cats.includes(r.CATEGORY) && bal(r) !== 0)
      .sort((a,b) => Math.abs(bal(b)) - Math.abs(bal(a))).slice(0, 14)
      .map(r => ({ name: nameOf(r), v: Math.abs(bal(r)), label: money(bal(r)) })), colorVar);

    const tc = ['CATEGORY','BANK_NAME','BRANCH','ACCT_NO_MASKED','GL_ACCT_CODE','BALANCE_L',
                'FUNDS_AVAILABLE_L','RECEIPTS_IN_12M_L','PAYMENTS_OUT_12M_L','NET_12M_L',
                'LAST_MOVE_DATE','DAYS_SINCE_LAST_MOVE','IS_HOUSE_BANK','DORMANT_90D_FLAG']
                .filter(c => c in r0);

    return caveat + `<div class="minikpis">${kpis}</div>`
      + `<div class="chart"><div class="chart-title">What JIVO holds — current accounts, cash and deposits</div>`
      + bars(['CURRENT_ACCOUNT','CASH_IN_HAND','PAYMENT_WALLET','FIXED_DEPOSIT'], '--c1') + `</div>`
      + `<div class="chart"><div class="chart-title">What JIVO owes the banks</div>`
      + bars(['CASH_CREDIT_OD','TERM_LOAN','VEHICLE_LOAN','CREDIT_CARD'], '--c3') + `</div>`
      + table(summary, {tall:true, cols:tc, head:{CATEGORY:'category', BANK_NAME:'bank',
          BRANCH:'branch', ACCT_NO_MASKED:'a/c no', GL_ACCT_CODE:'g/l', BALANCE_L:'balance',
          FUNDS_AVAILABLE_L:'available', RECEIPTS_IN_12M_L:'in 12 m',
          PAYMENTS_OUT_12M_L:'out 12 m', NET_12M_L:'net 12 m', LAST_MOVE_DATE:'last movement',
          DAYS_SINCE_LAST_MOVE:'days since', IS_HOUSE_BANK:'house bank',
          DORMANT_90D_FLAG:'dormant'},
          cell:{ DORMANT_90D_FLAG:(v) => `<td>${v === 'Y'
                   ? '<span class="pill warn">dormant</span>' : ''}</td>`,
                 IS_HOUSE_BANK:(v) => `<td>${v === 'Y'
                   ? '<span class="pill ok">house</span>' : ''}</td>` },
          note:'Positive is a debit balance (money JIVO holds); negative is a credit '
             + 'balance (money JIVO owes). Account numbers are masked to the last 4 digits.'});
  },

  'cash-sale': renderFaceted({
    facet:'SECTION', kpiFacet:'9_TOTAL', empty:'No cash sales found in this book.',
    kpis:(r) => [
      mk('Cash sales', money(r.TURNOVER_NET_INR), '', `${num(r.INV_CNT)} invoices, net of GST`),
      mk('Gross of GST', money(r.INV_GROSS_INR), '', ''),
      mk('Returns against them', money(r.CN_GROSS_INR), Number(r.CN_GROSS_INR) ? 'warn' : 'ok',
         `${num(r.CN_CNT)} credit notes`),
      mk('Still unpaid', money(r.OPEN_INR), Number(r.OPEN_INR) > 0 ? 'bad' : 'ok',
         'a cash sale should not carry a balance'),
    ],
    blocks:[
      {facet:'1_SCOPE', kind:'table', title:'What counts as a cash sale in this book',
       cols:['ROW_KEY','ROW_LABEL','ROW_NOTE','INV_CNT','TURNOVER_NET_INR','OPEN_INR'],
       note:'JIVO books cash sales against dedicated customer accounts rather than a '
          + 'payment term, so these CardCodes are the definition.'},
      {facet:'2_MONTH',   kind:'bars', chrono:true, valCol:'TURNOVER_NET_INR', top:24, color:'--c5',
       title:'Cash sales by month'},
      {facet:'5_CUSTOMER',kind:'bars', valCol:'TURNOVER_NET_INR', top:10, color:'--c5',
       title:'By cash account'},
      {facet:'3_BRANCH',  kind:'bars', valCol:'TURNOVER_NET_INR', top:10, color:'--c2',
       title:'By branch'},
      {facet:'4_WAREHOUSE',kind:'bars',valCol:'TURNOVER_NET_INR', top:12, color:'--c2',
       title:'By warehouse'},
      {facet:'7_GL_CASH', kind:'table', title:'Cross-check against the cash ledger',
       cols:['ROW_LABEL','ROW_NOTE','INV_CNT','TURNOVER_NET_INR'],
       note:'An independent read of the cash G/L accounts. It will not match the '
          + 'invoice figure exactly — the ledger also carries non-sale cash movements.'},
    ],
  }),
};

function renderFooter(){
  const rows = SECTIONS.map(s => `<div><b>${esc(s.title)}</b> — <code>${esc(s.src)}</code></div>`).join('');
  document.getElementById('foot').innerHTML =
    `<h3>Where these numbers come from</h3><div class="lineage">${rows}</div>`
  + `<p>Every figure is read live from the SAP Business One HANA database — the books themselves, `
  + `not a downstream app. The pipeline is <b>read-only</b>: it can only issue <code>SELECT</code>, `
  + `runs inside a HANA read-only transaction, and never commits.</p>`
  + `<p>Ageing is <b>credit-adjusted</b>. A raw open-invoice ageing overstates JIVO's position badly — `
  + `money is banked against a party but never knocked off the individual invoice, so the invoice still `
  + `reads OPEN. Those unapplied receipts and open credit notes are netted off oldest-first before `
  + `bucketing. JIVO's own branch and intercompany accounts are flagged, not silently dropped.</p>`
  + `<p style="margin-top:12px;color:var(--soft)">Built ${esc(DATA.generated_at)} · `
  + `<code>accounts-dashboard/pipeline/build_data.py</code></p>`;
}

function renderAll(){
  renderSwitch(); renderStamp(); renderHero(); renderSections(); renderFooter();
}

/* ══ hero strip ═══════════════════════════════════════════════════════════
   Pulls the headline of each section. Every tile is optional: a section that
   has not been built (or failed for this company) simply does not appear,
   rather than showing a confident zero.                                      */
function sumOf(sectionId, col, pred){
  const rows = activeRows(sectionId, 'summary').filter(pred || (() => true));
  if (!rows.length || !(col in rows[0])) return null;
  return rows.reduce((a, r) => a + scale(Number(r[col]) || 0, col), 0);
}
/* One hero card. `corr` carries the figure SAP reports, struck through, beside
   the one that is true — the correction is information, not decoration, so it
   stays in the card's subtitle. A section that has not been built, or failed
   for this company, gets no card at all — never a confident zero, never a dash. */
function kpi(lab, val, sub, corr, cls){
  if (val === null || val === undefined || val === '—') return '';
  const foot = corr ? `<s>${corr}</s> ${esc(sub || 'as SAP reports it')}` : (sub || '');
  return `<div class="kpi ${cls || ''}"><div class="lab">${esc(lab)}</div>`
       + `<div class="val">${val}</div><div class="sub">${foot}</div></div>`;
}
function renderHero(){
  const isTrade = r => r.KIND === 'TRADE';
  const vTrade  = r => r.ACCT_KIND === 'TRADE';

  const owedToUs   = sumOf('customer-ageing', 'EFF_OPEN_INR', isTrade);
  const unmatched  = sumOf('customer-ageing', 'UNAPPLIED_CREDIT_INR', isTrade);
  const weOwe      = sumOf('vendor-ageing', 'ADJ_OPEN', vTrade);
  const weOweLate  = sumOf('vendor-ageing', 'ADJ_OVERDUE_60PLUS', vTrade);
  const provisions = sumOf('provisions', 'OUTSTANDING_CR_L');
  /* Faceted sections stack TOTAL / CLASS / MONTH / VENDOR rows in one result, so
     they must be read from the TOTAL row — summing every row multiply-counts. */
  const grpoOpen = sumOf('grpo', 'UNBILLED_GROSS', r => r.SCOPE === 'TOTAL');
  /* Net bank position, not "cash". JIVO holds almost nothing in current accounts
     and funds itself on cash credit, so a "cash and bank" headline would read as
     liquidity the business does not have. Deposits less borrowings is the truth. */
  const bankRows = activeRows('bank-accounts', 'summary');
  const bankNet = bankRows.length && 'TOT_BORROWINGS_L' in bankRows[0]
    ? bankRows.filter((r, i, a) => a.findIndex(x => x.COMPANY_SCHEMA === r.COMPANY_SCHEMA) === i)
        .reduce((a, r) => a + ((Number(r.TOT_BANK_CURRENT_L) || 0)
                             + (Number(r.TOT_CASH_IN_HAND_L) || 0)
                             + (Number(r.TOT_WALLET_L) || 0)
                             + (Number(r.TOT_FIXED_DEPOSIT_L) || 0)
                             - Math.abs(Number(r.TOT_BORROWINGS_L) || 0)) * 1e5, 0)
    : null;

  let lateAR = null;
  const ar = activeRows('customer-ageing', 'summary').filter(isTrade);
  if (ar.length){
    const cols = detectBuckets(ar[0]);
    if (cols) lateAR = ar.reduce((a, r) =>
      a + cols.slice(3).reduce((x, c) => x + scale(Number(r[c]) || 0, c), 0), 0);
  }

  /* the raw figures SAP would have reported, for the strike-through */
  const rawAR = sumOf('customer-ageing', 'RAW_OPEN_INR', isTrade);
  const rawAP = sumOf('vendor-ageing', 'RAW_OPEN', vTrade);

  document.getElementById('heroKpis').innerHTML = [
    kpi('Customers owe JIVO', money(owedToUs),
        'as SAP reports it', rawAR && rawAR > owedToUs ? money(rawAR) : null),
    kpi('JIVO owes vendors', money(weOwe),
        'as SAP reports it', rawAP && rawAP > weOwe ? money(rawAP) : null),
    /* Receivable and payable overdue are never added together — one is an asset
       and the other a liability, and their sum means nothing. Separate cards. */
    kpi('Overdue to collect', money(lateAR),
        '61 days or more, from customers', null, 'is-bad'),
    kpi('Overdue to pay', money(weOweLate),
        '61 days or more, to vendors', null, 'is-bad'),
    kpi('Cash banked, never matched', money(unmatched),
        'customer money sitting against no invoice', null, 'is-bad'),
    kpi('Provisions standing', money(provisions), 'still provided for'),
    kpi('GRPO with no bill', money(grpoOpen), 'goods in, invoice not booked'),
    kpi('Net bank position', money(bankNet),
        'deposits and cash, less all borrowings', null, bankNet < 0 ? 'is-bad' : ''),
  ].filter(Boolean).join('');
}

/* ══ boot ═════════════════════════════════════════════════════════════════ */
/* ── self-refresh ─────────────────────────────────────────────────────────
   The board rebuilds itself on the server, so an open tab has to go and look —
   otherwise "live" is invisible to the one person actually watching it.

   Two timers, deliberately different: a cheap one that just re-ages the
   "updated N min ago" label, and a real fetch. The fetch only re-renders when
   generated_at actually moved, because a re-render throws away scroll position,
   the company the reader picked, and any column they sorted. Scroll and company
   are restored; re-sorting is the one thing they would have to redo, which is
   why we do not re-render for nothing. */
const POLL_MS = 120000;

function poll(){
  fetch('data.json?t=' + Date.now(), {cache:'no-store'})
    .then(r => r.ok ? r.json() : null)
    .then(d => {
      if (!d || !d.generated_at) return;
      if (d.generated_at === DATA.generated_at){ renderStamp(); return; }
      const y = window.scrollY;
      DATA = d;
      renderAll();                       // renderAll re-reads COMPANY, so the
      window.scrollTo(0, y);             // reader's book selection survives
    })
    .catch(() => {});                    // a dropped poll is not worth a banner
}

fetch('data.json', {cache:'no-store'})
  .then(r => { if (!r.ok) throw new Error('data.json ' + r.status); return r.json(); })
  .then(d => {
    DATA = d; renderNav(); renderAll();
    setInterval(renderStamp, 30000);
    setInterval(poll, POLL_MS);
    /* Coming back to a tab left open overnight should not show yesterday. */
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) poll();
    });
  })
  .catch(e => {
    document.getElementById('boot').innerHTML =
      `<b>Could not load the data.</b><br>${esc(e.message)}<br>`
    + `<span style="color:var(--soft)">Run <code>python3 pipeline/build_data.py</code> to build it.</span>`;
  });
</script>
<script>
/* Theme toggle. The attribute is already set pre-paint; this only flips it
   and remembers the choice. The button names the theme you'd switch TO. */
(function(){
  var root = document.documentElement, btn = document.getElementById('themeToggle');
  if (!btn) return;
  function paint(){
    var dark = root.getAttribute('data-theme') !== 'light';
    btn.querySelector('.ic').textContent = dark ? '\u2600' : '\u263D';
    btn.querySelector('.tl').textContent = dark ? 'Light' : 'Dark';
    btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    btn.title = btn.getAttribute('aria-label');
  }
  btn.addEventListener('click', function(){
    var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('jivo-theme', next); } catch (e) {}
    paint();
  });
  paint();
})();
</script>
<!-- jivo-mark:v1 -->
<div id="jivo-mark" aria-hidden="true">
<div style="text-align:right"><div>powered by daman</div>
<div style="opacity:.6;font-size:9.5px;margin-top:1px">damanpreet? · 21 Aug 2026</div>
</div><img src="data:image/png;base64," alt="" width="30" height="30" style="display:block;border-radius:7px;flex:0 0 auto"></div>
