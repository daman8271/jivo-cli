#!/usr/bin/env bash
# JIVO EXIM CLI — auto-authenticated wrapper around the Printing Press binary.
# ============================================================================
#  HARD RULE: READ-ONLY. This wrapper + binary only FETCH from EXIM.
#  NEVER write/create/update/delete/sync. Production JIVO + SAP data.
# ============================================================================
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Paths that MUTATE even via GET (blocked here as defense-in-depth):
BLOCK='/sap_sync/ /daily-price/fetch/ /jivo-rate/fetch/ /account/logout/ /stock-status/opening-stock/'
guard(){ for b in $BLOCK; do case "$1" in *"$b"*) echo "REFUSED: '$1' mutates data (read-only rule). See HARD-RULE.md" >&2; exit 2;; esac; done; }
# Pick the interpreter that runs eximapi.py (token minting). python3 is the name
# on macOS/Linux; on Windows it is usually `python` — but BOTH can be Microsoft
# Store stubs that sit on PATH and exit 9009 without running, so presence proves
# nothing and every candidate is executed to prove it works. `py -3`, the Windows
# launcher, is often the only working name left on such a machine.
PY=()
for _c in python3 python; do
  if command -v "$_c" >/dev/null 2>&1 && "$_c" -c pass >/dev/null 2>&1; then PY=("$_c"); break; fi
done
if [ ${#PY[@]} -eq 0 ] && command -v py >/dev/null 2>&1 && py -3 -c pass >/dev/null 2>&1; then PY=(py -3); fi
if [ ${#PY[@]} -eq 0 ]; then
  echo "exim: no working Python found (tried python3, python, py -3)." >&2
  echo "      On Windows python/python3 are often Microsoft Store stubs;" >&2
  echo "      install Python 3 or put the real one ahead of them on PATH." >&2
  exit 127
fi

case "${1:-}" in
  grpos|open-grpos) guard /sap_sync/open-grpos/ ;;
  raw) shift; guard "${1:-}"; exec "${PY[@]}" "$ROOT/scripts/eximapi.py" "$@" ;;
esac
# Pick the binary for THIS machine. On Windows (git-bash / MSYS) the build is
# exim-pp-cli.exe; execing the extensionless macOS build there fails with a
# confusing "cannot execute binary file". Operators must keep coming through
# this wrapper rather than calling the binary directly — the BLOCK guard above
# is the read-only defence, and it only exists here.
BIN="$ROOT/cli/exim-pp-cli/exim-pp-cli"
[ -x "$BIN" ] || BIN="$BIN.exe"
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*|Windows_NT) BIN="$ROOT/cli/exim-pp-cli/exim-pp-cli.exe" ;;
esac
if [ ! -x "$BIN" ]; then
  echo "exim: no binary for this machine at $BIN" >&2
  echo "      expected exim-pp-cli (macOS) or exim-pp-cli.exe (Windows)." >&2
  exit 127
fi

# Assign first, THEN export. `export VAR="$(cmd)"` masks a non-zero exit from
# cmd behind export's own status, so a failed token mint sailed straight past
# `set -e` and resurfaced later as the binary reporting "Auth: not configured".
EXIM_TOKEN="$("${PY[@]}" "$ROOT/scripts/eximapi.py" --token)"
export EXIM_TOKEN
if [ -z "$EXIM_TOKEN" ]; then
  echo "exim: token mint returned empty — check EXIM_EMAIL / EXIM_PASSWORD in .env" >&2
  exit 1
fi
exec "$BIN" "$@"
